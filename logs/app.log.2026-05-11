dText": "00:03", "start": 1778254063, "totalSleepMinutes": 33}, "stages": {"unspecified": 0, "deep": 0, "core": 33, "rem": 0, "awake": 3}, "timeline": [{"stage": "core", "vitals": {"avgRespiratoryRate": 15.5, "minHeartRate": 54, "maxHeartRate": 59, "avgHeartRate": 55.75}, "start": 1778254063, "widthPercent": 42.26273959794297, "endText": "23:42", "startPercent": 0, "end": 1778254967, "startText": "23:27"}, {"stage": "awake", "start": 1778254967, "widthPercent": 7.059373539036932, "endText": "23:45", "startPercent": 42.26273959794297, "end": 1778255118, "startText": "23:42"}, {"stage": "core", "vitals": {"avgRespiratoryRate": 15, "minHeartRate": 54, "maxHeartRate": 55, "avgHeartRate": 54.666666666666664}, "start": 1778255118, "widthPercent": 50.677886863020106, "endText": "00:03", "startPercent": 49.322113136979894, "end": 1778256202, "startText": "23:45"}], "date": "2026-05-08"}], "generatedAt": 1778311935, "schemaVersion": "health_sleep_v1"}, "id": "15FC0E56-C6CD-4730-B62C-C22D127BD80C", "kind": "sleepVisualization", "createdAt": "2026-05-09T07:32:15.386Z"}, {"id": "14590FB4-65F9-4953-B56E-7D2A09558E15", "text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "updatedAt": "2026-05-09T07:32:42.849Z", "kind": "text", "createdAt": "2026-05-09T07:32:39.463Z"}], "client_message_id": "DC29FBFC-22BD-45B0-BC22-2F6D386A1B46", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "tombstone": false, "thread_top_p": 1, "delivery_state": "pending", "created_at": "2026-05-09T07:32:10.865Z", "role": "assistant", "thread_id": "0C4B0BEE-CFEE-440D-8252-5862EF24E2D7"}, {"thread_max_tokens": 4096, "thread_max_messages": 20, "thread_system_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "model_name": "doubao-seed-2-0-pro-260215", "thread_temperature": 0.6, "thread_current_model_name": "doubao-seed-2-0-pro-260215", "blocks": [{"i