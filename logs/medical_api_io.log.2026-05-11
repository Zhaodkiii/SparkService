INFO 2026-05-11 04:56:53,824 medical.api_io [request_id=27D2EC84-C0F5-4468-9160-03A39ED7C355] HTTP 响应摘要: GET /api/v1/medical/members/1/complete-data/ status=200 duration_ms=68 bytes=24158 headers={"Content-Type": "application/json", "ETag": "\"c187a78267689a2f40c32455841fb929\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 1, "member": {"id": 1, "user": 1, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "2000-05-09", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-08T23:20:46.555952Z", "updated_at": "2026-05-08T23:20:46.555975Z"}, "medical_cases": [{"id": 1, "member": 1, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院；苏州市独墅湖医院", "age_at_visit": 28, "diagnosis_summary": "", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-05-09T00:09:54.618072Z", "updated_at": "2026-05-09T00:09:54.618094Z", "symptoms": ["阻生牙"], "medications": [], "attachments": [{"id": 7, "file_uuid": "8822e5c1-7b70-48b2-af45-a561257acad8", "original_name": "photo_C19E166F-5995-4A42-8514-68336A52BC95.jpg", "file_size": 3070076, "mime_type": "image/jpeg", "file_md5": "d470fcac1374ee0d2d3b7dc340ac61fc", "business_type": "medical_case", "business_id": "1", "object_key": "SparkClient/20260509/8822E5C1-7B70-48B2-AF45-A561257ACAD8/photo_C19E166F-5995-4A42-8514-68336A52BC95.jpg", "storage_type": "oss", "created_at": "2026-05-09T00:09:39.665065Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/8822E5C1-7B70-48B2-AF45-A561257ACAD8/photo_C19E166F-5995-4A42-8514-68336A52BC95.jpg"}, {"id": 6, "file_uuid": "55818f88-0897-46e3-be50-e9e2c674ebfd", "original_name": "photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "1", "object_key": "SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg", "storage_type": "oss", "created_at": "2026-05-09T00:09:39.000521Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg"}]}], "health_exam_reports": [{"id": 1, "user": 1, "member": 1, "institution_name": "苏州相城美年大健康体检中心", "report_no": "2025-05-17", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类），建议6～12个月复查，甲状腺专科随诊；2、舒张压偏低，建议多饮水，加强运动，结合病史必要时复测血压，若出现头昏、头晕、胸闷等症状，请及时心内科就诊；3、窦性心动过缓伴不齐，建议年度复查心电图和心脏超声，结合病史和症状心内科随诊；4、心电轴左偏，建议年度复查心电图和心脏超声，结合病史和症状心内科随诊；5、肝内钙化灶，建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊；6、超重，建议控制膳食总量，低脂、低糖饮食，增加新鲜蔬菜和水果比重，逐渐增加规律有氧运动，控制体重增长；7、血清总胆红素测定增高、血清直接胆红素测定增高，除外体液浓缩因素影响，建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊；8、血小板压积增高，建议结合病史和症状定期复查血常规，如有明显异常请内科就诊；9、左眼、右眼视力低于正常标准，增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-09T05:58:59.689065Z", "updated_at": "2026-05-09T05:58:59.689083Z", "attachments": [{"id": 12, "file_uuid": "4ae6517a-abe8-4d53-a9e8-afea15256dce", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "1", "object_key": "SparkClient/20260509/4AE6517A-ABE8-4D53-A9E8-AFEA15256DCE/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-09T05:58:28.911350Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/4AE6517A-ABE8-4D53-A9E8-AFEA15256DCE/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 2, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "内锐所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常；诊断：慢性非菱缩性胃炎伴胆汁反流；建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.634817Z", "updated_at": "2026-05-09T00:09:54.634829Z", "attachments": []}, {"id": 1, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "门（急）诊病历", "performed_at": "2026-02-06T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "主诉：要求口腔检查1天；现病史：今日来诊要求口腔检查；既往史：慢性疾病史：否认；其他：；过敏史：无；体格检查：皮肤黏膜：未检；胸部：未检；肺脏及胸膜：未检；心脏：未检；腹部：未检；神经反射：未检；其他专科检查：38/48近中低位阻生，远中牙龈覆盖，龈红肿；诊断：阻生牙 K01.100；处理措施：保持口腔卫生，建议择期拔除阻生牙", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.629258Z", "updated_at": "2026-05-09T00:09:54.629271Z", "attachments": []}, {"id": 9, "user": 1, "member": 1, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "渠玺", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-11T04:54:06.174393Z", "updated_at": "2026-05-11T04:54:06.174420Z", "attachments": [{"id": 45, "file_uuid": "791cfa39-5678-403f-973f-7a49296a12b2", "original_name": "c669618b968a0bfba5ec848a8763a426.pdf", "file_size": 134480, "mime_type": "application/pdf", "file_md5": "1f9d4b9484343f253354bdd1454bd8c3", "business_type": "examination_report", "business_id": "9", "object_key": "SparkClient/20260511/791CFA39-5678-403F-973F-7A49296A12B2/c669618b968a0bfba5ec848a8763a426.pdf", "storage_type": "oss", "created_at": "2026-05-11T04:53:44.824453Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260511/791CFA39-5678