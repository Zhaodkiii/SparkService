INFO 2026-04-12 12:38:29,002 medical.api_io [request_id=4B314AE8-9C5E-4CFA-9B11-3C71F9C194A1] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "localhost:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.300.31 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc1OTk5MzA4LCJpYXQiOjE3NzU5OTc1MDgsImp0aSI6IjFiOWY0MzZjODUzNDRjYjQ5OTg2MmYxNGRjZDhmYTY1IiwidXNlcl9pZCI6IjEifQ.-lMR8THJGJ0xvG42_BadRPdf_Pgc_PDout7ecNDk7oE", "X-Request-Id": "4B314AE8-9C5E-4CFA-9B11-3C71F9C194A1", "Content-Length": "8311"} body={"symptom": {"body_part": "口腔", "duration_unit": "天", "name": "口腔检查要求", "duration_value": 1, "started_at": "2026-02-05"}, "examination_reports": [{"findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。活检部位：无。建议：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "details": [{"body_part": "食管、贲门、胃底、胃体、胃角、胃窦、幽门、十二指肠球部、十二指肠降部", "result_value": "食管黏膜大致正常，胃体见胆汁残留，胃窦黏膜红白相间以红为主，其余部位未见明显异常", "item_name": "无痛电子胃镜检查", "diagnosis": "慢性非萎缩性胃炎伴胆汁反流", "category": "消化内镜", "sub_category": "无痛电子胃镜"}], "item_name": "无痛电子胃镜检查报告", "doctor_name": "欧啡", "performed_at": "2026-02-10", "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "category": "imaging"}, {"findings": "采样时间：2025-12-28 09:24，核收时间：2025-12-28 10:08，报告时间：2025-12-28 10:48，送检科室：口腔科门诊，临床印象：口腔黏膜溃疡。检验项目包括总胆红素、直接胆红素、间接胆红素、天门冬氨酸氨基转移酶、丙氨酸氨基转移酶、总蛋白、白蛋白、球蛋白、白蛋白/球蛋白、γ-谷氨酰转肽酶、碱性磷酸酶、前白蛋白、尿素、肌酐、尿酸、胱抑素C、葡萄糖、肌酸激酶、乳酸脱氢酶、α-羟丁酸脱氢酶、胆碱酯酶、甘油三酯、总胆固醇、高密度脂蛋白胆固醇、低密度脂蛋白胆固醇等，结果均在参考区间内。检验建议：结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。", "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "details": [{"unit": "", "reference_range": "≤26", "result_value": "13.5", "item_name": "总胆红素", "category": "生化检验", "sub_category": "肾功能检验"}, {"unit": "", "reference_range": "≤8",