INFO 2026-04-12 14:59:21,686 medical.api_io [request_id=258AD349-CCE1-46F6-A7D7-D749BAA46014] HTTP 响应摘要: GET /api/v1/medical/members/16/complete-data/ status=200 duration_ms=73 bytes=18383 headers={"Content-Type": "application/json", "ETag": "\"90839b1d868784b66a1b417dcf6cad37\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 16, "member": {"id": 16, "user": 1, "name": "阿瑟费", "gender": "male", "relationship": "other", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T10:26:26.343686Z", "updated_at": "2026-04-12T10:26:26.343723Z"}, "medical_cases": [{"id": 43, "member": 16, "record_type": "custom", "status": 1, "title": "用药记录 (3项药品)", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"source": "medication_only"}, "created_at": "2026-04-12T14:59:13.289223Z", "updated_at": "2026-04-12T14:59:13.289246Z", "symptoms": [], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏（路利特）"], "attachments": []}, {"id": 42, "member": 16, "record_type": "custom", "status": 1, "title": "处方: 高血压、高脂血症、腔隙性脑梗死、失眠", "hospital_name": "东部战区总医院", "age_at_visit": null, "diagnosis_summary": "高血压、高脂血症、腔隙性脑梗死、失眠", "extra": {"batch_no": "7303148447", "occurred_at": "2025-06-27"}, "created_at": "2026-04-12T14:58:17.860263Z", "updated_at": "2026-04-12T14:58:17.860299Z", "symptoms": [], "medications": ["甲磺酸倍他司汀片", "硫酸氢氯吡格雷片", "阿托伐他汀钙片"], "attachments": []}, {"id": 41, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无。专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。2025年12月28日行生化检验、肾功能检验，临床印象为口腔黏膜溃疡，检验结果大致正常。处方包含卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T12:38:29.016437Z", "updated_at": "2026-04-12T12:38:29.016462Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 155, "file_uuid": "30d6e733-bfe1-4faf-a006-c011d973df5f", "original_name": "photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "file_size": 290933, "mime_type": "image/jpeg", "file_md5": "b4647564d696c15d55ede32341c30b54", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/30D6E733-BFE1-4FAF-A006-C011D973DF5F/photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:09.152875Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/30D6E733-BFE1-4FAF-A006-C011D973DF5F/photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg"}, {"id": 154, "file_uuid": "db6521d6-89a1-4912-b962-27958cd5925e", "original_name": "photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg", "file_size": 2881639, "mime_type": "image/jpeg", "file_md5": "e2e7eba032f7e39160ba09c79ba20bea", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/DB6521D6-89A1-4912-B962-27958CD5925E/photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:08.961279Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/DB6521D6-89A1-4912-B962-27958CD5925E/photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg"}, {"id": 153, "file_uuid": "a543cc88-ea6e-4827-b212-fca836f479b9", "original_name": "photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/A543CC88-EA6E-4827-B212-FCA836F479B9/photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:07.660368Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/A543CC88-EA6E-4827-B212-FCA836F479B9/photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg"}, {"id": 152, "file_uuid": "776e1fe4-22b1-41e9-9fee-2a869e728b49", "original_name": "photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/776E1FE4-22B1-41E9-9FEE-2A869E728B49/photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:07.462859Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/776E1FE4-22B1-41E9-9FEE-2A869E728B49/photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg"}]}, {"id": 37, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史无慢性疾病史，过敏史无，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院行无痛电子胃镜检查，内镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T10:27:41.963334Z", "updated_at": "2026-04-12T10:27:41.963346Z", "symptoms": ["口腔检查要求"], "medications": [], "attachments": [{"id": 151, "file_uuid": "7ec2265c-c82b-4a88-9564-830b154f4f3e", "original_name": "photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.546026Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg"}, {"id": 150, "file_uuid": "5b767615-0755-4757-9034-bd7c9fd78900", "original_name": "photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.338921Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg"}]}], "health_exam_reports": [], "examination_reports": [{"id": 52, "user": 1, "member": 16, "medical_record": 41, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。活检部位：无。建议：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.035871Z", "updated_at": "2026-04-12T12:38:29.035891Z", "attachments": []}, {"id": 45, "user": 1, "member": 16, "medical_record": 37, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T10:27:41.975688Z", "updated_at": "2026-04-12T10:27:41.975695Z", "attachments": []}, {"id": 53, "user": 1, "member": 16, "medical_record": 41, "category": "laboratory", "sub_category": "", "item_name": "生化检验、肾功能检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "朱孝明", "findings": "采样时间：2025-12-28 09:24，核收时间：2025-12-28 10:08，报告时间：2025-12-28 10:48，送检科室：口腔科门诊，临床印象：口腔黏膜溃疡。检验项目包括总胆红素、直接胆红素、间接胆红素、天门冬氨酸氨基转移酶、丙氨酸氨基转移酶、总蛋白、白蛋白、球蛋白、白蛋白/球蛋白、γ-谷氨酰转肽酶、碱性磷酸酶、前白蛋白、尿素、肌酐、尿酸、胱抑素C、葡萄糖、肌酸激酶、乳酸脱氢酶、α-羟丁酸脱氢酶、胆碱酯酶、甘油三酯、总胆固醇、高密度脂蛋白胆固醇、低密度脂蛋白胆固醇等，结果均在参考区间内。检验建议：结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.045232Z", "updated_at": "2026-04-12T12:38:29.045246Z", "attachments": []}], "prescription_batches": [{"id": 32, "user": 1, "member": 16, "medical_case": 41, "prescriber_name": "", "institution_name": "", "prescribed_at": "2026-02-06T00:00:00Z", "diagnosis": "阻生牙", "batch_no": null, "status": "active", "auditor_name": "", "audited_at": null, "extra": {}, "created_at": "2026-04-12T12:38:29.118020Z", "updated_at": "2026-04-12T12:38:29.118028Z", "medications": [{"id": 69, "user": 1, "member": 16, "batch": 32, "generic_name": "伊曲康唑分散片", "brand_name": "", "drug_name": "伊曲康唑分散片", "dosage_form": "分散片", "strength": "0.1g*14片", "route": "口服", "dose_per_time": "2片/次", "dose_value": 2.0, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 1, "frequency_text": "每天1次", "duration_days": 14, "instructions": "口服 每天1次 2片/次", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-04-12T12:38:29.133869Z", "updated_at": "2026-04-12T12:38:29.133875Z"}, {"id": 68, "user": 1, "member": 16, "batch": 32, "generic_name": "克霉唑阴道膨胀栓", "brand_name": "", "drug_name": "克霉唑阴道膨胀栓", "dosage_form": "阴道膨胀栓", "strength": "0.15g*4粒", "route": "阴塞",