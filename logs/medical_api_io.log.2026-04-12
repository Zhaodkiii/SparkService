INFO 2026-04-12 12:38:44,856 medical.api_io [request_id=E87EC8A8-1EC3-4A62-8A61-83BA4AAAF8F2] HTTP 响应摘要: GET /api/v1/medical/members/16/complete-data/ status=200 duration_ms=77 bytes=13252 headers={"Content-Type": "application/json", "ETag": "\"38f5db6ff635de137cc6d00205fd2a2b\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 16, "member": {"id": 16, "user": 1, "name": "阿瑟费", "gender": "male", "relationship": "other", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T10:26:26.343686Z", "updated_at": "2026-04-12T10:26:26.343723Z"}, "medical_cases": [{"id": 41, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无。专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。2025年12月28日行生化检验、肾功能检验，临床印象为口腔黏膜溃疡，检验结果大致正常。处方包含卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T12:38:29.016437Z", "updated_at": "2026-04-12T12:38:29.016462Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 155, "file_uuid": "30d6e733-bfe1-4faf-a006-c011d973df5f", "original_name": "photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "file_size": 290933, "mime_type": "image/jpeg", "file_md5": "b4647564d696c15d55ede32341c30b54", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/30D6E733-BFE1-4FAF-A006-C011D973DF5F/photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:09.152875Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkC