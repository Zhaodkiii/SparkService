": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T10:27:41.963334Z", "updated_at": "2026-04-12T10:27:41.963346Z", "symptoms": ["口腔检查要求"], "medications": [], "attachments": [{"id": 151, "file_uuid": "7ec2265c-c82b-4a88-9564-830b154f4f3e", "original_name": "photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.546026Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg"}, {"id": 150, "file_uuid": "5b767615-0755-4757-9034-bd7c9fd78900", "original_name": "photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.338921Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg"}]}], "health_exam_reports": [], "examination_reports": [{"id": 52, "user": 1, "member": 16, "medical_record": 41, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。活检部位：无。建议：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.035871Z", "updated_at": "2026-04-12T12:38:29.035891Z", "attachments": []}, {"id": 45, "user": 1, "member": 16, "medical_record": 37, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T10:27:41.975688Z", "updated_at": "2026-04-12T10:27:41.975695Z", "attachments": []}, {"id": 53, "user": 1, "member": 16, "medical_record": 41, "category": "laboratory", "sub_category": "", "item_name": "生化检验、肾功能检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "朱孝明", "findings": "采样时间：2025-12-28 09:24，核收时间：2025-12-28 10:08，报告时间：2025-12-28 10:48，送检科室：口腔科门诊，临床印象：口腔黏膜溃疡。检验项目包括总胆红素、直接胆红素、间接胆红素、天门冬氨酸氨基转移酶、丙氨酸氨基转移酶、总蛋白、白蛋白、球蛋白、白蛋白/球蛋白、γ-谷氨酰转肽酶、碱性磷酸酶、前白蛋白、尿素、肌酐、尿酸、胱抑素C、葡萄糖、肌酸激酶、乳酸脱氢酶、α-羟丁酸脱氢酶、胆碱酯酶、甘油三酯、总胆固醇、高密度脂蛋白胆固醇、低密度脂蛋白胆固醇等，结果均在参考区间内。检验建议：结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.045232Z", "updated_at": "2026-04-12T12:38:29.045246Z", "attachments": []}, {"id": 68, "user": 1, "member": 16, "medical_record": 44, "category": "超声检查", "sub_category": "", "item_name": "超声检查检查", "performed_at": "2023-01-08T00:00:00Z", "reported_at": null, "organization_name": "苏州美健奥亚健康体检中心", "department_name": "", "doctor_name": "", "findings": null, "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T15:37:33.271428Z", "updated_at": "2026-04-12T15:37:33.271510Z", "attachm