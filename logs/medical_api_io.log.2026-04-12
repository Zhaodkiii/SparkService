e": "朱孝明", "findings": "采样时间：2025-12-28 09:24，核收时间：2025-12-28 10:08，报告时间：2025-12-28 10:48，送检科室：口腔科门诊，临床印象：口腔黏膜溃疡。检验项目包括总胆红素、直接胆红素、间接胆红素、天门冬氨酸氨基转移酶、丙氨酸氨基转移酶、总蛋白、白蛋白、球蛋白、白蛋白/球蛋白、γ-谷氨酰转肽酶、碱性磷酸酶、前白蛋白、尿素、肌酐、尿酸、胱抑素C、葡萄糖、肌酸激酶、乳酸脱氢酶、α-羟丁酸脱氢酶、胆碱酯酶、甘油三酯、总胆固醇、高密度脂蛋白胆固醇、低密度脂蛋白胆固醇等，结果均在参考区间内。检验建议：结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.045232Z", "updated_at": "2026-04-12T12:38:29.045246Z", "attachments": []}], "prescription_batches": [{"id": 32, "user": 1, "member": 16, "medical_case": 41, "prescriber_name": "", "institution_name": "", "prescribed_at": "2026-02-06T00:00:00Z", "diagnosis": "阻生牙", "batch_no": null, "status": "active", "auditor_name": "", "audited_at": null, "extra": {}, "created_at": "2026-04-12T12:38:29.118020Z", "updated_at": "2026-04-12T12:38:29.118028Z", "medications": [{"id": 69, "user": 1, "member": 16, "batch": 32, "generic_name": "伊曲康唑分散片", "brand_name": "", "drug_name": "伊曲康唑分散片", "dosage_form": "分散片", "strength": "0.1g*14片", "route": "口服", "dose_per_time": "2片/次", "dose_value": 2.0, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 1, "frequency_text": "每天1次", "duration_days": 14, "instructions": "口服 每天1次 2片/次", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-04-12T12:38:29.133869Z", "updated_at": "2026-04-12T12:38:29.133875Z"}, {"id": 68, "user": 1, "member": 16, "batch": 32, "generic_name": "克霉唑阴道膨胀栓", "brand_name": "", "drug_name": "克霉唑阴道膨胀栓", "dosage_form": "阴道膨胀栓", "strength": "0.15g*4粒", "route": "阴塞", "dose_per_time": "1粒/次", "dose_value": 1.0, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 1, "frequency_text": "每天1次", "duration_days": 4, "instructions": "阴塞 每天1次 1粒/次", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-04-12T12:38:29.130426Z", "updated_at": "2026-04-12T12:38:29.130433Z"}, {"id": 