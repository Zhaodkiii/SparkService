", "item_name": "癌胚抗原测定定量"}, {"result_value": "2.44", "unit": "ng/mL", "reference_range": "0-10 ng/mL", "sort_order": 4, "category": "肿瘤标志物", "item_code": "AFP", "item_name": "甲胎蛋白测定定量"}], "item_name": "肿瘤标志物检查", "performed_at": "2023-01-08"}, {"organization_name": "苏州美健奥亚健康体检中心", "category": "内科", "details": [{"item_name": "病史", "sort_order": 4, "category": "内科", "result_value": "无"}, {"item_name": "心率", "sort_order": 4, "category": "内科", "result_value": "78", "unit": "次/分"}, {"item_name": "呼吸", "sort_order": 4, "category": "内科", "result_value": "18", "unit": "次/分"}, {"item_name": "心律", "sort_order": 4, "category": "内科", "result_value": "整齐"}, {"item_name": "心音", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "心脏杂音", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "心脏其他", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "肺罗音", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "呼吸音", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "腹壁", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "肝大小", "sort_order": 4, "category": "内科", "result_value": "未见异常"}, {"item_name": "肝脏质地", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "肝脏压痛", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "脾大小", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "脾脏质地", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "脾脏压痛", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "其他", "result_value": "未见异常", "category": "内科", "sort_order": 4}, {"item_name": "内科小结", "result_value": "内科未发现明显异常", "category": "内科", "sort_order": 4}], "item_name": "内科检查", "performed_at": "2023-01-08"}, {"organization_name": "苏州美健奥亚健康体检中心", "category": "体格检查", "details": [{"result_value": "166.0", "unit": "Cm", "sort_order": 4, "category": "体格检查", "ite