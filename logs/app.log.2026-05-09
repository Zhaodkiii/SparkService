bstone": false, "role": "assistant", "thread_max_messages": 20, "thread_current_model_name": "doubao-seed-2-0-pro-260215", "thread_system_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "delivery_state": "pending", "server_updated_at": "2026-05-09T06:57:44.926Z", "model_name": "doubao-seed-2-0-pro-260215", "thread_id": "9E1AC2A7-E0DA-4490-8D55-AAED8995F3EF", "client_message_id": "D9123966-A96B-45DC-8C0C-C7D84B03D4E1", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}"}]}
