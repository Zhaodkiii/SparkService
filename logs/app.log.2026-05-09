gRespiratoryRate": 15.5, "maxHeartRate": 59}, "startText": "23:27", "stage": "core", "startPercent": 0, "end": 1778254967}, {"endText": "23:45", "widthPercent": 7.059373539036932, "start": 1778254967, "startText": "23:42", "stage": "awake", "startPercent": 42.26273959794297, "end": 1778255118}, {"endText": "00:03", "widthPercent": 50.677886863020106, "start": 1778255118, "vitals": {"minHeartRate": 54, "avgHeartRate": 54.666666666666664, "avgRespiratoryRate": 15, "maxHeartRate": 55}, "startText": "23:45", "stage": "core", "startPercent": 49.322113136979894, "end": 1778256202}]}], "schemaVersion": "health_sleep_v1", "generatedAt": 1778311935}, "toolCallID": "call_jhr6siwzsz83bf9p4bayehow", "createdAt": "2026-05-09T07:32:15.386Z", "kind": "sleepVisualization"}, {"text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "updatedAt": "2026-05-09T07:32:42.849Z", "id": "14590FB4-65F9-4953-B56E-7D2A09558E15", "kind": "text", "createdAt": "2026-05-09T07:32:39.463Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "a984bccd-73f5-48fc-9dec-7150cfbe608f", "role": "assistant", "model_name": "doubao-seed-2-0-pro-260215", "client_message_id": "88553223-5d04-43b0-8b9f-d3d34c5e40b8", "server_message_id": "b856cdfb-7d70-4d9e-9699-2b0a517c7834", "delivery_state": "sent", "created_at": "2026-05-09T07:37:00.195000+00:00", "server_updated_at": "2026-05-09T07:37:18.556090+00:00", "tombstone": false, "attachments": [], "blocks": [{"text": "我是专注于健康领域的助手，能帮你做这些事哦：\n1. **健康数据查询与分析**：可以调取你的步数、热量消耗、饮食营养、睡眠、运动记录等数据，帮你分析运动效果、睡眠质量、饮食结构是否合理\n2. **健康建议定制**：结合你的健康数据，给出运动、饮食、作息调整的可执行建议\n3. **健康管理工具**：帮你生成营养卡片、健康记录卡片，创建待办健康任务，设置用药/运动提醒等\n4. **健康知识解答**：可以解答普通健康疑问、医学常识，帮你解读常规体检报告、用药说明等\n5. **生活服务辅助**：查询天气、规划路线、搜索周边场所、调取日历/提醒事项，帮你更好规划健康相关的出行和日程\n\n如果你有具体的需求，比如查看近期睡眠情况、算一下今天的饮食热量是否合理，都可以直接告诉我哦~", "createdAt": "2026-05-09T07:36:55.117Z", "kind": "text", "id": "2BEBDECB-369D-4213-9EB8-3E396EEF5CD1", "updatedAt": "2026-05-09T07:37:00.172Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "a984bccd-73f5-48fc-9dec-7150cfbe608f", "role": "user", "model_name": "user", "client_message_id": "380f7d61-b4b9-47ad-8dd1-7210be2c0586", "server_message_id": "5d33e669-8b6f-4b5d-a3c7-aad20a491641", "delivery_state": "sent", "created_at": "2026-05-09T07:37:18.425000+00:00", "server_updated_at": "2026-05-09T07:37:18.560854+00:00", "tombstone": false, "attachments": [], "blocks": [{"text": "给我选项", "updatedAt": "2026-05-09T07:37:18.425Z", "id": "CF50333C-2868-4A80-ADBA-90780095F681", "kind": "text", "createdAt": "2026-05-09T07:37:18.425Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}]}}
