INFO 2026-05-15 05:26:26,640 medical.api_io [request_id=40E01A09-959E-4334-91C4-590093135D97] HTTP 响应摘要: GET /api/v1/medical/members/9/complete-data/ status=200 duration_ms=106 bytes=16336 headers={"Content-Type": "application/json", "ETag": "\"83e26ac1f8be5b5346b6a61f96deafee\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 9, "member": {"id": 9, "user": 1, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "2002-05-14", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-14T08:24:43.376165Z", "updated_at": "2026-05-14T08:24:43.376194Z"}, "medical_cases": [{"id": 21, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T09:01:03.644379Z", "updated_at": "2026-05-14T09:01:03.644406Z", "symptoms": ["头晕"], "medications": [], "attachments": []}, {"id": 20, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-