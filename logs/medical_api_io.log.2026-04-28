/L，参考区间>1.04mmol/L；9.低密度脂蛋白胆固醇（LDL-C）3.51mmol/L，高于参考区间理想<2.60mmol/L，处于适宜<3.40mmol/L以上、增高3.40-4.14mmol/L区间。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-26T06:31:00.395813Z", "updated_at": "2026-04-26T06:31:00.395837Z", "attachments": []}], "prescription_batches": [{"id": 48, "user": 6, "member": 24, "medical_case": 61, "prescriber_name": "", "institution_name": "", "prescribed_at": "2025-12-28T00:00:00Z", "diagnosis": "口腔黏膜溃疡", "batch_no": null, "status": "active", "auditor_name": "", "audited_at": null, "extra": {}, "created_at": "2026-04-26T06:31:00.462367Z", "updated_at": "2026-04-26T06:31:00.462393Z", "medications": [], "attachments": []}], "standalone_medications": [], "symptoms": [{"id": 35, "user": 6, "member": 24, "medical_case": 61, "name": "口腔检查要求；龈红肿", "code": "", "severity": "", "started_at": null, "duration_value": null, "duration_unit": "", "body_part": "口腔", "notes": "", "extra": {}, "created_at": "2026-04-26T06:31:00.372885Z", "updated_at": "2026-04-26T06:31:00.372909Z"}], "visits": [{"id": 33, "user": 6, "member": 24, "medical_case": 61, "visit_type": "门诊", "visited_at": "2026-02-06T00:00:00Z", "department": "口腔科门诊", "doctor_name": "", "visit_no": "", "source_system_id": "", "notes": "初诊，处理建议保持口腔卫生，择期拔除阻生牙", "extra": {}, "created_at": "2026-04-26T06:31:00.386688Z", "updated_at": "2026-04-26T06:31:00.386718Z"}], "surgeries": [], "follow_ups": []}}
