INFO 2026-04-22 01:56:50,366 chat_sync.sync [request_id=B2D19073-5E02-408D-936F-FA803E1A65CC] chat push payload request_id=B2D19073-5E02-408D-936F-FA803E1A65CC user_id=6 content_type=application/json body={"messages":[{"thread_id":"2f4320ab-17e8-4aee-8dac-92f69122286f","role":"user","kind":"text","content":"你好呀事实上","client_message_id":"598588c7-a930-4f44-a9ab-83d0371eb344","delivery_state":"pending","created_at":"2026-04-22 01:56:50.310000+00:00","tombstone":false,"thread_current_model_name":"doubao-seed-2-0-lite-260215","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":4096,"thread_max_messages":20,"thread_role_prompt":"","attachments":[{"text":"苏州大学附属第四医院\n苏州市独墅湖医院\n胃镜诊断报告单\n姓名：赵道凯\n性别：男\n年龄：28 岁\n申请科室：消化内科门诊\n门诊号：0000349056\n住院号：\n床号：\n病区：\n检查项目：无痛电子胃镜（不含麻醉费）\n申请单号：260821105\n①食管\n②齿状线\n③胃底\n①胃体\n⑤胃角\n6胃窦\n⑦十二指肠球部\n⑧十二指肠降部\n内镜所见：\n食管：通过顺利，黏膜大致正常；\n贲门：开合佳通畅；\n胃底：黏膜正常；\n胃体：见胆汁残留；\n胃角：光整；\n胃窦：黏膜红白相间，以红沩主；\n幽门：圆，开放好；\n十二指肠球部及所见降部：未见明显异常。\n诊断：\n慢性非萎缩性胃炎伴胆汁反流\n活检部位：\n建议：\n报告医生：\n审核医师：产州的\n报告时间：2026-02-10\n备注：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告！","fullCacheKey":"01d954e5-4f8e-4247-bac6-a4913850b19b/342395b5cd7bf2dad1ea494355711848.pdf","url":"https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260422/01D954E5-4F8E-4247-BAC6-A4913850B19B/342395b5cd7bf2dad1ea494355711848.pdf","id":"053F4F59-A6EC-4717-A406-23A1AC892186","fileId":297,"type":"pdf","fileMd5":"98c76af8cdbe6b67f5918596c76803b8"}],"reasoning_expanded":false,"reasoning_visibility":"full"}]}
