INFO 2026-05-18 14:20:17,473 accounts.api_io [request_id=24412914-4f38-43bb-a6c4-beb9cc092572] HTTP 响应摘要: GET /api/admin/v1/ai/tool-options/ status=200 duration_ms=21 bytes=2044 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": [{"value": "fetch_step_details", "label": "步数详情"}, {"value": "fetch_energy_details", "label": "能量详情"}, {"value": "fetch_nutrition_details", "label": "营养详情"}, {"value": "make_nutrition_data", "label": "生成营养数据"}, {"value": "fetch_sleep_details", "label": "睡眠详情"}, {"value": "fetch_workout_details", "label": "运动详情"}, {"value": "search_knowledge_bag", "label": "搜索知识库"}, {"value": "create_knowledge_document", "label": "创建知识文档"}, {"value": "search_calendar_and_reminders", "label": "搜索日历与提醒"}, {"value": "write_system_event", "label": "写入系统事件"}, {"value": "query_location", "label": "查询位置"}, {"value": "get_current_location", "label": "获取当前位置"}, {"value": "search_nearby_locations", "label": "搜索附近地点"}, {"value": "get_route", "label": "路线规划"}, {"value": "query_weather", "label": "查询天气"}, {"value": "save_memory", "label": "保存记忆"}, {"value": "retrieve_memory", "label": "检索记忆"}, {"value": "update_memory", "label": "更新记忆"}, {"value": "generate_chat_title", "label": "生成会话标题"}, {"value": "show_custom_message_card", "label": "展示消息卡片"}, {"value": "ask_user_question", "label": "询问用户"}, {"value": "get_current_member", "label": "获取当前成员"}, {"value": "request_member_selection", "label": "请求选择成员"}, {"value": "switch_member", "label": "切换成员"}, {"value": "find_member", "label": "查找成员"}, {"value": "query_member_profile", "label": "查询成员资料"}, {"value": "search_online", "label": "联网搜索"}, {"value": "read_web_page", "label": "读取网页"}, {"value": "search_arxiv_papers", "label": "搜索 arXiv 论文"}, {"value": "extract_remote_file_content", "label": "提取远程文件内容"}, {"value": "create_canvas", "label": "创建画布"}, {"value": "edit_canvas", "label": "编辑画布"}, {"value": "generate_structured_health_card", "label":