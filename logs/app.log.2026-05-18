INFO 2026-05-18 13:26:40,872 accounts.api_io [request_id=e33953b5-08e5-4aed-b986-3cb7664a1fc3] HTTP 响应摘要: GET /api/admin/v1/ai/providers/ status=200 duration_ms=9 bytes=8464 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, POST, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": [{"id": 1, "kind": "api", "name": "Cherry Studio", "company": "CHERRY_IN", "request_url": "https://open.cherryin.net/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://open.cherryin.ai/console/token", "privacy_policy_url": "", "source": "system", "position": 0, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 2, "kind": "api", "name": "智谱 AI", "company": "ZHIPUAI", "request_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://bigmodel.cn/usercenter/proj-mgmt/apikeys", "privacy_policy_url": "", "source": "system", "position": 1, "is_active": true, "updated_at": "2026-03-22T14:22:53.011131Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 3, "kind": "api", "name": "通义千问", "company": "QWEN", "request_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://bailian.console.aliyun.com/?tab=model#/api-key", "privacy_policy_url": "", "source": "system", "position": 2, "is_active": true, "updated_at": "2026-03-22T16:25:36.175735Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 4, "kind": "api", "name": "DeepSeek", "company": "DEEPSEEK", "request_url": "https://api.deepseek.com/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://platform.deepseek.com/api_keys", "privacy_policy_url": "", "source": "system", "position": 3, "is_active": true, "updated_at": "2026-05-18T07:10:00.450220Z", "created_at": "2026-03-08T14