arios": ["optimization_text"], "aiToolScenarios": [], "relatedTaskCodes": [], "is_default": true, "temperature": 0.6, "max_tokens": 12048}, {"name": "doubao-seed-2-0-pro-260215", "display_name": "seed-2-0-pro-260215", "identity": "model", "company": "DOUBAO", "endpoint": "https://ark.cn-beijing.volces.com/api/v3/chat/completions", "api_key": "fe01b1e5-8ed6-446a-a0d3-3906a6bc6aa2", "supports_search": true, "supports_multimodal": true, "supports_reasoning": true, "supports_tool_use": true, "supports_voice_gen": false, "supports_image_gen": true, "supports_text": true, "supports_deep_reasoning": true, "reasoning_controllable": true, "price_tier": 1, "systemProvision": "", "icon": "", "briefDescription": "", "source": "pro", "aiScenarios": ["optimization_text"], "aiToolScenarios": [], "relatedTaskCodes": [], "is_default": false, "temperature": 0.2, "max_tokens": 2048}]}, "optimization_visual": {"default_model": "", "models": []}, "context_folding": {"default_model": "", "models": []}, "router": {"default_model": "", "models": []}, "model_config": {"default_model": "", "models": []}, "report_interpretation": {"default_model": "", "models": []}}, "smallTasks": [{"id": 1, "name": "今日健康总结", "code": "Service_1", "brief": "汇总用户当天的步数、能量、饮食、睡眠等数据，生成结构化健康卡片", "prompt": "你是健康分析助手，请根据用户的健康数据生成每日总结：\n\n要求：\n1. 调用相关健康数据工具获取：\n- 步数\n- 能量消耗\n- 营养摄入\n- 睡眠情况\n2. 对数据进行分析：\n- 是否达标\n- 是否异常\n- 是否需要优化\n3. 输出结构化总结\n4. 调用工具生成健康卡片展示结果\n\n风格：\n- 简洁\n- 有建议\n- 不冗长\n{{CURRENT_DATE}}", "icon": "heart.text.square", "tool_list": ["fetch_step_details", "fetch_energy_details", "fetch_nutrition_details", "fetch_sleep_details", "generate_structured_health_card"], "source": "Service"}, {"id": 2, "name": "睡眠质量分析", "code": "Service_2", "brief": "分析用户睡眠情况并提供优化建议", "prompt": "分析用户睡眠数据：\n\n1. 获取睡眠数据 最近三天\n2. 判断：\n- 睡眠时长是否充足\n- 深睡比例\n- 作息规律性\n3. 输出：\n- 睡眠评分\n- 问题点\n- 改进建议\n\n尽量具体且可执行\n{{CURRENT_DATE}}", "icon": "bed.double.fill", "tool_list": ["fetch_sleep_details"], "source": "Service"}, {"id": 3, "name": "饮食营养建议", "code": "Service_3", "brief": "根据用户饮食情况生成营养优化方案", "prompt": "你是营养师：\n\n1. 获取用户营养摄入数据\n2. 分析：\n- 热量是否合理\n- 蛋白质/脂肪/碳水比例\n3. 输出：\n- 当前问题\n- 优化建议\n4. 如数据缺失，可生成合理估算\n\n建议要具体到食物\n{{CURRENT_DATE}}", "icon": "leaf.circle.fill", "tool_list": ["fetch_nutrition_details", "make_nutrition_data"], "source": "Service"}, {"id": 4, "name": "智能任务生成", "code": "Service_4", "brief": "根据用户目标自动拆解任务并创建", "prompt": "你是任务规划助手：\n\n1. 理解用户目标\n2. 拆解为可执行任务：\n- 明确\n- 可完成\n- 有时间边界\n3. 调用工具创建任务\n\n规则：\n- 每个任务尽量简单\n- 避免模糊描述", "icon": "checklist", "tool_list": ["generate_task"], "source": "Service"}]}}
