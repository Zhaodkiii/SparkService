INFO 2026-05-21 12:37:33,175 chat_sync.sync [request_id=67E30FE1-1DEB-4B49-B998-0B6A61AE6C3C] chat push payload request_id=67E30FE1-1DEB-4B49-B998-0B6A61AE6C3C user_id=5 content_type=application/json body={"messages":[],"block_updates":[{"thread_id":"afadc329-89a4-4f1b-827b-3d3e338363c4","client_message_id":"35a2c35f-0a08-4fab-a5d8-8314f28297a2","block":{"revision":1779367020748970,"order_key":4100,"status":"ready","anchor":{"type":"toolCall","value":"call_01_5B5NnFvX56Ki0xRSGXmU2155"},"created_at":"2026-05-21T12:37:00.739Z","updated_at":"2026-05-21T12:37:32.611Z","node_role":"toolPresentation","parent_block_id":"566946CD-51E5-57FA-8A06-DF6B0CD8DFDE","id":"0B00D813-E3FF-521A-9D7C-A7135295D253","payload":{"structured_health_cards":{"_0":{"exam_reports":[{"title":"放射科诊断报告书","member_id":19,"is_saved":true,"oss_file_id":568,"id":"691936B6-D3BA-4542-AB3C-6034C8D72C12","draft_json":"{\"attachment_file_ids\":[],\"category\":\"imaging\",\"content\":\"检查所见：头颅CT平扫脑实质未见明显异常，各脑室形态大小正常，中线结构居中，小脑及脑干未见异常。鼻咽顶后壁软组织增厚。颈椎生理曲度平直，椎体缘骨质增生，C4\\/5、C5\\/6椎间盘稍向后突出，相邻硬膜囊稍受压，骨性椎管无明显狭窄。两侧颈部、颌下区多发小淋巴结。右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；所示右侧声带相对稍厚。\",\"date\":\"2025-06-04\",\"details\":[{\"attachment_file_ids\":[],\"category\":\"影像学检查\",\"diagnosis\":\"1.头颅CT平扫未见明显异常。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；所示右侧声带相对稍厚。\",\"result_value\":\"头颅CT平扫脑实质未见明显异常，各脑室形态大小正常，中线结构居中，小脑及脑干未见异常。鼻咽顶后壁软组织增厚。颈椎生理曲度平直，椎体缘骨质增生，C4\\/5、C5\\/6椎间盘稍向后突出，相邻硬膜囊稍受压，骨性椎管无明显狭窄。两侧颈部、颌下区多发小淋巴结。右侧声带相对稍厚。\",\"sort_order\":null,\"sub_category\":\"颈椎椎间盘平扫，头颅平扫\"}],\"doctor\":\"\",\"hospital\":\"苏州工业园区星塘医院\",\"title\":\"放射科诊断报告书\"}","hospital":"苏州工业园区星塘医院","date_text":"2025-06-04"}]}}},"tool_call_id":"call_01_5B5NnFvX56Ki0xRSGXmU2155","parent_tool_call_id":"call_01_5B5NnFvX56Ki0xRSGXmU2155"}}]}
