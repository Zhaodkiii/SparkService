times\":[\"09:00\",\"21:00\"],\"sort_order\":\"2\",\"start_date\":\"2026-05-20\",\"status\":\"active\",\"strength\":\"6ml:3mg\",\"total_quantity\":null}","display_name":"盐酸氮卓斯汀滴眼液","is_saved":false,"specification":"6ml:3mg 滴眼液","dosage_line":"1滴 · 每日2次"}],"exam_reports":[],"prescriptions":[],"medical_cases":[]}}},"status":"ready","created_at":"2026-05-20T16:01:37.000Z","parent_block_id":"1992FD5B-49E6-53E0-90CD-96426B6F32C0","anchor":{"type":"toolCall","value":"call_01_evSftX2RP3j4fJWZLOkw5322"}}},{"thread_id":"9b08c1ff-7e22-4feb-b956-b8d340285632","client_message_id":"9e7d400f-a464-4308-a22b-a8ce0e048ea7","block":{"id":"59BB5D0C-FC65-5AFD-BCC6-021516F51BF2","kind":"structuredHealthCards","updated_at":"2026-05-20T16:09:45.000Z","revision":1779293385730160,"order_key":2100,"tool_call_id":"call_00_2ImRz3pKkQHpQiOdBXr97261","parent_tool_call_id":"call_00_2ImRz3pKkQHpQiOdBXr97261","node_role":"toolPresentation","payload":{"structured_health_cards":{"_0":{"prescriptions":[],"exam_reports":[],"medications":[],"medical_cases":[{"title":"就诊病例","diagnosis_line":"前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎","id":"659A4DEA-C99A-4A6E-8159-8DB308BD2D5B","is_saved":false,"draft_json":"{\"age_at_visit\":\"26\",\"attachment_file_ids\":[],\"diagnosis\":\"前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎\",\"examination_reports\":[{\"attachment_file_ids\":[],\"category\":\"imaging\",\"content\":\"头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4\\/5、C5\\/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。\",\"date\":\"2025-06-04\",\"details\":[{\"attachment_file_ids\":[],\"body_part\":\"头颈部\",\"category\":\"放射科\",\"diagnosis\":\"头颅CT平扫未见明显异常；C4\\/5、C5\\/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚\",\"item_name\":\"颈椎椎间盘平扫，头颅平扫\",\"result_value\":\"1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带