INFO 2026-05-21 01:07:16,281 accounts.api_io [request_id=C2666453-4B87-4E50-822E-243B480FDA08] HTTP 请求进入: POST /api/v1/ai/chat/sync/push/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MzI2MzcxLCJpYXQiOjE3NzkzMjQ1NzEsImp0aSI6ImFjZTBmMzg3N2ZjODQ1ODViYmVhMzAwOTU1ZmZhOThmIiwidXNlcl9pZCI6IjQifQ.1jqyGgJby20HUiZADJr7UHNb2nLjPwEHIb6YaZlAkdg", "X-Request-Id": "C2666453-4B87-4E50-822E-243B480FDA08", "Content-Length": "1568"} body={"messages": [{"thread_id": "56E9EC61-8341-4974-B32B-472E5FC537C9", "delivery_state": "pending", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_max_tokens": 14096, "created_at": "2026-05-21T01:07:08.294Z", "thread_top_p": 1, "client_message_id": "9FD89D8A-0F48-4D74-B6E2-A5449DB3D2FC", "role": "assistant", "thread_temperature": 0.6, "thread_max_messages": 20, "thread_current_model_name": "deepseek-v4-pro", "model_name": "deepseek-v4-pro", "blocks": [{"order_key": 1000, "revision": 1779325635483972, "payload": {"text": {"_0": "你好！我是你的高级健康助手，很高兴为你服务。\n\n我可以帮你做这些事情：\n\n- **健康档案管理**：帮你整理体检报告、检查单、处方单等，生成结构化的健康卡片，方便随时查看。\n- **用药提醒**：根据你的用药情况，帮你创建服药提醒任务。\n- **健康知识整理**：把你关心的健康知识、医生建议等整理成文档，保存到知识库。\n- **任务管理**：帮你规划复诊、体检、锻炼等健康相关任务。\n\n有什么我可以帮你的吗？比如你可以上传一份体检报告让我帮你解读，或者告诉我你正在服用什么药物，我来帮你建立用药提醒。"}}, "id": "79692B68-DAA0-56BA-8079-BE264015B8AF", "created_at": "2026-05-21T01:07:15.000Z", "kind": "text", "updated_at": "2026-05-21T01:07:15.000Z", "status": "ready", "node_role": "timeline"}], "tombstone": false, "server_updated_at": "2026-05-21T01:07:15.485Z"}]}
INFO 2026-05-21 01:07:16,303 chat_sync.sync [request_id=C2666453-4B87-4E50-822E-243B480FDA08] chat push payload request_id=C2666453-4B87-4E50-822E-243B480FDA08 user_id=4 content_type=application/json body={"messages":[{"thread_id":"56e9ec61-8341-4974-b32b-472e5fc537c9","role":"assistant","model_name":"deepseek-v4-pro","client_message_id":"9fd89d8a-0f48-4d74-b6e2-a5449db3d2fc","delivery_state":"pending","created_at":"2026-05-21 01:07:08.294000+00:00","server_updated_at":"2026-05-21 01:07:15.485000+00:00","tombstone":false,"thread_current_model_name":"deepseek-v4-pro","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":14096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}","blocks":[{"order_key":1000,"revision":1779325635483972,"payload":{"text":{"_0":"你好！我是你的高级健康助手，很高兴为你服务。\n\n我可以帮你做这些事情：\n\n- **健康档案管理**：帮你整理体检报告、检查单、处方单等，生成结构化的健康卡片，方便随时查看。\n- **用药提醒**：根据你的用药情况，帮你创建服药提醒任务。\n- **健康知识整理**：把你关心的健康知识、医生建议等整理成文档，保存到知识库。\n- **任务管理**：帮你规划复诊、体检、锻炼等健康相关任务。\n\n有什么我可以帮你的吗？比如你可以上传一份体检报告让我帮你解读，或者告诉我你正在服用什么药物，我来帮你建立用药提醒。"}},"id":"79692B68-DAA0-56BA-8079-BE264015B8AF","created_at":"2026-05-21T01:07:15.000Z","kind":"text","updated_at":"2026-05-21T01:07:15.000Z","status":"ready","node_role":"timeline"}]}],"block_updates":[]}
