D-51E5-57FA-8A06-DF6B0CD8DFDE","revision":1779367010701506},{"node_role":"toolPresentation","status":"pending","updated_at":"2026-05-21T12:36:45.491Z","anchor":{"type":"toolCall","value":"call_01_5B5NnFvX56Ki0xRSGXmU2155"},"payload":{"structured_health_cards":{"_0":{}}},"created_at":"2026-05-21T12:36:45.491Z","parent_block_id":"566946CD-51E5-57FA-8A06-DF6B0CD8DFDE","tool_call_id":"call_01_5B5NnFvX56Ki0xRSGXmU2155","id":"0B00D813-E3FF-521A-9D7C-A7135295D253","revision":1779367005491018,"order_key":4100,"parent_tool_call_id":"call_01_5B5NnFvX56Ki0xRSGXmU2155"},{"node_role":"tool","status":"ready","updated_at":"2026-05-21T12:36:50.753Z","payload":{"tool":{"_0":{"invocation_arguments":{"oss_file_id":"570","report_type":"medical_case","raw_text":"门（急）诊病历\n姓名：赵道凯，性别：男，出生日期：1998-10-29\n医院：苏州大学附属第四医院（苏州市独墅湖医院）\n就诊科室：神经内科门诊，初诊\n就诊时间：2025-08-02 08:34\n主诉：反复头晕2月\n现病史：患者反复出现头晕，伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时，后自行缓解，无肢体活动障碍，无行走不稳，社区医院头颅CT未见明显异常。现无明显不适。\n既往史：慢性疾病史否认。\n诊断：前庭性眩晕 H81.300x002\n处理措施：甲磺酸倍他司汀片（敏使朗），每次6mg，口服，每天3次"},"name":"generate_structured_health_card","content":"【系统】结构化保存卡片正在后台生成中。请直接根据用户消息或对话中的相关原文进行专业解读，无需等待卡片即可继续回答；卡片生成后将显示在本条助手回复下方。若再次调用 generate_structured_health_card：raw_text 必须是你提炼后的医学要点，可选 oss_file_id 与消息中的 oss_file_id 一致，勿把完整 OCR 传给工具。"}}},"created_at":"2026-05-21T12:36:50.630Z","order_key":6000,"tool_call_id":"call_02_JuyaGuBObw6OC0m6i3Hh1748","id":"53565177-6C73-53CD-A611-8DFA41B4D07B","revision":1779367010752870},{"tool_call_id":"call_02_JuyaGuBObw6OC0m6i3Hh1748","parent_block_id":"53565177-6C73-53CD-A611-8DFA41B4D07B","anchor":{"type":"toolCall","value":"call_02_JuyaGuBObw6OC0m6i3Hh1748"},"node_role":"toolPresentation","order_key":6100,"status":"failed","parent_tool_call_id":"call_02_JuyaGuBObw6OC0m6i3Hh1748","created_at":"2026-05-21T12:36:50.492Z","updated_at":"2026-05-21T12:36:50.492Z","revision":1779367010491990,"payload":{"structured_health_cards":{"_0":{"extraction_failed":true,"failure_message":"结构化健康卡片生成失败，请稍后重试或补充更完整的病历摘要。"}}},"id":"ABE0FE74-E941-5DB