INFO 2026-05-21 08:18:23,067 chat_sync.sync [request_id=BA91B90B-E39C-444A-8137-596974A9A2BE] chat push payload request_id=BA91B90B-E39C-444A-8137-596974A9A2BE user_id=4 content_type=application/json body={"messages":[{"thread_id":"4901d3af-5745-4d8a-8fe8-6607fc5c3afb","role":"user","model_name":"user","client_message_id":"be30cfc0-cc21-4a20-a323-e2426eebd91f","delivery_state":"sending","created_at":"2026-05-21 08:18:22.391000+00:00","tombstone":false,"thread_current_model_name":"deepseek-v4-pro","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":14096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}","blocks":[{"kind":"text","created_at":"2026-05-21T08:18:22.390Z","payload":{"text":{"_0":"结构化数据"}},"updated_at":"2026-05-21T08:18:22.390Z","status":"ready","revision":1,"node_role":"timeline","id":"46BF5E08-E352-4D81-A48D-7CD939F8DD9B"},{"kind":"imageGallery","created_at":"2026-05-21T08:18:22.390Z","payload":{"image_gallery":{"_0":[{"file_id":550,"full_cache_key":"1575b856-1ce1-4346-8491-32871f5c1c6f/IMG_1247.png","type":"image","text":"苏州大学附属第四医院\n苏州市独墅湖医院\n胃镜诊断报告单\n姓名：赵道凯\n性别：男\n年龄：28 岁\n申请科室：消化内科门诊\n门诊号：0000349056\n住院号：\n床号：\n病区：\n检查项目：无痛电子胃镜（不含林醉费）\n申请单号：260821105\n①食管\n②齿状线\n③胃底\n①胃体\n⑤胃角\n6胃窦\n⑦十二指肠球部\n⑧十二指肠降部\n内镜所见：\n食管：通过顺利，黏膜大致正常；\n贵门：开合佳通畅；\n胃底：黏膜正常；\n胃体：见胆汁残留；\n胃角：光整；\n胃窦：黏膜红白相间，以红为主；\n幽门：圆，开放好；\n十二指肠球部及所见降部：未见明显异常。\n诊断：\n慢性非菱缩性胃炎伴胆汁反流\n活检部位：\n建议：\n报告医生：健\n审核医师：F26\n报告时间：2026-02-10\n备注：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告！","url":"https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/1575B856-1CE1-4346-8491-32871F5C1C6F/IMG_1247.png","id":"94EDA19D-F45B-41F9-8F6C-1F146049FE8D","file_md5":"b549c88052b52d02e02867117b763749"}]}},"updated_at":"2026-05-21T08:18:22.390Z","status":"ready","revision":1,"node_role":"timeline","id":"E50E73C0-4792-4445-861C-1CE94431364A"}]}],"block_updates":[]}
