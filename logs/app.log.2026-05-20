INFO 2026-05-21 11:23:31,138 chat_sync.sync [request_id=167B46D2-BA28-40E0-8ACF-0A6C8F86A626] chat push payload request_id=167B46D2-BA28-40E0-8ACF-0A6C8F86A626 user_id=5 content_type=application/json body={"messages":[],"block_updates":[{"thread_id":"c716aff2-6891-4fe7-95d4-ee7649898bf3","client_message_id":"86e229b2-038a-451f-ada4-142f6df18bb3","block":{"anchor":{"type":"toolCall","value":"call_oof0z3yi6a7xps5n1bz4z89l"},"parent_tool_call_id":"call_oof0z3yi6a7xps5n1bz4z89l","status":"ready","kind":"structuredHealthCards","node_role":"toolPresentation","tool_call_id":"call_oof0z3yi6a7xps5n1bz4z89l","parent_block_id":"2C3445B8-172F-5025-A03A-12FA65653320","payload":{"structured_health_cards":{"_0":{"exam_reports":[{"draft_json":"{\"attachment_file_ids\":[],\"category\":\"imaging\",\"content\":\"本周（2026-05-14至2026-05-20）健康数据总结：步数总步数63476步，总距离41.67公里；能量消耗总静息能量10386.3千卡，活动能量4593.5千卡；睡眠数据覆盖5月17日、18日、19日；运动2次羽毛球运动，总时长4小时31分钟，总距离4.09公里，总活动能量2357千卡。\",\"date\":\"2026-05-20\",\"details\":[{\"attachment_file_ids\":[],\"category\":\"影像学检查\",\"diagnosis\":\"本周亮点：步数总量达标，两次高强度羽毛球运动提升活动能量消耗；风险项：睡眠数据仅覆盖3天，睡眠时长不足7小时，营养摄入无记录；最需改善：补充营养摄入，增加睡眠监测，确保每日睡眠时长；下周建议：保持运动频率，每日记录营养摄入，监测完整睡眠周期。\",\"result_value\":\"步数：总步数63476步，总距离41.67公里；能量消耗：总静息能量10386.3千卡，活动能量4593.5千卡；睡眠：5月17日总睡眠4小时37分钟，深度睡眠32分钟；5月18日总睡眠6小时38分钟，深度睡眠51分钟；5月19日总睡眠5小时51分钟，深度睡眠54分钟，REM睡眠占比27.5%；营养：无摄入记录；运动：2次羽毛球运动，总时长4小时31分钟，总距离4.09公里，总活动能量2357千卡。\",\"sort_order\":null,\"sub_category\":\"健康监测\"}],\"title\":\"健康数据总结\"}","date_text":"2026-05-20","is_saved":true,"member_id":19,"id":"8BFEA6C3-EEF3-4AA4-8AF7-91CB3C3723C7","title":"健康数据总结"}]}}},"revision":1779362362404709,"id":"E025F2E4-F5B0-5C53-8601-84B9D1D14755","updated_at":"2026-05-21T11:23:30.584Z","order_key":12100,"created_at":"2026-05-21T11:19:22.393Z"}}]}
