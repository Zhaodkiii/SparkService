ame": "伊曲康唑分散片"}], "batch_no": "1681884"}, {"prescribed_at": "2025-06-04", "institution_name": "苏州工业园区星塘医院", "diagnosis": "眩晕", "prescriber_name": "谢雪园", "medications": [{"dose_per_time": "8.000mg", "brand_name": "乐普恒久远", "generic_name": "盐酸倍他司汀片", "route": "口服", "instructions": "8.000mg Tid 口服", "strength": "4mg*10片", "frequency_text": "每天3次"}, {"strength": "4g*15袋", "route": "口服", "frequency_text": "每天3次", "instructions": "4.000g Tid 口服", "dose_per_time": "4.000g", "generic_name": "养血清脑颗粒"}]}], "follow_up": {"method": "门诊随访", "next_action": "病情加重及时到上级医院进一步诊治"}, "member": {"id": 33}, "examination_reports": [{"performed_at": "2025-06-04", "category": "imaging", "organization_name": "苏州工业园区星塘医院", "item_name": "CT检查（颈椎椎间盘平扫）", "details": [{"category": "影像", "result_value": "头颅CT平扫未见明显异常，鼻咽顶后壁软组织增厚，C1/5、C5/6椎间盘轻微突出，颈椎失稳，两侧颈部、颌下区多发小淋巴结，右侧声带相对稍厚", "modality": "CT", "item_name": "颈椎椎间盘平扫CT", "body_part": "颈椎、头颅"}], "doctor_name": "谢雪园", "findings": "1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C1/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。"}], "source_file_ids": []}
