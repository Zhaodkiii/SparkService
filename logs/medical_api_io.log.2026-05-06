cations": [], "attachments": []}, {"id": 71, "member": 34, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"source": "typed_upload"}, "created_at": "2026-05-06T09:51:44.893084Z", "updated_at": "2026-05-06T09:51:44.893111Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 70, "member": 34, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年02月06日于苏州大学附属第四医院口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史无慢性疾病史，过敏史无，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙；患者芦超，28岁，2025年06月21日于苏州工业园区星塘医院妇产科（普通）就诊，诊断为念珠菌性外阴阴道炎，开具卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；念珠菌性外阴阴道炎", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-05-06T09:50:51.649781Z", "updated_at": "2026-05-06T09:50:51.649806Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 366, "file_uuid": "f7d04fad-b9cc-4409-be1b-e177822a4b7c", "original_name": "photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg", "file_size": 2823604, "mime_type": "image/jpeg", "file_md5": "d243f562f650c18c3a098284420ad83b", "business_type": "medical_case", "business_id": "70", "object_key": "SparkClient/20260506/F7D04FAD-B9CC-4409-BE1B-E177822A4B7C/photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg", "storage_type": "oss", "created_at": "2026-05-06T09:50:33.721313Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/F7D04FAD-B9CC-4409-BE1B-E177822A4B7C/photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg"}, {"id": 365, "file_uuid": "659772c1-7fa6-43d3-9fa3-933ca8aa09fc", "original_name": "photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg", "file_size": 3070076, "mime_type": "image/jpeg", "file_md5": "d470fcac1374ee0d2d3b7dc340ac61fc", "business_type": "medical_case", "business_id": "70", "object_key": "SparkClient/20260506/659772C1-7FA6-43D