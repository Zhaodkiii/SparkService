ications": [], "attachments": []}, {"id": 71, "member": 34, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"source": "typed_upload"}, "created_at": "2026-05-06T09:51:44.893084Z", "updated_at": "2026-05-06T09:51:44.893111Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 70, "member": 34, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年02月06日于苏州大学附属第四医院口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史无慢性疾病史，过敏史无，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙；患者芦超，28岁，2025年06月21日于苏州工业园区星塘医院妇产科（普通）就诊，诊断为念珠菌性外阴阴道炎，开具卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；念珠菌性外阴阴道炎", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-05-06T09:50:51.649781Z", "updated_at": "2026-05-06T09:50:51.649806Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 366, "file_uuid": "f7d04fad-b9cc-4409-be1b-e177822a4b7c", "original_name": "photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg", "file_size": 2823604, "mime_type": "image/jpeg", "file_md5": "d243f562f650c18c3a098284420ad83b", "business_type": "medical_case", "business_id": "70", "object_key": "SparkClient/20260506/F7D04FAD-B9CC-4409-BE1B-E177822A4B7C/photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg", "storage_type": "oss", "created_at": "2026-05-06T09:50:33.721313Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/F7D04FAD-B9CC-4409-BE1B-E177822A4B7C/photo_0DB633D2-EF4F-446C-95AC-7586D126D846.jpg"}, {"id": 365, "file_uuid": "659772c1-7fa6-43d3-9fa3-933ca8aa09fc", "original_name": "photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg", "file_size": 3070076, "mime_type": "image/jpeg", "file_md5": "d470fcac1374ee0d2d3b7dc340ac61fc", "business_type": "medical_case", "business_id": "70", "object_key": "SparkClient/20260506/659772C1-7FA6-43D3-9FA3-933CA8AA09FC/photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg", "storage_type": "oss", "created_at": "2026-05-06T09:50:33.208234Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/659772C1-7FA6-43D3-9FA3-933CA8AA09FC/photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg"}]}], "health_exam_reports": [{"id": 13, "user": 12, "member": 34, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）是甲状腺细胞在局部异常生长所致，多系甲状腺良性疾病的表现，少数可为恶性改变。TI-RADS 2类提示甲状腺良性改变，建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:(108/57mmHg) 本次检查您的血压偏低。建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分 可见于健康的成人和运动量较大的人群，也可见于器质性心脏病、甲状腺功能减退、减慢心率的药物等。无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏 建议您年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶 多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合后钙盐沉着，也可为肝内胆管壁部分钙化。建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数 24.1 kg/m²) 热量摄入多于消耗所致，多与生活方式不当相关。建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高:24.7umol/L(参考区间:≤23) 血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80) 除外体液浓缩因素影响，建议您不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:0.29%(参考区间:0.10-0.28) 建议您结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准(裸眼视力-左眼 0.8 ) 右眼视力低于正常标准(裸眼视力-右眼 0.8 ) 增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-06T10:35:47.229813Z", "updated_at": "2026-05-06T10:35:47.229838Z", "attachments": [{"id": 369, "file_uuid": "d9ade67a-73e7-433d-ad88-b20209e24a6c", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "13", "object_key": "SparkClient/20260506/D9ADE67A-73E7-433D-AD88-B20209E24A6C/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-06T10:35:28.948916Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/D9ADE67A-73E7-433D-AD88-B20209E24A6C/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [], "prescription_batches": [{"id": 53, "user": 12, "member": 34, "medical_case": 70, "prescriber_name": "", "institution_name": "苏州工业园区星塘医院", "prescribed_at": "2025-06-21T00:00:00Z", "diagnosis": "念珠菌性外阴阴道炎", "batch_no": "1681884", "status": "active", "auditor_name": "", "audited_at": null, "extra": {}, "created_at": "2026-05-06T09:50:51.674615Z", "updated_at": "2026-05-06T09:50:51.674631Z", "medications": [{"id": 108, "user": 12, "member": 34, "batch": 53, "generic_name": "伊曲康唑分散片", "brand_name": "", "drug_name": "伊曲康唑分散片", "dosage_form": "分散片", "strength": "0.1g*14片", "route": "口服", "dose_per_time": "2片/次", "dose_value": null, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 1, "frequency_text": "每天1次", "duration_days": null, "instructions": "", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-05-06T09:50:51.690750Z", "updated_at": "2026-05-06T09:50:51.690765Z"}, {"id": 107, "user": 12, "member": 34, "batch": 53, "generic_name": "克霉唑阴道膨胀栓", "brand_name": "", "drug_name": "克霉唑阴道膨胀栓", "dosage_form": "阴道膨胀栓", "strength": "0.15g*4粒", "route": "阴塞", "dose_per_time": "1粒/次", "dose_value": null, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 1, "frequency_text": "每天1次", "duration_days": null, "instructions": "", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-05-06T09:50:51.685874Z", "updated_at": "2026-05-06T09:50:51.685895Z"}, {"id": 106, "user": 12, "member": 34, "batch": 53, "generic_name": "卢立康唑乳膏", "brand_name": "路利特", "drug_name": "卢立康唑乳膏", "dosage_form": "乳膏", "strength": "5g:50mg（1%）", "route": "外用", "dose_per_time": "1g/次", "dose_value": null, "dose_unit": "", "frequency_code": "", "period": "天", "times_per_period": 2, "frequency_text": "每天2次", "duration_days": null, "instructions": "", "reminder_enabled": true, "reminder_times": [], "sort_order": 0, "extra": {}, "created_at": "2026-05