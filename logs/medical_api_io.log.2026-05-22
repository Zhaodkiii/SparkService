INFO 2026-05-22 08:38:44,144 medical.api_io [request_id=FF6F12A6-A868-4BEA-91CE-FA9A4B8F4572] HTTP 响应摘要: GET /api/v1/medical/members/19/complete-data/ status=200 duration_ms=46 bytes=9036 headers={"Content-Type": "application/json", "ETag": "\"ae9dfe747587238c1d5c378e8e03d2f1\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 19, "member": {"id": 19, "user": 5, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "1999-05-21", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-21T10:56:31.523140Z", "updated_at": "2026-05-21T10:56:31.523176Z"}, "medical_cases": [{"id": 37, "member": 19, "record_type": "outpatient", "status": 1, "title": "哈哈", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"visit_date": "2026-05-21"}, "created_at": "2026-05-21T12:38:12.847773Z", "updated_at": "2026-05-21T12:38:12.847796Z", "symptoms": [], "medications": [], "attachments": []}], "health_exam_reports": [{"id": 4, "user": 5, "member": 19, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）：建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分：无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏：建议年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶：建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数24.1kg/m²)：建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高、血清直接胆红素测定（结合胆红素）增高：建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:建议结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准、右眼视力低于正常标准：增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:19:09.820253Z", "updated_at": "2026-05-21T16:19:09.820274Z", "attachments": [{"id": 580, "file_uuid": "fd1a01fb-5305-4fcd-a593-50cb7a1cab43", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "4", "object_key": "SparkClient/20260521/FD1A01FB-5305-4FCD-A593-50CB7A1CAB43/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-21T16:16:50.866629Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/FD1A01FB-5305-4FCD-A593-50CB7A1CAB43/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}, {"id": 5, "user": 5, "member": 19, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": "1. 窦性心动过缓(54次/分)：无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗，建议正规医院专科诊治。2. 甲状腺双叶囊肿（多发）：建议专科治疗。3. 中性粒细胞百分数降低：建议及时复查，如果仍然异常，请尽早去医院，查明原因。4. 淋巴细胞百分数增高：建议复查，如果仍然异常，请尽早去医院，查明原因。5. 血小板压积增高：建议复查，如果仍然异常，请去医院，查明原因。6. 血小板计数增高：建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:20:40.666081Z", "updated_at": "2026-05-21T16:20:40.666106Z", "attachments": [{"id": 581, "file_uuid": "13c69e6f-f352-455c-a4ce-6cb107d36429", "original_name": "体检报告_1.pdf", "file_size": 306375, "mime_type": "application/pdf", "file_md5": "99149b61a9dbc15919c3d5a912da893b", "business_type": "health_exam_report", "business_id": "5", "object_key": "SparkClient/20260521/13C69E6F-F352-455C-A4CE-6CB107D36429/体检报告_1.pdf", "storage_type": "oss", "created_at": "2026-05-21T16:20:11.432102Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/13C69E6F-F352-455C-A4CE-6CB107D36429/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A_1.pdf"}]}], "examination_reports": [{"id": 108, "user": 5, "member": 19, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": 