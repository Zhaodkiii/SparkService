00:00.000Z", "sort_order": 17}, {"modality": "", "item_name": "肌酸激酶（CK）", "sub_category": "", "body_part": "", "reference_range": "", "flag": "", "item_code": "", "unit": "", "diagnosis": "阴性", "extra": {}, "category": "生化检验", "result_value": "104.3U/L", "result_at": "2025-12-27T16:00:00.000Z", "sort_order": 18}, {"modality": "", "item_name": "乳酸脱氢酶（LDH）", "sub_category": "", "body_part": "", "reference_range": "", "flag": "", "item_code": "", "unit": "", "diagnosis": "阴性", "extra": {}, "category": "生化检验", "result_value": "168.0U/L", "result_at": "2025-12-27T16:00:00.000Z", "sort_order": 19}, {"modality": "", "item_name": "α-羟丁酸脱氢酶（HBDH）", "sub_category": "", "body_part": "", "reference_range": "", "flag": "", "item_code": "", "unit": "", "diagnosis": "阴性", "extra": {}, "category": "生化检验", "result_value": "140.4U/L", "result_at": "2025-12-27T16:00:00.000Z", "sort_order": 20}, {"modality": "", "item_name": "胆碱酯酶（CHE）", "sub_category": "", "body_part": "", "reference_range": "", "flag": "", "item_code": "", "unit": "", "diagnosis": "阴性", "extra": {}, "category": "生化检验", "result_value": "11124U/L", "result_at": "2025-12-27T16:00:00.000Z", "sort_order": 21}, {"modality": "", "item_name": "甘油三酯（TG）", "sub_category": "", "body_part": "", "reference_range": "", "flag": "", "item_code": "", "unit": "", "diagnosis": "阴性", "extra": {}, "category": "生化检验", "result_value": "0.70mmol/L", "result_at": "2025-12-27T16:00:00.000Z", "sort_order": 22}, {"item_name": "总胆固醇（TC）", "result_at": "2025-12-27T16:00:00.000Z", "result_value": "5.07mmol/L", "extra": {}, "modality": "", "body_part": "", "item_code": "", "sub_category": "", "sort_order": 23, "reference_range": "", "unit": "", "category": "生化检验", "diagnosis": "阴性", "flag": ""}, {"item_name": "高密度脂蛋白胆固醇（HDL-C）", "result_at": "2025-12-27T16:00:00.000Z", "result_value": "1.51mmol/L", "extra": {}, "modality": "", "body_part": "", "item_code": "", "sub_category": "", "sort_order": 24, "reference_range": "", "unit": "", "category": "生化检验", "diagnosis": "阴性", "flag": ""}], "reported_at": "2025-12-27T16:00:00.000Z", "doctor_name": "口腔科门诊", "department_name": "", "findings": "临床印象：口腔黏膜溃疡。检验结果：1. 异常指标：天门冬氨酸氨基转移酶（AST）9.3U/L，参考区间15-40U/L，结果降低；低密度脂蛋白胆固醇（LDL-C）3.51mmol/L，健康人群适宜参考区间<3.40mmol/L，结果轻度升高。2. 正常指标：总胆红素13.5μmol/L、直接胆红素4.2μmol/L、间接胆红素9.3μmol/L、丙氨酸氨基转移酶（ALT）14.6U/L、总蛋白77.0g/L、白蛋白47.4g/L、球蛋白29.6g/L、白蛋白/球蛋白1.6、γ-谷氨酰转肽酶（GGT）19.9U/L、碱性磷酸酶（ALP）75.9U/L、前白蛋白287.0mg/L；尿素5.14mmol/L、肌酐77.50μmol/L、尿酸324.6μmol/L、胱抑素C 0.76mg/L；空腹葡萄糖5.42mmol/L、肌酸激酶（CK）104.3U/L、乳酸脱氢酶（LDH）168.0U/L、α-羟丁酸脱氢酶（HBDH）140.4U/L、胆碱酯酶（CHE）11124U/L、甘油三酯（TG）0.70mmol/L、总胆固醇（TC）5.07mmol/L、高密度脂蛋白胆固醇（HDL-C）1.51mmol/L。", "impression": "临床印象：口腔黏膜溃疡。检验结果：1. 异常指标：天门冬氨酸氨基转移酶（AST）9.3U/L，参考区间15-40U/L，结果降低；低密度脂蛋白胆固醇（LDL-C）3.51mmol/L，健康人群适宜参考区间<3.40mmol/L，结果轻度升高。2. 正常指标：总胆红素13.5μmol/L、直接胆红素4.2μmol/L、间接胆红素9.3μmol/L、丙氨酸氨基转移酶（ALT）14.6U/L、总蛋白77.0g/L、白蛋白47.4g/L、球蛋白29.6g/L、白蛋白/球蛋白1.6、γ-谷氨酰转肽酶（GGT）19.9U/L、碱性磷酸酶（ALP）75.9U/L、前白蛋白287.0mg/L；尿素5.14mmol/L、肌酐77.50μmol/L、尿酸324.6μmol/L、胱抑素C 0.76mg/L；空腹葡萄糖5.42mmol/L、肌酸激酶（CK）104.3U/L、乳酸脱氢酶（LDH）168.0U/L、α-羟丁酸脱氢酶（HBDH）140.4U/L、胆碱酯酶（CHE）11124U/L、甘油三酯（TG）0.70mmol/L、总胆固醇（TC）5.07mmol/L、高密度脂蛋白胆固醇（HDL-C）1.51mmol/L。", "item_name": "生化检验、肾功能检", "category": "laboratory"}
