:40.705708Z"}, {"id": 877, "business_type": "health_exam_report", "business_id": 5, "member": 19, "category": "实验室检查", "sub_category": "", "item_name": "血清总胆固醇", "item_code": "TC", "result_value": "4.81", "unit": "mmol/L", "reference_range": "2.33-5.70mmol/L", "flag": "", "result_at": "2023-01-07T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:20:40.702977Z", "updated_at": "2026-05-21T16:20:40.702985Z"}, {"id": 876, "business_type": "health_exam_report", "business_id": 5, "member": 19, "category": "实验室检查", "sub_category": "", "item_name": "空腹血糖", "item_code": "GLU", "result_value": "4.76", "unit": "mmol/L", "reference_range": "3.9-6.1mmol/L", "flag": "", "result_at": "2023-01-07T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:20:40.700110Z", "updated_at": "2026-05-21T16:20:40.700120Z"}, {"id": 875, "business_type": "health_exam_report", "business_id": 5, "member": 19, "category": "一般检查", "sub_category": "", "item_name": "舒张压", "item_code": "", "result_value": "68", "unit": "mmHg", "reference_range": "60-89mmHg", "flag": "", "result_at": "2023-01-07T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:20:40.696759Z", "updated_at": "2026-05-21T16:20:40.696769Z"}, {"id": 874, "business_type": "health_exam_report", "business_id": 5, "member": 19, "category": "一般检查", "sub_category": "", "item_name": "收缩压", "item_code": "", "result_value": "115", "unit": "mmHg", "reference_range": "90-139mmHg", "flag": "", "result_at": "2023-01-07T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:20:40.694045Z", "updated_at": "2026-05-21T16:20:40.694053Z"}, {"id": 873, "business_type": "health_exam_report", "business_id": 5, "member": 19, "category": "一般检查", "sub_category": "", "item_name": "体重指数", "item_code": "", "result_value": "22.2", "unit": "", "reference_range": "18.5-23.9", "flag": "", "result_at": "2023-01-07T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:20:40.691650Z", "updated_at": "2026-05-21T16:20:40.691659Z"}]}
INFO 2026-05-22 02:16:43,413 medical.api_io [request_id=94A8A394-C064-4036-BD1B-E0750D26FD6E] HTTP 请求进入: GET /api/v1/medical/resources/ headers={"Host": "172.20.10.2:8000", "Accept-Encoding": "gzip, deflate", "Connection": "keep-alive", "Accept": "*/*", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5NDE2NTY1LCJpYXQiOjE3Nzk0MTQ3NjUsImp0aSI6ImE0NzIwNjQ2NGVmYzQwMTBhODczYTFlNjUwMjZjZWMxIiwidXNlcl9pZCI6IjUifQ.IdG7-ggzOgnOCkGBx6bBV4XTsUcLiCdZvdYWlOciInc", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "X-Request-Id": "94A8A394-C064-4036-BD1B-E0750D26FD6E"} body=
INFO 2026-05-22 02:16:43,434 medical.api_io [request_id=94A8A394-C064-4036-BD1B-E0750D26FD6E] HTTP 响应摘要: GET /api/v1/medical/resources/ status=200 duration_ms=21 bytes=41050 headers={"Content-Type": "application/json", "ETag": "\"5313bef47000b326ffb14a5835455a24\"", "Cache-Control": "private, max-age=120", "Vary": "Accept", "Allow": "GET, POST, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": [{"id": 4, "user": 5, "member": 19, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）：建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分：无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏：建议年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶：建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数24.1kg/m²)：建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高、血清直接胆红素测定（结合胆红素）增高：建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:建议结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准、右眼视力低于正常标准：增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "raw_ocr": {"text": "=== File 1: 体检报告.pdf ===\n检查机构：苏州相城美年大健康体检中心\n赵道凯 先生\n年 龄: 153*****6020\n26岁\n联系电话:\n证件号码: 员 工 号:\n341******501X\n单位名称:\n安逸禾健康管理咨询（上海）有限公司\n部 门:\n条 码:\n体检套餐:\n25安逸禾-健康体检-男\n咨询电话:\n0512-62759366\n个人自取\n检查日期:\n报告方式: 2025-05-17\n查 询 报 告 网 址:\nhttps://www.health-100.cn/\n微信公众号 官网 微信小程序\n健康体检报告导读\n尊敬的 赵道凯 先生\n您好！\n感谢您对苏州相城美年大健康体检中心的信赖和支持，在此我们真诚地将您的健康体检报告呈上，敬请阅读。\n您的健康体检报告由七个部分组成：\n第一部分 健康体检自测问卷：您的个人信息是体检报告的重要组成部分，它从您的生活方式和环境、心理健康与精\n神压力、睡眠健康等方面进行多方了解，是分析您所处健康状态的重要基础信息。\n第二部分 报告阅读说明：根据您本次体检中发现的异常结果为依据，通过健康警示灯图，在相应人体结构所在部位\n进行提示，使您能够更直观、更快捷地了解异常体征部位。\n第三部分 主检报告：初审医师对您体检中发现的异常结果进行汇总分析，并初步提出医学建议。主检专家全面审核\n各科室报告及初审医师报告，对疑难问题进行专家会诊，确保内容的准确性、权威性，最终由主检专家签发您的健康\n体检报告。\n第四部分 医学科普：对本次体检发现的异常结果进行医学名词知识科普。\n第五部分 分项报告：各科室检查结果明细，细致认真地对您的体检情况进行详细汇报，可作为您专科诊断或复查的\n参考资料。同时附有相关科室检查图文报告，如心电图、超声报告、骨密度报告、经颅多普勒报告等。\n第六部分 常见体检数据对比：展示您最近两次体检中常见指标的数据变化趋势。\n第七部分 免责声明：鉴于医学科学的复杂性、现代医疗技术手段对疾病的筛查仍具有局限性和时效性，同时也受限\n于您本次所选择的体检项目，体检后可能存在未发现的潜在问题，如果有疑问或疾病症状出现，请立即就医。\n健康体检问卷\n您是否吸烟?\n否 偶尔 是\n您是否饮酒?\n否 偶尔 是\n您的饮食习惯符合以下哪项?\n荤素均衡且较清淡 荤食为主 素食为主 多盐、多油、多糖、辛辣为主\n您是否有以下疾病?\n无 高血压 冠心病 心梗 脑卒中 糖尿病 高血脂\n高尿酸 肺结节 阻塞性肺疾病 慢支/肺气肿 肺结核 乳腺结节\n桥本氏甲状腺炎 甲状腺结节 胆囊结石 胆囊息肉 慢性肾病\n肾结石 肾囊肿 多囊肾 骨质疏松 脂肪肝 肝血管瘤\n肝囊肿 乙肝 丙肝 慢性肝炎/肝硬化 幽门螺杆菌感染 胃溃疡\n胃息肉 结肠息肉 肿瘤病史\n您是否有以下用药史或药物过敏史?\n无 长期服药史 药物过敏史\n您是否有以下家族史?\n无 高血压 冠心病 糖尿病 脑卒中 高尿酸/痛风 肺癌\n乳腺癌 甲状腺癌 胃癌 结直肠癌 乙肝 丙肝\n慢性肝炎/肝硬化 肝癌 其他\n您是否有手术史?\n无 有\n您是否有以下体内植入物?\n无 心脏起搏器 心脏支架 骨折内固定钢板/钢针 人工关节 义齿\n其他\n您平时睡眠情况如何?\n好 入睡困难 易醒 多梦 嗜睡 打鼾 呼吸睡眠暂停\n客户已确认问卷是本人填写，内容属实 日期：2025年05月17日\n报告阅读说明\n●\n报告阅读说明：本报告书仅对受检者本次所检结果负责；警示部位请您关注，\n示意图仅提供部分异常部位警示，仅供参考。\n健康警示灯\n头部\n甲状腺\n眼\n肝\n耳鼻喉 胆\n口腔 胰\n颈部 脾\n胸腔 肾\n心脏 胃肠\n颈椎/腰椎 输尿管/前列腺/膀胱\n其他部位 一般检查\n实验室检查\n主检报告\n初审医师： 终审医师：\n一般健康问题： 医师建议：\n1、甲状腺左叶囊肿（TI-RADS 2类） 是甲状腺细胞在局部异常生长所致，多系甲状腺良性疾病\n的表现，少数可为恶性改变。TI-RADS 2类提示甲状腺良\n性改变，建议6～12个月复查，甲状腺专科随诊。\n2、舒张压偏低:(108/57mmHg) 本次检查您的血压偏低。建议多饮水，加强运动，结合病\n史必要时复测血压。若出现头昏、头晕、胸闷等症状，请\n及时心内科就诊。\n3、窦性心动过缓伴不齐56次/分 可见于健康的成人和运动量较大的人群，也可见于器质性\n心脏病、甲状腺功能减退、减慢心率的药物等。无症状且\n心率减慢不显著者无需治疗，若心率低于50次/分应做24\n小时动态心电图或心内科就诊。\n4、心电轴左偏 建议您年度复查心电图和心脏超声，结合病史和症状心内\n科随诊。\n5、肝内钙化灶 多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合\n后钙盐沉着，也可为肝内胆管壁部分钙化。建议定期复查\n肝胆超声，伴有肝区不适等症状时请肝胆科随诊。\n6、超重(体重指数 24.1 kg/m²) 热量摄入多于消耗所致，多与生活方式不当相关。建议控\n制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果\n在膳食中的比重，逐渐增加规律的有氧运动，控制体重增\n长。\n7、血清总胆红素测定增高:24.7umol/L(参考区\n间:≤23)\n血清直接胆红素测定（结合胆红素）增高:7.\n1umol/L(参考区间:0.00-6.80)\n除外体液浓缩因素影响，建议您不要饮酒、低脂饮食后复\n查，仍高考虑肝胆疾病，消化内科就诊。\n8、血小板压积增高:0.29%(参考区间:0.10-0.28) 建议您结合病史和症状定期复查血常规，如有明显异常请\n内科就诊。\n9、左眼视力低于正常标准(裸眼视力-左眼 0.8 )\n右眼视力低于正常标准(裸眼视力-右眼 0.8 )\n增加户外活动时间，注意用眼卫生，减少视疲劳，定期检\n查视力和眼底，必要时眼科就诊。\n医学科普\n【 甲状腺左叶囊肿（TI-RADS 2类） 】\n较小的囊肿可无症状，囊肿逐渐增大可出现压迫症状。\n【 舒张压偏低:(108/57mmHg) 】\n正常状态下（或空腹时）成人血压低于90/60mmHg，即为低血压。急性低血压见于休克、心肌梗塞等严重疾病。慢性低血压\n常见于体质弱者，多无自觉症状，只在体检中偶然发现。低血压的典型症状是直立时血压下降，头晕、严重者可引起晕厥。\n【 窦性心动过缓伴不齐56次/分 】\n窦性心动过缓是指窦性心率低于60次/分，窦性心律不齐指窦房结不规则地发出激动所引起的心房及心室的节律改变。窦性心\n动过缓常见于青年人、运动员，某些疾病和药物也可以导致。\n一般无症状，但心率过慢时低于40次/分左右，会出现心肌供血\n不足的症状，胸闷、乏力、头晕等。严重者可发生阿氏综合征。\n【 心电轴左偏 】\n心电轴是心电图学的一个术语，简单的说，它指的是由心脏除极所产生的电向量的综合方式。正常心电轴位于－30度～+90\n度。+90度～+180度为右偏，\n－30度～－90度为左偏。影响心电轴方向的因素有：①体型 ②年龄 ③心脏在胸腔内的位置 ④心\n脏左右心室的重量比例 ⑤电冲动在心室内的传导通路即束支的功能状态。心电图诊断有心电轴左偏，应首先寻找其原因，特别\n注意有无心脏或其他胸部器官疾病，如冠心病、心肌病、心肌炎、某些先天性心脏病以及退行性病变等，而在慢性支气管炎伴\n肺气肿、肺心病的患者可出现假性心电轴左偏等。\n【 肝内钙化灶 】\n多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合后钙盐沉着，也可为肝内胆管壁部分钙化。\n【 超重(体重指数 24.1 kg/m²) 】\n中国标准：体重指数（BMI）24.0-27.9kg/㎡为体重超重，超重容易引起多种疾病，比如高血压、糖尿病、高血脂、动脉粥样\n硬化等。所以对超重应当限制饮食摄入，并增加运动量，使摄入的总热量，低于消耗的总热量，以控制体重。\n【 血小板压积增高:0.29%(参考区间:0.10-0.28) 】\n血小板压积(PCT)升高的原因可能是血小板平均体积升高，表示巨核细胞高度成熟，骨髓造血小板良好。\n一般感染、失血、溶\n血、肿瘤等都会使血小板升高。过高的话(排除其它血液病)为血小板增多症，必需查明原因(原发或继发)。血管收缩也会引起\nPCT升高。\n【 血清总胆红素测定增高:24.7umol/L(参考区间:≤23) 】\n1、判断有无黄疸、黄疸程度及演变过程，分为隐性黄疸或亚临床黄疸、轻度黄疸、中度黄疸和高度黄疸，在病程中检测可以\n判断疗效和指导治疗。2、根据黄疸程度推断黄疸病因，分为溶血性黄疸、肝细胞黄疸、不完全性梗阻性黄疸、完全性梗阻性\n黄疸。3、根据总胆红素，结合直接及间接胆红素增高程度判断黄疸类型：①总胆红素和直接胆红素、间接胆红素均增高，为\n肝细胞性黄疸，如急性黄疸型肝炎、重症肝炎、慢性活动性肝炎、中毒性肝炎等。②总胆红素和直接胆红素增高，见于阻塞性\n黄疸，如胆结石、胆道梗阻、肝癌、胰头癌等。③总胆红素和间接胆红素升高，见于溶血性黄疸，如血型不合的输血、溶血性\n疾病、恶性疟疾等。\n【 血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80) 】\n检查胆红素情况不仅能反映肝脏损害的程度，尤其对黄疸的鉴别具有重要意义。胆红素包括总胆红素，直接胆红素（又称结合\n胆红素）和间接胆红素。各种原因引起的肝内或肝外阻塞，胆汁排泄不畅如胆石症、胆道肿物等引起胆管阻塞性病变等均可出\n现直接胆红素增高。\n【 左眼视力低于正常标准(裸眼视力-左眼 0.8 ) 】\n外界所要注视的物体，若没有准确聚焦在视网膜上，则称为屈光不正。屈光不正主要包括近视、远视和散光等。老视（亦称老\n花）是因年龄增长而出现的生理性调节问题，不属于屈光不正，但生理性调节能力下降所造成的成像问题及其矫正原理同屈光\n不正。矫正或治疗屈光不正的方法目前主要有框架眼镜、角膜接触镜和屈光手术。\n【 右眼视力低于正常标准(裸眼视力-右眼 0.8 ) 】\n外界所要注视的物体，若没有准确聚焦在视网膜上，则称为屈光不正。屈光不正主要包括近视、远视和散光等。老视（亦称老\n花）是因年龄增长而出现的生理性调节问题，不属于屈光不正，但生理性调节能力下降所造成的成像问题及其矫正原理同屈光\n不正。矫正或治疗屈光不正的方法目前主要有框架眼镜、角膜接触镜和屈光手术。\n分项报告\n【一般检查】\n项目 结果 单位 参考范围\n身高 169.5 cm -\n体重 69.3 kg -\n体重指数 24.1 kg/m² 18.5~23.9\n理想体重 64.5 kg -\n收缩压 108 mmHg 90-139\n舒张压 57 mmHg 60-89\n脉搏 63 次/分 60~100\n小结\n体重指数:超重(24.1 kg/m²)\n血压:舒张压偏低(108/57 mmHg)\n检查者:\n【内科】\n项目 结果 单位 参考范围\n既往史 无- -\n家族史 无- -\n胸廓 未见明显异常- -\n心脏-心率 60 次/分 60~100\n心脏-杂音 未闻及- -\n心脏-心律 未闻及明显异常- -\n心脏-心音 未闻及明显异常- -\n心脏-心界 未见明显异常- -\n肺-呼吸频率 16 次/分 12~20\n肺-啰音 未闻及- -\n肺-呼吸音 未闻及明显异常- -\n肺-胸膜摩擦音 未闻及- -\n肝-大小 未触及- -\n肝-质地 未触及明显异常- -\n肝-压痛 无压痛- -\n胆-大小 未触及- -\n胆-压痛 无压痛- -\n脾-大小 未触及- -\n脾-质地 未触及明显异常- -\n脾-压痛 无压痛- -\n肾-叩击痛 无叩击痛- -\n腹壁 未见明显异常- -\n膝反射 未见明显异常- -\n其他 未见明显异常- -\n小结\n未见明显异常\n医师:\n【外科】\n项目 结果\n既往史 无\n皮肤 未见明显异常\n浅表淋巴结 未触及明显异常\n甲状腺 未见明显异常\n乳房 未见明显异常\n脊柱 未见明显异常\n四肢关节 未见明显异常\n外生殖器 未见明显异常\n其他 未见明显异常\n小结\n未见明显异常\n医师:\n【眼科检查(外眼、眼底)】\n项目 结果 单位 参考范围\n既往史 无- -\n眼睑 未见明显异常- -\n泪器 未见明显异常- -\n结膜 未见明显异常- -\n巩膜 未见明显异常- -\n眼球 未见明显异常- -\n其他 未见明显异常- -\n黄斑 未见明显异常- -\n视网膜 未见明显异常- -\n视乳头 未见明显异常- -\n小结\n未见明显异常\n医师:\n【视力检查】\n项目 结果 参考范围\n裸眼视力-右眼 0.8\n裸眼视力-左眼 0.8\n≥1.0（小数视\n力）；≥5.0（对\n数视力）\n≥1.0（小数视\n力）；≥5.0（对\n数视力）\n小结\n裸眼视力-右眼:右眼视力低于正常标准(0.8)\n裸眼视力-左眼:左眼视力低于正常标准(0.8)\n检查者:\n【耳鼻咽喉科】\n项目 结果\n既往史 无\n耳廓 未见明显异常\n外耳道 未见明显异常\n鼓膜 未见明显异常\n乳突 未见明显异常\n鼻外形 未见明显异常\n鼻中隔 未见明显异常\n鼻甲 未见明显异常\n鼻腔黏膜 未见明显异常\n鼻窦 未见明显异常\n悬雍垂 未见明显异常\n扁桃体 未见明显异常\n咽部黏膜 未见明显异常\n其他 未见明显异常\n小结\n未见明显异常\n医师:\n【心电图】\n项目 结果\n常规心电图检查（12导联） 窦性心动过缓伴不齐 平均心率56次/分；电轴左偏。\n小结\n常规心电图检查（12导联）:窦性心动过缓伴不齐56次/分\n心电轴左偏\n检查者:\n报告医师:\n【肝胆脾胰双肾彩超】\n项目 结果\n肝脏彩超 肝脏形态大小正常，轮廓规整，实质回声均匀，肝内管道结构清晰。门静脉未见扩张。\n胆囊彩超 胆囊形态大小正常，壁光滑，内未见明显异常回声。胆总管不扩张。\n脾脏彩超 脾脏形态正常，包膜光整，实质回声均匀。\n胰腺彩超 胰腺形态大小正常，轮廓规整，实质回声均匀，主胰管不扩张。\n双肾彩超 双肾形态大小正常，包膜光整，实质回声均匀。集合系统未见分离。\n小结\n肝脏彩超:肝脏声像图未见明显异常\n胆囊彩超:胆囊声像图未见明显异常\n脾脏彩超:脾脏声像图未见明显异常\n胰腺彩超:胰腺声像图未见明显异常\n双肾彩超:双肾声像图未见明显异常\n注：详见图文报告。 医师:\n【前列腺彩超】\n项目 结果\n前列腺彩超 前列腺形态大小正常，轮廓光整，实质回声均匀，未见明显异常回声。CDFI：腺体内未\n见明显异常血流信号。\n小结\n前列腺彩超:前列腺声像图未见明显异常\n注：详见图文报告。 医师:\n【甲状腺彩超】\n项目 结果\n甲状腺彩超 甲状腺形态大小正常，左叶内见一类圆形无回声区，大小约2.4mmx1.4mm，壁薄光\n滑，后壁回声增强，内部未见血流。甲状腺右叶未见明显异常回声。\n小结\n甲状腺彩超:甲状腺左叶囊肿（TI-RADS 2类）\n注：详见图文报告。 医师:\n【胸部低剂量螺旋CT】\n项目 结果\n胸部CT平扫\n小结\n气管及主支气管通畅，内壁光整，双肺门未见增大。双肺血管-支气管束规整，双肺未见\n异常密度影。纵隔无移位，纵隔内未见肿大淋巴结，食管壁未见明显异常增厚。双侧胸\n腔未见积液，双侧胸膜未见增厚。心脏未见增大，主动脉及冠状动脉未见明显粥样硬\n化。胸廓对称，胸壁及双侧腋窝区未见异常。附见：肝左叶见小结节状钙质密度影。\n胸部CT平扫:胸部CT平扫两肺未见明显异常\n肝内钙化灶\n报告医师:\n注：详见图文报告。 审核医师:\n【血常规】 检测机构: 苏州相城美年大健康体检中心 样本类型: 全血 样本性状: 样本正常\n检测时间: 2025-05-17 09:24:16 报告时间: 2025-05-17 16:06:06\n【备注: 无】\n项目 简称 结果 提示 单位 参考区间\n白细胞计数 WBC 6.91 - 10^9/L 4.00-10.00\n中性粒细胞百分数 GRAN% 55.2 - % 50-70\n淋巴细胞百分数 LYM% 37.3 - % 20.00-40.00\n单核细胞百分数 Mono% 6.4 - % 3.00-10.00\n嗜酸性粒细胞百分数 Eos% 1.0 - % 0.50-5.00\n嗜碱性粒细胞百分数 Baso% 0.10 - % 0.00-1.00\n中性粒细胞绝对值 GRAN# 3.81 - 10^9/L 2.00-7.00\n淋巴细胞绝对值 LYM# 2.58 - 10^9/L 0.80-4.00\n单核细胞绝对值 Mono# 0.44 - 10^9/L 0.12-1.20\n嗜酸性粒细胞绝对值 Eos# 0.07 - 10^9/L 0.02-0.50\n嗜碱性粒细胞绝对值 Baso# 0.01 - 10^9/L 0.00-0.10\n红细胞计数 RBC 4.92 - 10^12/L 4.00-5.70\n血红蛋白 Hb 141 - g/L 120-170\n红细胞比容 HCT 43.7 - % 34-49\n红细胞平均体积 MCV 88.8 - fl 80.00-100.00\n平均血红蛋白含量 MCH 28.7 - pg 27.0-34.0\n平均血红蛋白浓度 MCHC 323 - g/L 320-360\n红细胞分布宽度-标准差 RDW-SD 43.7 - fl 35.0-56.0\n红细胞分布宽度-变异系数 RDW-CV 12.7 - % 11.0-16.0\n血小板计数 PLT 293 - 10^9/L 100-300\n平均血小板体积 MPV 10.0 - fl 6.5-12.0\n血小板压积 PCT 0.29 ↑ % 0.10-0.28\n血小板分布宽度 PDW 16.1 - fl 9.0-17.0\n大血小板比率 P-LCR 25.1 - % 9.00-45.00\n大血小板数 P-LCC 74 - 10^9/L 13-129\n注：本检测结果仅对来样负责，供临床参考。如\n检验者:\n有疑问请在样品保存期内提出！ 审核者:\n【尿常规】 检测机构: 苏州相城美年大健康体检中心 样本类型: 尿液 样本性状: 样本正常\n检测时间: 2025-05-17 11:05:28 报告时间: 2025-05-17 12:14:31\n【备注: 无】\n项目 简称 结果 提示 单位 参考区间\n尿白细胞酯酶 LEU 阴性- - 阴性\n尿酮体 KET 阴性- - 阴性\n尿亚硝酸盐 NIT 阴性- - 阴性\n尿胆原 URO 阴性- - 阴性\n尿胆红素 BIL 阴性- - 阴性\n尿蛋白质 PRO 阴性- - 阴性\n尿葡萄糖 GLU 阴性- - 阴性\n尿比重 SG 1.010 - - 1.003-1.030\n尿隐血 BLD 阴性- - 阴性\n尿酸碱度 pH 7.00 - - 5.00-8.40\n尿维生素C VC 阴性- - 阴性\n尿液颜色 UCO 黄色- - 黄色\n尿透明度 TURB 透明- - 透明\n尿白细胞（镜检） U-WBC 未见- /HP 0-5\n尿红细胞（镜检） U-RBC 未见- /HP 0-3\n尿结晶（镜检） U-CRYSTAL 未见- - 未见\n尿管型（镜检） U-CAST 未见- /LP 0-1\n注：本检测结果仅对来样负责，供临床参考。如\n检验者:\n有疑问请在样品保存期内提出！ 审核者:\n【生化检测】 检测机构: 苏州相城美年大健康体检中心 样本类型: 血清 样本性状: 样本正常\n检测时间: 2025-05-17 09:41:52 报告时间: 2025-05-17 14:00:16\n【备注: 无】\n项目 简称 结果 提示 单位 参考区间\n血清总胆红素 T-BIL 24.7 ↑ umol/L ≤23\n血清直接胆红素(结合胆红\nD-BIL 7.1 ↑ umol/L 0.00-6.80\n素)\n血清间接胆红素(计算值)(非\n结合胆红素)\nI-BIL 17.6 - umol/L 1.7-20\n血清丙氨酸氨基转移酶 ALT 18 - U/L 9-50\n血清天门冬氨酸氨基转移酶 AST 14 ↓ U/L 15-40\n血清γ-谷氨酰基转移酶 GGT 20 - U/L 10.00-60.00\n血清碱性磷酸酶 ALP 82.0 - U/L 45-125\n动脉粥样硬化指数(计算值) AI 2.38 - - 0.00-4.00\n血清总胆固醇 TC 5.20 - mmol/L ≤5.71\n血清甘油三酯 TG 0.87 - mmol/L ≤2.3\n血清高密度脂蛋白胆固醇 HDL-C 1.54 - mmol/L ≥1.04\n血清低密度脂蛋白胆固醇 LDL-C 3.36 - mmol/L ≤3.37\n血清尿素 UR 4.82 - mmol/L 2.86-8.2\n血清肌酐 CR 79.5 - umol/L 53-123\n血清尿酸 UA 339.80 - umol/L 210-430\n注：本检测结果仅对来样负责，供临床参考。如\n检验者:\n有疑问请在样品保存期内提出！ 审核者:\n【肿瘤标志物检测】 检测机构: 苏州相城美年大健康体检中心 样本类型: 血清 样本性状: 样本正常\n检测时间: 2025-05-17 11:36:17 报告时间: 2025-05-17 17:59:11\n【备注: 无】\n项目 简称 结果 提示 单位 参考区间\n癌胚抗原（定量） CEA 0.68 - ng/ml 0-5\n甲胎蛋白（定量） AFP 4.19 - ng/mL 0-10\n总前列腺特异性抗原 t-PSA 2.440 - ng/mL 0-4\n游离前列腺特异性抗原 f-PSA 0.970 - ng/mL 0-1\n糖链抗原19-9 CA19-9 8.46 - U/mL 0-35\n注：本检测结果仅对来样负责，供临床参考。如\n有疑问请在样品保存期内提出！\n检验者:\n审核者:\n【糖尿病检测】 检测机构: 苏州相城美年大健康体检中心 样本类型: 血清 样本性状: 样本正常\n检测时间: 2025-05-17 09:41:52 报告时间: 2025-05-17 14:00:16\n【备注: 无】\n项目 简称 结果 提示 单位 参考区间\n空腹血糖 GLU-0h 5.19 - mmol/L 3.89-6.11\n注：本检测结果仅对来样负责，供临床参考。如\n检验者:\n有疑问请在样品保存期内提出！ 审核者:\n【冠心病风险指数评估（钙化积分计算）】\n项目 结果 单位 参考范围\n冠心病风险指数评估（钙化\n积分计算） 详见图文报告- -\n小结\n冠心病风险指数评估（钙化积分计算）:详见图文报告\n注：详见图文报告。 检查者:\n【大便隐血检测试剂盒（胶体金法）定性】\n项目 结果\n大便隐血检测试剂盒（胶体\n金法）定性 详见纸质报告\n常见体检数据对比\n本次（2025-05-17） 上次\n项目\n结果 单位 参考区间 结果 单位 参考区间\n体重指数 24.1 kg/m² 18.5~23.9 22.2\n(2023/01/08) kg/m² 18.5~23.9\n收缩压 108 mmHg 90-139 115\n(2023/01/08)\nmmHg 90-139\n舒张压 57 mmHg 60-89 68\n(2023/01/08)\nmmHg 60-89\n免责声明\n尊敬的 赵道凯 先生\n您好！\n健康体检的目的在于帮助您了解自身健康状况，便于您更好的管理健康、促进健康。疾病的发生发展有其客观规\n律，在一定的阶段存在潜伏性和突变性，科学的认识也存在过程，现有的医疗技术水平对于疾病的筛查也存在局限\n性。由于您选择的健康体检套餐或项目有限，健康体检结果不能完全作为您全身健康状况的评价依据和疾病的诊断依\n据，同时，本次体检未发现异常的项目并不说明完全没有潜在异常隐患，若有异常症状出现请及时就医。我们将在您\n健康体检项目完成后及时向您提供体检报告，请您详阅并妥善保管，认真关注报告中的就医指导和建议！如果您对报\n告内容有任何疑问，请您于一周内到本中心查询或致电客服部。为了您的健康，我们建议您每年进行一次系统体检。\n祝您健康！"}, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:19:09.820253Z", "updated_at": "2026-05-21T16:19:09.820274Z"}, {"id": 5, "user": 5, "member": 19, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": "1. 窦性心动过缓(54次/分)：无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗，建议正规医院专科诊治。2. 甲状腺双叶囊肿（多发）：建议专科治疗。3. 中性粒细胞百分数降低：建议及时复查，如果仍然异常，请尽早去医院，查明原因。4. 淋巴细胞百分数增高：建议复查，如果仍然异常，请尽早去医院，查明原因。5. 血小板压积增高：建议复查，如果仍然异常，请去医院，查明原因。6. 血小板计数增高：建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "source": 2, "raw_ocr": {"text": "=== File 1: 体检报告_1.pdf ===\n苏州美健奥亚健康体检中心\n赵道凯 先生\n单位名\n上海爱元通科技有限公司\n称：\n身份证： 34118119981029501X\n年龄： 25\n体检号： 2138111466\n体检时\n2023/1/8 7:59:12\n间：\n报告阅读说明\n报告阅读说明:\n1 您好，欢迎您选择美年大健康集团体检！我们为您提供健康管理、健康体检、临床检验、特色诊疗、中医养生\n等全方位的医疗健康服务。\n2 医学科技发展至今，现有的医疗技术手段，对于疾病的筛查仍具有局限性和时效性，本次体检由于所选项目受\n限，会无法发现某些潜在疾病；体检后未发现异常的项目，并不说明就没有潜在疾病，如果有疾病症状出现，请\n立即就医。\n3 本报告书仅对受检者本次所检结果负责;警示部位请您关注，示意图仅供参考。特别说明：对于结论为详见纸质\n报告的检测项目异常信息及国家规定的单独出报告的检测项目异常信息不纳入健康警示灯及主要阳性结果及建议\n中。\n主要阳性结果及异常情况\n主要阳性结果及异常情况(报告医师\n报告医师: 黄家忻\n黄家忻 审核医师\n审核医师: 何秋兰\n何秋兰)\n★ 心电图检查结果:\n窦性心动过缓(54次/分)\n★ 甲状腺彩超:\n甲状腺双叶囊肿（多发）\n异常指标解读\n异常指标解读\n窦性心动过缓\n窦性心动过缓\nB201600279\n【医学解释】\n【医学解释】\n成人窦性心律的频率低于60次/分，称为窦性心动过缓。\n【常见原因及后果】\n【常见原因及后果】\n常见于健康的青年人、运动员与睡眠状态。其他原因包括颅内疾患、严重缺氧、低温、甲状腺机能减退、阻\n塞性黄疸以及应用洋地黄等药物。亦可见于窦房结病变和急性下壁心肌梗死。 如心室率过于缓慢低于40次/分\n，可出现头晕、晕厥、心绞痛等。\n【建议】\n【建议】\n无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者\n考虑心脏起搏器治疗。正规医院专科诊治。\n甲状腺囊肿（多发）\n甲状腺囊肿（多发）\n【医学解释】\n【医学解释】\n较小的囊肿可无症状，囊肿逐渐增大可出现压迫症状\n【常见原因及后果】\n【常见原因及后果】\n较小的囊肿可无症状，囊肿逐渐增大可出现压迫症状。\n【建议】\n【建议】\n建议专科治疗。\n中性粒细胞百分数（\n降低\n中性粒细胞百分数（NEUT% ） ） 降低\n结果: 46.5 %\n范围:50.00-70.00 %\n【医学解释】\n【医学解释】\n白细胞分类计数是指计算各类白细胞（中性粒细胞、淋巴细胞、嗜酸性粒细胞、嗜碱性粒细胞和单核细胞）\n的百分数和绝对值，通过对染色血涂片，进行细胞分类，求得各类白细胞的百分数，对各种疾病的诊断有着\n重要的参考价值。\n【常见原因及后果】\n【常见原因及后果】\n粒细胞减少： 1.感染性疾病：革兰阴性杆菌感染，如伤寒、副伤寒，白细胞总数与中性粒细胞均减少；某些\n病毒感染，如流感、水痘、风疹，白细胞亦常减低；某些原虫感染，如疟疾、黑热病等 ，白细胞可减少。 2.\n血液系统疾病：如再障、巨幼细胞贫血、粒细胞减少症等。 3.慢性理化损伤：长期接触放射线；应用某些化\n学药物，如氯霉素、抗肿瘤药；某些化学物质，如苯、铅汞等，均可引起白细胞及中性粒细胞减少。 4.自身\n免疫性疾病：如系统性红斑狼疮（SLE）等，产生自身抗体导致白细胞减少。 5.单核－巨噬细胞系统功能亢\n进，如脾功能亢进、淋巴瘤、类脂质沉积病等。\n【建议】\n【建议】\n粒细胞异常减少，建议及时复查，如果仍然异常，请尽早去医院，查明原因。\n淋巴细胞百分数（LYM% ） ） 增高\n淋巴细胞百分数（\n增高\n结果: 44.4 %\n范围:20.00-40.00 %\n【医学解释】\n【医学解释】\n白细胞分类计数是指计算各类白细胞（中性粒细胞、淋巴细胞、嗜酸性粒细胞、嗜碱性粒细胞和单核细胞）\n的百分数和绝对值，通过对染色血涂片，进行细胞分类，求得各类白细胞的百分数，对各种疾病的诊断有着\n重要的参考价值。\n【常见原因及后果】\n【常见原因及后果】\n淋巴细胞增高： ⑴ 病毒感染性疾病。 ⑵ 急、慢性淋巴细胞性白血病，淋巴瘤。 ⑶ 慢性炎症，急性传染病的\n恢复期。 ⑷ 组织移植后的排斥反应。\n【建议】\n【建议】\n淋巴细胞异常，建议复查，如果仍然异常，请尽早去医院，查明原因。\n血小板压积（PCT） ） 增高\n血小板压积（\n增高\n结果: 0.338 %\n【医学解释】\n【医学解释】\n范围:0.10-0.28 %\n血小板压积(PCT)是指抗凝全血经离心沉淀后，测得下沉的血小板在全血中所占容积的百分比值。\n【常见原因及后果】\n【常见原因及后果】\n在健康人群中该指标意义不大。\n【建议】\n【建议】\n血小板压积异常，建议复查，如果仍然异常，请去医院，查明原因。\n血小板计数（PLT） ） 增高\n血小板计数（\n增高\n结果: 357 10^9/L\n范围:100-300 10^9/L\n【医学解释】\n【医学解释】\n血小板由骨髓中的成熟巨核细胞产生，直径2～4μm，寿命10天左右。血小板的数量和质量与止血和凝血功能\n密切相关。\n【常见原因及后果】\n【常见原因及后果】\n血小板增多见于：①原发性增多，如原发性血小板增多症，真性红细胞增多症等；②反应性增多，如急性感\n染，急性大出血，急性溶血等。血小板＞600×10^9/L可发生血栓性疾病。\n【建议】\n【建议】\n血小板计数异常，建议及时复查，如果仍然异常，请尽早去医院，查明原因。\n【一般检查】\n【一般检查】 检查者\n检查者:吴梦怡\n吴梦怡\nB201600279\n检查项目名称 结果 单位 正常范围值\n身高 166.0 Cm\n体重 61.1 kg\n体重指数(18.5-23.9) 22.2\n理想体重(kg) 59.4\n收缩压 115 mmHg\n舒张压 68 mmHg\n脉搏（次/分） 77\n体重指数:22.2\n小结\n血压:115/68mmHg\n脉搏:77 次/分\n【内科】 检查者\n【内科】\n徐静\n检查者:徐静\n检查项目名称 结果 单位 正常范围值\n病史 无\n心率 78 次/分\n呼吸 18 次/分\n心律 整齐\n心音 未见异常\n心脏杂音 未见异常\n心脏其他 未见异常\n肺罗音 未见异常\n呼吸音 未见异常\n腹壁 未见异常\n肝大小 未见异常\n肝脏质地 未见异常\n肝脏压痛 未见异常\n脾大小 未见异常\n脾脏质地 未见异常\n脾脏压痛 未见异常\n其他 未见异常\n小结 内科未发现明显异常\n【外科】 检查者\n【外科】\n检查者:杨建华\n杨建华\n检查项目名称 结果 单位 正常范围值\n皮肤颜色 未见异常\n皮疹 无\n皮下肿块 无\n水肿 无\n蜘蛛痣 无\n疤痕部位 无\n溃疡部位 无\n糜烂部位 无\n淋巴结 未见异常\n甲状腺 未见异常\n乳房 未见异常\n四肢关节 未见异常，活动自如\n脊柱 未见异常，活动自如\n疝 无\n包皮 弃查\n阴茎 弃查\n睾丸 弃查\n前列腺 未见异常\n其他检查 无\n小结 外科未发现明显异常\n【静态心电图】\n【静态心电图】 检查者\n唐永鹏\n检查者:唐永鹏\n检查项目名称 结果 单位 正常范围值\n小结 窦性心动过缓(54次/分)\n【肝胆脾胰肾彩超】 检查者\n【肝胆脾胰肾彩超】\n检查者:郭娟\n郭娟 审核者\n孙立\n审核者: 孙立\nB201600279\n检查项目名称 结果 单位 正常范围值\n肝 肝脏大小、形态正常，包膜光整，肝内血管走行较清\n晰，光点分布尚均匀，其内未见明显异常光团。\n胆 胆囊大小、形态正常，囊壁光整，囊腔内透声好，胆\n总管无扩张。\n胰 胰腺大小、形态正常，边缘规整，内部回声均匀，胰\n管未见扩张。\n脾 脾脏大小、形态正常，包膜光整，内光点均匀。\n左肾 左肾大小、形态正常，包膜光滑，肾实质回声均匀，\n集合系统未见明显分离。\n右肾 右肾大小、形态正常，包膜光滑，肾实质回声均匀，\n集合系统未见明显分离。\n小结 肝、胆、胰、脾、左肾、右肾未发现明显异常\n【甲状腺彩超】 检查者\n【甲状腺彩超】\n检查者:郭娟\n郭娟 审核者\n孙立\n审核者: 孙立\n检查项目名称 结果 单位 正常范围值\n甲状腺形态大小正常，甲状腺双叶内均可见多个类圆形\n描述\n无回声区,最大位于右叶，大小约2mm×3mm，后方回\n声增强，内部未见血流。\n小结 甲状腺双叶囊肿（多发）\n【前列腺彩超】 检查者\n【前列腺彩超】\n检查者:郭娟\n郭娟 审核者\n孙立\n审核者: 孙立\n检查项目名称 结果 单位 正常范围值\n前列腺 前列腺大小、形态正常，包膜光滑完整，两侧对\n称，内部回声均匀。\n小结 前列腺未发现明显异常\n【胸部CT】 】 检查者\n【胸部\n检查者:顾松鸿\n顾松鸿 审核者\n徐建良\n审核者: 徐建良\n检查项目名称 结果 单位 正常范围值\n两侧胸廓对称。肺窗示两肺纹理清晰，走行自然，未见\n明显异常密度影。两侧肺门不大。纵隔窗示心影及大血\n描述\n管形态正常，纵隔内未见肿块及明显肿大淋巴结。无胸\n腔积液及胸膜增厚。\n小结 胸部CT平扫未见明显异常\n【癌胚抗原检测定量】\n【癌胚抗原检测定量】 检验者\n检验者:王娜娜\n王娜娜 审核者\n王丽华\n审核者:王丽华\n检查项目名称 结果 单位 正常范围值\n癌胚抗原测定定量(CEA) 0.896 ng/mL 0-5\n【甲胎蛋白检测定量】\n【甲胎蛋白检测定量】 检验者\n检验者:王娜娜\n王娜娜 审核者\n王丽华\n审核者:王丽华\n检查项目名称 结果 单位 正常范围值\n甲胎蛋白测定定量 (AFP) 2.44 ng/mL 0-10\n【空腹血糖】 检验者\n【空腹血糖】\n