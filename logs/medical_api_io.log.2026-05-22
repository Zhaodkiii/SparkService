INFO 2026-05-22 17:24:14,584 medical.api_io [request_id=B33A3B4E-2CEB-43A7-95A6-0D22F4D1E6D0] HTTP 响应摘要: GET /api/v1/medical/members/21/complete-data/ status=200 duration_ms=47 bytes=1571 headers={"Content-Type": "application/json", "ETag": "\"f1b575b264e9bdee20d7931dd9a65ed5\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 21, "member": {"id": 21, "user": 5, "name": "接触", "gender": "male", "relationship": "other", "birth_date": "1999-05-22", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-22T06:07:00.018326Z", "updated_at": "2026-05-22T06:07:00.018347Z"}, "medical_cases": [], "health_exam_reports": [], "examination_reports": [{"id": 116, "user": 5, "member": 21, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-22T10:01:17.902346Z", "updated_at": "2026-05-22T10:01:17.902361Z", "attachments": []}, {"id": 115, "user": 5, "member": 21, "medical_record": null, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-22T06:07:05.274121Z", "updated_at": "2026-05-22T06:07:05.274146Z", "attachments": []}], "medicine_boxes": [], "prescriptions": [], "medication_plans": [], "today_medication_records": [], "medication_summary": {"today_total": 0, "today_taken": 0, "today_skipped": 0, "adherence_rate": 0, "active_plan_count": 0, "low_stock_count": 0, "expiring_soon_count": 0}, "sy