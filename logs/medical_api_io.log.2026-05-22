ords": [], "medication_summary": {"today_total": 0, "today_taken": 0, "today_skipped": 0, "adherence_rate": 0, "active_plan_count": 0, "low_stock_count": 0, "expiring_soon_count": 0}, "symptoms": [], "visits": [], "surgeries": [], "follow_ups": []}}
