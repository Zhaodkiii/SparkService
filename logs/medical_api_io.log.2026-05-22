INFO 2026-05-22 01:52:46,195 medical.api_io [request_id=2FA92CC5-86EC-4298-BA52-3A6B41D7F206] HTTP 响应摘要: GET /api/v1/medical/members/20/complete-data/ status=200 duration_ms=75 bytes=9781 headers={"Content-Type": "application/json", "ETag": "\"d3844099d93c4990547b3b577855c03f\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 20, "member": {"id": 20, "user": 5, "name": "石头", "gender": "male", "relationship": "self", "birth_date": "1996-05-22", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-21T16:01:48.463580Z", "updated_at": "2026-05-21T16:01:48.463599Z"}, "medical_cases": [{"id": 38, "member": 20, "record_type": "outpatient", "status": 1, "title": "体检健康", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"visit_date": "2026-05-22"}, "created_at": "2026-05-21T16:23:24.604494Z", "updated_at": "2026-05-21T16:23:24.604519Z", "symptoms": [], "medications": [], "attachments": []}], "health_exam_reports": [{"id": 3, "user": 5, "member": 20, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "", "exam_date": "2025-09-14", "exam_type": 1, "summary": "1、右下肺实性结节，Lung-RADS2 依据影像特征，结节为“良性表现或良性变化”，人群罹患率约45%；建议12个月做低剂量胸部CT筛查，呼吸科随诊。2、肺内纤维灶 多为肺部炎症愈合后遗留的纤维化疤痕。纤维化范围小基本不影响呼吸功能，范围广可导致肺功能降低。建议定期复查胸部CT和肺功能，伴有呼吸道症状时请呼吸科就诊。3、肥胖(体重指数 30.7 kg/m²) 热量摄入多于消耗所致，是高血压、高血脂、高血糖和高尿酸的重要危险因素。建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，达成3～6个月之内至少降低体重5%～15%并维持的目标。4、肝内钙化灶 多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合后钙盐沉着，也可为肝内胆管壁部分钙化。建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。5、正常高值血压:(128/71mmHg) 血压正常高值也具有一定的心脑血管事件风险。建议低盐饮食、不要吸烟和饮酒、适量运动，定期监测血压，预防高血压的发生。6、中性粒细胞百分数减低:40.8%(参考区间:50-70)，嗜酸性粒细胞百分数增高:8.4%(参考区间:0.50-5.00)，淋巴细胞百分数增高:45.0%(参考区间:20.00-40.00)，建议您结合病史和症状定期复查血常规，如有明显异常请内科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:15:41.009086Z", "updated_at": "2026-05-21T16:15:41.009129Z", "attachments": [{"id": 579, "file_uuid": "1463345b-e366-42c2-9a4c-621dba68a948", "original_name": "70792600922615_NORMAL_COLOR_20250916172507390.pdf", "file_size": 7161015, "mime_type": "application/pdf", "file_md5": "c3037013a87ea0b04e553b0ef8b76619", "business_type": "health_exam_report", "business_id": "3", "object_key": "SparkClient/20260521/1463345B-E366-42C2-9A4C-621DBA68A948/70792600922615_NORMAL_COLOR_20250916172507390.pdf", "storage_type": "oss", "created_at": "2026-05-21T16:13:05.016747Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/1463345B-E366-42C2-9A4C-621DBA68A948/70792600922615_NORMAL_COLOR_20250916172507390.pdf"}]}], "examination_reports": [{"id": 112, "user": 5, "member": 20, "medical_record": 38, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "报告确认者", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:06:18.858017Z", "updated_at": "2026-05-21T16:23:57.421126Z", "attachments": [{"id": 576, "file_uuid": "df607d57-2247-4b32-afa6-e06f59899593", "original_name": "4ae1f888f2dfd171ff9ef954279d03c6.pdf", "file_size": 2487445, "mime_type": "application/pdf", "file_md5": "add43ebd41b356cf95dcaee94b498245", "business_type": "examination_report", "business_id": "112", "object_key": "SparkClient/20260521/DF607D57-2247-4B32-AFA6-E06F59899593/4ae1f888f2dfd171ff9ef954279d03c6.pdf", "storage_type": "oss", "created_at": "2026-05-21T16:02:41.314903Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/DF607D57-2247-4B32-AFA6-E06F59899593/4ae1f888f2dfd171ff9ef954279d03c6.pdf"}]}, {"id": 109, "user": 5, "member": 20, "medical_record": 38, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院", "de