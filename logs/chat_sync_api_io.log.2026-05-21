）。\",\"date\":\"2025-12-28\",\"details\":[{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"总胆红素(TBIL)\",\"result_value\":\"13.5\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"直接胆红素(DBIL)\",\"result_value\":\"4.2\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"间接胆红素(IBIL)\",\"result_value\":\"9.3\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"天门冬氨酸氨基转移酶(AST)\",\"result_value\":\"13.5\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"丙氨酸氨基转移酶(ALT)\",\"result_value\":\"14.6\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"总蛋白(TP)\",\"result_value\":\"77.0\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"白蛋白(ALB)\",\"result_value\":\"47.4\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"球蛋白(GLOB)\",\"result_value\":\"29.6\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"白球比(A\\/G)\",\"result_value\":\"1.6\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"γ-谷氨酰转移酶(GGT)\",\"result_value\":\"19.9\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"碱性磷酸酶(ALP)\",\"result_value\":\"75.9\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"前白蛋白(PA)\",\"result_value\":\"287.0\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能\",\"diagnosis\":\"正常\",\"item_name\":\"尿素(UREA)\",\"result_value\":\"5.14\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能\",\"diagnosis\":\"正常\",\"item_name\":\"肌酐(CREA)\",\"result_value\":\"77.50\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能\",\"diagnosis\":\"正常\",\"item_name\":\"尿酸(UA)\",\"result_value\":\"324.6\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能\",\"diagnosis\":\"正常\",\"item_name\":\"胱抑素C(CysC)\",\"result_value\":\"0.76\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"血糖\",\"diagnosis\":\"正常\",\"item_name\":\"葡萄糖(GLU)\",\"result_value\":\"5.42\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"心肌酶\",\"diagnosis\":\"正常\",\"item_name\":\"肌酸激酶(CK)\",\"result_value\":\"104.3\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"心肌酶\",\"diagnosis\":\"正常\",\"item_name\":\"乳酸脱氢酶(LDH)\",\"result_value\":\"168.0\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"心肌酶\",\"diagnosis\":\"正常\",\"item_name\":\"α-羟丁酸脱氢酶(HBDH)\",\"result_value\":\"140.4\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肝功能\",\"diagnosis\":\"正常\",\"item_name\":\"胆碱酯酶(CHE)\",\"result_value\":\"11124\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"血脂\",\"diagnosis\":\"适宜\",\"item_name\":\"甘油三酯(TG)\",\"result_value\":\"0.70\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"血脂\",\"diagnosis\":\"适宜\",\"item_name\":\"总胆固醇(TC)\",\"result_value\":\"5.07\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"血脂\",\"diagnosis\":\"正常\",\"item_name\":\"高密度脂蛋白胆固醇(HDL-C)\",\"result_value\":\"1.51\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"血脂\",\"diagnosis\":\"增高\",\"item_name\":\"低密度脂蛋白胆固醇(LDL-C)\",\"result_value\":\"3.51\",\"sort_order\":null}],\"doctor\":\"\",\"hospital\":\"苏州大学附属第四医院（苏州市独墅湖医院）\",\"title\":\"苏州大学附属第四医院（苏州市独墅湖医院）检验报告单\"}", "is_saved": false, "title": "苏州大学附属第四医院（苏州市独墅湖医院）检验报告单", "id": "2BF7763B-E1FF-4959-9A5D-54A4969C4AC2"}], "medical_cases": [], "prescriptions": [], "medications": []}}}, "order_key": 4100}}]}
