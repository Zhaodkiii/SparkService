status": "ready", "revision": 1, "node_role": "timeline", "id": "E50E73C0-4792-4445-861C-1CE94431364A"}], "thread_max_tokens": 14096, "delivery_state": "sending", "thread_id": "4901D3AF-5745-4D8A-8FE8-6607FC5C3AFB", "client_message_id": "BE30CFC0-CC21-4A20-A323-E2426EEBD91F", "created_at": "2026-05-21T08:18:22.391Z", "thread_max_messages": 20, "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "model_name": "user", "thread_current_model_name": "deepseek-v4-pro"}]}
