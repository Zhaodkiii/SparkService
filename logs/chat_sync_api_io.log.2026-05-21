0", "updated_at": "2026-05-21T02:28:09.000Z"}, {"kind": "text", "created_at": "2026-05-21T02:28:09.000Z", "payload": {"text": {"_0": "不要输出任何多余文字内容 \n直接调用 generate_structured_health_card 带入合适的参数  其他都不要输出"}}, "revision": 1, "node_role": "timeline", "status": "ready", "id": "F17A94D4-3A77-4E13-A9A0-30E91C820B1C", "updated_at": "2026-05-21T02:28:09.000Z"}], "created_at": "2026-05-21T02:28:09.685Z", "thread_top_p": 1, "role": "user", "thread_max_messages": 20}]}
