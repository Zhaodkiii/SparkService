oubao-seed-2-0-pro-260215", "client_message_id": "5C60AF71-0880-47FD-9334-E14244CB2FAC", "thread_max_tokens": 14096, "tombstone": false, "delivery_state": "pending", "role": "assistant", "thread_top_p": 1, "thread_id": "D8BE5C68-9AF3-4535-83CB-D36BD3C86D0C"}]}
