model_name": "user", "client_message_id": "950C7805-0BFD-4BED-952C-A2FA5F4E29A7", "created_at": "2026-05-21T01:53:55.299Z", "delivery_state": "pending", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_current_model_name": "deepseek-v4-pro", "thread_top_p": 1, "tombstone": false, "role": "user", "thread_max_tokens": 14096, "thread_temperature": 0.6}]}
