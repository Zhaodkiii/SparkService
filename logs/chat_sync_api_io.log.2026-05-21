ready", "payload": {"text": {"_0": "不要输出任何多余文字内容 \n直接调用 generate_structured_health_card 带入合适的参数  其他都不要输出"}}, "revision": 1, "node_role": "timeline", "thread_id": "dfe1ca7f-b9ef-4934-8797-a0313ba2351c", "created_at": "2026-05-21T02:11:07.000Z", "updated_at": "2026-05-21T02:11:07.000Z", "client_message_id": "552c472c-33b3-43ef-8d10-27ede1e4044a", "order_key": null, "tool_call_id": null, "parent_tool_call_id": null, "parent_block_id": null, "anchor": null}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "dfe1ca7f-b9ef-4934-8797-a0313ba2351c", "role": "assistant", "model_name": "deepseek-v4-pro", "client_message_id": "6bc20d00-d5a1-4505-ad40-f034c944268d", "server_message_id": "7f777923-50d5-4747-9a3b-9562b1227e34", "delivery_state": "sent", "created_at": "2026-05-21T02:11:07.861000+00:00", "server_updated_at": "2026-05-21T05:22:24.546844+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "9307D78A-1AF0-5CAB-96D5-117CBDCF5BA9", "kind": "tool", "status": "ready", "payload": {"tool": {"_0": {"name": "generate_structured_health_card", "content": "【系统】结构化保存卡片正在后台生成中。请直接根据用户消息或对话中的相关原文进行专业解读，无需等待卡片即可继续回答；卡片生成后将显示在本条助手回复下方。若再次调用 generate_structured_health_card：raw_text 必须是你提炼后的医学要点，可选 oss_file_id 与消息中的 oss_file_id 一致，勿把完整 OCR 传给工具。"}}}, "revision": 1779329480962885, "node_role": "tool", "order_key": 2000, "thread_id": "dfe1ca7f-b9ef-4934-8797-a0313ba2351c", "created_at": "2026-05-21T02:11:20.000Z", "updated_at": "2026-05-21T02:11:20.000Z", "tool_call_id": "call_00_eGInMtSU96QJn0uTS7bd6895", "client_message_id": "6bc20d00-d5a1-4505-ad40-f034c944268d", "parent_tool_call_id": null, "parent_block_id": null, "anchor": null}, {"id": "6A0225C1-2C92-53A9-BB2B-3399337A68BE", "kind": "structuredHealthCards", "anchor": {"type": "toolCall", "value": "call_00_eGInMtSU96QJn0uTS7bd6895"}, "status": "ready", "payload": {"structured_health_cards": {"_0": {"medications": [], "exam_reports": [], "