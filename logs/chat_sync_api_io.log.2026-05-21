\"visit_no\":\"0000349056\",\"visit_type\":\"门诊\",\"visited_at\":\"2026-02-10\"}}", "member_id": 16, "oss_file_id": 546, "id": "3C8CAB36-4DB1-423E-A0DA-4E6B52404C02", "title": "就诊病例", "diagnosis_line": "慢性非萎缩性胃炎伴胆汁反流", "is_saved": true}]}}}, "created_at": "2026-05-21T07:59:59.025Z", "revision": 1779350399024630, "anchor": {"type": "toolCall", "value": "call_01_3fuf0Etlsb1ir12Z6dBT8956"}, "parent_tool_call_id": "call_01_3fuf0Etlsb1ir12Z6dBT8956", "status": "ready", "node_role": "toolPresentation", "updated_at": "2026-05-21T08:05:35.068Z", "parent_block_id": "86ED3239-75EC-5188-9B3C-8E61F2DDC31C", "tool_call_id": "call_01_3fuf0Etlsb1ir12Z6dBT8956", "kind": "structuredHealthCards"}, "thread_id": "24FECFC3-3E15-42F2-B7C0-980E2A793254"}]}
