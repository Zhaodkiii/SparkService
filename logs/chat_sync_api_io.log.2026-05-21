 "type": "image"}]}}, "created_at": "2026-05-21T02:20:37.000Z", "id": "60A1CAA2-AB0C-4877-98A2-511D2A7300E3", "revision": 1, "node_role": "timeline"}, {"updated_at": "2026-05-21T02:20:37.000Z", "kind": "text", "status": "ready", "payload": {"text": {"_0": "不要输出任何多余文字内容 \n直接调用 generate_structured_health_card 带入合适的参数  其他都不要输出"}}, "created_at": "2026-05-21T02:20:37.000Z", "revision": 1, "id": "EA9EBFCA-9B59-46AC-816B-C3CEE52EF4B9", "node_role": "timeline"}]}]}
