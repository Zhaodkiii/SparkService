026-05-20", "is_saved": true, "member_id": 19, "id": "8BFEA6C3-EEF3-4AA4-8AF7-91CB3C3723C7", "title": "健康数据总结"}]}}}, "revision": 1779362362404709, "id": "E025F2E4-F5B0-5C53-8601-84B9D1D14755", "updated_at": "2026-05-21T11:23:30.584Z", "order_key": 12100, "created_at": "2026-05-21T11:19:22.393Z"}, "thread_id": "C716AFF2-6891-4FE7-95D4-EE7649898BF3"}]}
