INFO 2026-05-21 10:21:42,335 chat_sync.api_io [request_id=E9F61D58-43C3-4A28-A11C-09CED7E66B6B] HTTP 响应摘要: GET /api/v1/ai/chat/sync/pull/ status=200 duration_ms=8 bytes=8786 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "ok", "data": {"cursor": "v2:eyJ0cyI6IjIwMjYtMDUtMjFUMDU6MTQ6MTAuMDYxMTI1KzAwOjAwIiwiaWQiOiI2NzEifQ", "messages": [{"thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "role": "system", "model_name": "system", "client_message_id": "07570833-d5a6-4353-9778-8930a16e1133", "server_message_id": "a3e80154-37b0-45b6-b38c-52f2d176d7a5", "delivery_state": "sent", "created_at": "2026-05-21T05:13:18.775000+00:00", "server_updated_at": "2026-05-21T05:13:19.851603+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "935F0AA2-6016-4C32-8818-2531A39C3A24", "kind": "text", "status": "ready", "payload": {"text": {"_0": "🛑 响应已打断"}}, "revision": 1, "node_role": "timeline", "thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "created_at": "2026-05-21T05:13:18.775Z", "updated_at": "2026-05-21T05:13:18.775Z", "client_message_id": "07570833-d5a6-4353-9778-8930a16e1133", "order_key": null, "tool_call_id": null, "parent_tool_call_id": null, "parent_block_id": null, "anchor": null}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "role": "user", "model_name": "user", "client_message_id": "56a583ab-bde0-4dfb-a92a-dbded576a6b6", "server_message_id": "eb5fde34-d761-47ff-8136-a05f0efd0196", "delivery_state": "sent", "created_at": "2026-05-21T05:13:20.510000+00:00", "server_updated_at": "2026-05-21T05:13:21.387497+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "A04EBBB8-AD23-443D-94D2-A194140D1845", "kind": "text", "status": "ready", "payload": {"text": {"_0": "【图片附件】file_id=528 file_uuid=f51fed66-9619-46cb-81c0-8ce68f74118f\\n【图片识别】\\n苏州大学附属第四医院\\n苏州市独墅湖医院\\n胃镜诊断报告单\\n姓名：赵道凯\\n性别：男\\n年龄：28 岁\\n申请科室：消化内科门诊\\n门诊号：0000349056\\n住院号：\\n床号：\\n病区：\\n检查项目：无痛电子胃镜（不含林醉费）\\n申请单号：260821105\\n①食管\\n②齿状线\\n③胃底\\n①胃体\\n⑤胃角\\n6胃窦\\n⑦十二指肠球部\\n⑧十二指肠降部\\n内镜所见：\\n食管：通过顺利，黏膜大致正常；\\n贵门：开合佳通畅；\\n胃底：黏膜正常；\\n胃体：见胆汁残留；\\n胃角：光整；\\n胃窦：黏膜红白相间，以红为主；\\n幽门：圆，开放好；\\n十二指肠球部及所见降部：未见明显异常。\\n诊断：\\n慢性非菱缩性胃炎伴胆汁反流\\n活检部位：\\n建议：\\n报告医生：健\\n审核医师：F26\\n报告时间：2026-02-10\\n备注：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告！\\n\\n【用户输入】\\n不要输出任何多余文字内容 \\n直接调用 generate_structured_health_card 带入合适的参数  其他都不要输出\\n只生成一份报告"}}, "revision": 1, "node_role": "timeline", "thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "created_at": "2026-05-21T05:13:20.510Z", "updated_at": "2026-05-21T05:13:20.510Z", "client_message_id": "56a583ab-bde0-4dfb-a92a-dbded576a6b6", "order_key": null, "tool_call_id": null, "parent_tool_call_id": null, "parent_block_id": null, "anchor": null}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "role": "assistant", "model_name": "deepseek-v4-pro", "client_message_id": "590fa9c7-81fa-4052-8fd3-611d380cb138", "server_message_id": "69a8ff62-4eda-41d7-a7ba-b06d7bd88f65", "delivery_state": "sent", "created_at": "2026-05-21T05:13:20.552000+00:00", "server_updated_at": "2026-05-21T05:13:38.112196+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "0D226A0B-473E-5F52-B2D3-A542D58D0666", "kind": "tool", "status": "ready", "payload": {"tool": {"_0": {"name": "generate_structured_health_card", "content": "[系统] 结构化健康生成完成，不要回复任何内容。"}}}, "revision": 1779340410037067, "node_role": "tool", "order_key": 2000, "thread_id": "ed0dcbc2-cb97-4006-ae5b-d3c6d8d70dd4", "created_at": "2026-05-21T05:13:30.012Z", "updated_at": "2026-05-21T05:13:30.037Z", "tool_call_id": "call_00_p7IJB0yZOCPnqO7lQVjg7566", "client_message_id": "590fa9c7-81fa-4052-8fd3-611d380cb138", "parent_tool_call_id": null, "parent_block_id": null, "anchor": null}, {"id": "