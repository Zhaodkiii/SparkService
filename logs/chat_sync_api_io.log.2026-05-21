INFO 2026-05-21 02:12:17,916 chat_sync.api_io [request_id=C6A19995-F3E8-48CB-8EBB-AE3FCE8576A0] HTTP 请求进入: POST /api/v1/ai/chat/sync/push/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MzMwMjA5LCJpYXQiOjE3NzkzMjg0MDksImp0aSI6IjEwNDhmYTU0ZmVlNzRmNDZhNDdkN2NhZmQwZTk0YjQ4IiwidXNlcl9pZCI6IjQifQ.4cgV7oNt-BaLsvuAuOMJRYoL78vWfOZnO3kEBgjDJec", "X-Request-Id": "C6A19995-F3E8-48CB-8EBB-AE3FCE8576A0", "Content-Length": "2207"} body={"messages": [{"model_name": "doubao-seed-2-0-pro-260215", "created_at": "2026-05-21T02:11:53.573Z", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "role": "assistant", "thread_current_model_name": "doubao-seed-2-0-pro-260215", "server_updated_at": "2026-05-21T02:12:17.140Z", "tombstone": false, "blocks": [{"node_role": "tool", "id": "0E26EAC3-7DF8-5576-A73E-8B56BFDCE50D", "status": "ready", "kind": "tool", "order_key": 2000, "tool_call_id": "call_11afis5u5ra9n8h3h1gxy4rm", "payload": {"tool": {"_0": {"name": "generate_structured_health_card", "content": "【系统】结构化保存卡片正在后台生成中。请直接根据用户消息或对话中的相关原文进行专业解读，无需等待卡片即可继续回答；卡片生成后将显示在本条助手回复下方。若再次调用 generate_structured_health_card：raw_text 必须是你提炼后的医学要点，可选 oss_file_id 与消息中的 oss_file_id 一致，勿把完整 OCR 传给工具。"}}}, "revision": 1779329537139801, "created_at": "2026-05-21T02:12:17.000Z", "updated_at": "2026-05-21T02:12:17.000Z"}, {"node_role": "timeline", "id": "569906FB-22C4-522B-A325-DAA51B10E0E8", "status": "ready", "kind": "text", "order_key": 3000, "payload": {"text": {"_0": "已为您生成结构化处方健康卡片，本次处方相关信息如下：\n就诊人赵道凯（27岁男性）2026年4月20日于苏州大学附属第四医院皮肤科门诊就诊，诊断为结膜炎，开具两种滴眼液：\n1. 普拉洛芬滴眼液（普南扑灵）：5ml:5mg规格，共1盒，每日滴眼4次，每次1滴。\n2. 盐酸氮卓斯汀滴眼液（爱赛平）：6ml:3mg(0.05%)规格，共1盒，每日滴眼2次，每次1滴，开启后使用不可超过4周。\n请遵医嘱用药，用药期间若有不适请及时复诊。"}}, "revision": 1779329537138394, "created_at": "2026-05-21T02:12:17.000Z", "updated_at": "2026-05-21T02:12:17.000Z"}], "thread_max_tokens": 14096, "delivery_state": "pending", "thread_max_messages": 20, "thread_temperature": 0.6, "thread_id": "64F59424-3FC7-408F-86CD-A99276814506", "thread_top_p": 1, "client_message_id": "C85A1089-2C5A-4B34-8F13-256E2FABE593"}]}
