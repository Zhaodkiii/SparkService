INFO 2026-05-21 05:15:29,472 chat_sync.api_io [request_id=9A1FBDD8-3671-4F06-80AF-131395B0BBC1] HTTP 请求进入: POST /api/v1/ai/chat/sync/push/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MzQwOTAwLCJpYXQiOjE3NzkzMzkxMDAsImp0aSI6IjM5MjI5MmExNTA4MjRkMmViNmQ3ZDBkYTJlNjMzNmFlIiwidXNlcl9pZCI6IjQifQ.1LGwusrqKvyh5ztbtIoO5jJD3WQ_6vwGbmRwiPIWfa4", "X-Request-Id": "9A1FBDD8-3671-4F06-80AF-131395B0BBC1", "Content-Length": "1514"} body={"messages": [{"client_message_id": "E8C42685-F43D-42A8-803D-52669694EE5F", "role": "assistant", "thread_current_model_name": "deepseek-v4-pro", "tombstone": false, "thread_id": "D970EF21-E2BD-4036-9767-AFB23A93BEEA", "blocks": [{"revision": 1779340528715269, "updated_at": "2026-05-21T05:15:28.715Z", "id": "4D556FFC-9584-590A-8E07-0170E2706687", "kind": "text", "node_role": "timeline", "created_at": "2026-05-21T05:15:28.715Z", "payload": {"text": {"_0": "你好！我是你的高级健康助手，很高兴为你服务。\n\n我可以帮你做这些事情：\n\n- **管理健康资料**：上传体检报告、病历、处方等，我会帮你整理成结构化的健康卡片，方便随时查阅。\n- **解读医学报告**：如果你有检查报告看不懂，可以发给我，我来帮你解读。\n- **用药提醒与管理**：记录你的用药信息，帮你梳理用药计划。\n- **健康建议**：根据你提供的信息，给出针对性的健康指导。\n\n请告诉我你今天需要什么帮助？比如有报告要上传、有指标想了解，或者想记录用药情况？"}}, "status": "ready", "order_key": 1000}], "delivery_state": "sending", "thread_temperature": 0.6, "server_updated_at": "2026-05-21T05:15:28.716Z", "created_at": "2026-05-21T05:15:22.577Z", "thread_max_messages": 20, "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_max_tokens": 14096, "model_name": "deepseek-v4-pro", "thread_top_p": 1}]}
