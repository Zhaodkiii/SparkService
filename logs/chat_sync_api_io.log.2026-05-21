INFO 2026-05-21 04:56:46,460 chat_sync.api_io [request_id=3B2E3FB1-B6BE-4D18-AC07-3A00C0AE55DB] HTTP 请求进入: POST /api/v1/ai/chat/sync/push/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MzQwOTAwLCJpYXQiOjE3NzkzMzkxMDAsImp0aSI6IjM5MjI5MmExNTA4MjRkMmViNmQ3ZDBkYTJlNjMzNmFlIiwidXNlcl9pZCI6IjQifQ.1LGwusrqKvyh5ztbtIoO5jJD3WQ_6vwGbmRwiPIWfa4", "X-Request-Id": "3B2E3FB1-B6BE-4D18-AC07-3A00C0AE55DB", "Content-Length": "2092"} body={"messages": [{"thread_max_tokens": 14096, "tombstone": false, "thread_temperature": 0.6, "thread_id": "92FF9B7D-64D8-41C6-B401-E29CA3C7F502", "delivery_state": "sending", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "role": "user", "thread_top_p": 1, "thread_current_model_name": "deepseek-v4-pro", "thread_max_messages": 20, "client_message_id": "CEC6873C-20A3-4699-B68E-C393748639BF", "model_name": "user", "blocks": [{"status": "ready", "payload": {"text": {"_0": "【图片附件】file_id=528 file_uuid=f51fed66-9619-46cb-81c0-8ce68f74118f\\n【图片识别】\\n苏州大学附属第四医院\\n苏州市独墅湖医院\\n胃镜诊断报告单\\n姓名：赵道凯\\n性别：男\\n年龄：28 岁\\n申请科室：消化内科门诊\\n门诊号：0000349056\\n住院号：\\n床号：\\n病区：\\n检查项目：无痛电子胃镜（不含林醉费）\\n申请单号：260821105\\n①食管\\n②齿状线\\n③胃底\\n①胃体\\n⑤胃角\\n6胃窦\\n⑦十二指肠球部\\n⑧十二指肠降部\\n内镜所见：\\n食管：通过顺利，黏膜大致正常；\\n贵门：开合佳通畅；\\n胃底：黏膜正常；\\n胃体：见胆汁残留；\\n胃角：光整；\\n胃窦：黏膜红白相间，以红为主；\\n幽门：圆，开放好；\\n十二指肠球部及所见降部：未见明显异常。\\n诊断：\\n慢性非菱缩性胃炎伴胆汁反流\\n活检部位：\\n建议：\\n报告医生：健\\n审核医师：F26\\n报告时间：2026-02-10\\n备注：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告！\\n\\n【用户输入】\\n不要输出任何多余文字内容 \\n直接调用 generate_structured_health_card 带入合适的参数  其他都不要输出\\n只生成一份报告"}}, "revision": 1, "updated_at": "2026-05-21T04:56:45.000Z", "id": "F2F7BD2A-88B5-4155-B982-E1BB7CB7CB16", "kind": "text", "node_role": "timeline", "created_at": "2026-05-21T04:56:45.000Z"}], "created_at": "2026-05-21T04:56:45.753Z"}]}
