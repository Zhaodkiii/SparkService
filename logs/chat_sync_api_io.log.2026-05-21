INFO 2026-05-21 08:05:39,754 chat_sync.api_io [request_id=BE673A3D-FC56-4C91-B6CD-83690ECEE374] HTTP 请求进入: POST /api/v1/ai/chat/sync/push/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MzUxNDU2LCJpYXQiOjE3NzkzNDk2NTYsImp0aSI6IjQ5M2M5NjdhYzlkZjRiMDZhZTczOWQ4ZjQ1MzNmZTY1IiwidXNlcl9pZCI6IjQifQ.vE5VEXi0kbzIa4lR_Ph45lCMWSgV_hPlEg8Zc7CC-HU", "X-Request-Id": "BE673A3D-FC56-4C91-B6CD-83690ECEE374", "Content-Length": "2689"} body={"block_updates": [{"block": {"node_role": "toolPresentation", "payload": {"structured_health_cards": {"_0": {"medications": [], "exam_reports": [{"draft_json": "{\"attachment_file_ids\":[],\"category\":\"imaging\",\"content\":\"检查部位：颈椎椎间盘平扫+头颅平扫。影像所见：头颅CT平扫脑实质未见明显异常，各脑室形态大小正常，中线结构居中，小脑及脑干未见异常。鼻咽顶后壁软组织增厚。颈椎生理曲度平直，椎体缘骨质增生，C4\\/5、C5\\/6椎间盘稍向后突出，相邻硬膜囊稍受压，骨性椎管无明显狭窄。两侧颈部、颌下区多发小淋巴结。右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查；鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚。\",\"date\":\"2025-06-04\",\"details\":[{\"attachment_file_ids\":[],\"category\":\"影像学检查\",\"diagnosis\":\"1.头颅CT平扫未见明显异常，必要时MRI检查；鼻咽顶后壁软组织增厚，请结合专科检查。2.C4\\/5、C5\\/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚。\",\"result_value\":\"头颅CT平扫脑实质未见明显异常，各脑室形态大小正常，中线结构居中，小脑及脑干未见异常。鼻咽顶后壁软组织增厚。颈椎生理曲度平直，椎体缘骨质增生，C4\\/5、C5\\/6椎间盘稍向后突出，相邻硬膜囊稍受压，骨性椎管无明显狭窄。两侧颈部、颌下区多发小淋巴结。右侧声带相对稍厚。\",\"sort_order\":null,\"sub_category\":\"颈椎椎间盘平扫+头颅平扫\"}],\"hospital\":\"苏州工业园区星塘医院\",\"title\":\"颈椎椎间盘平扫+头颅平扫\"}", "member_id": 17, "hospital": "苏州工业园区星塘医院", "is_saved": true, "date_text": "2025-06-04", "title": "颈椎椎间盘平扫+头颅平扫", "oss_file_id": 547, "id": "CE5887AB-97CE-4A26-BE49-27F49BFE271A"}], "prescriptions": [], "medical_cases": []}}}, "anchor": {"value": "call_02_KHTxF6egpgfesR0Ihnxp1784", "type": "toolCall"}, "status": "ready", "id": "3282AAA3-9139-5CA1-BE37-B38E36EC0E6A", "order_key": 6100, "revision": 1779350409679229, "kind": "structuredHealthCards", "created_at": "2026-05-21T08:00:09.665Z", "parent_block_id": "6293D931-D7B9-5543-A2F4-F11A0F27B555", "updated_at": "2026-05-21T08:05:39.791Z", "parent_tool_call_id": "call_02_KHTxF6egpgfesR0Ihnxp1784", "tool_call_id": "call_02_KHTxF6egpgfesR0Ihnxp1784"}, "client_message_id": "71420AEC-C420-4910-B062-60CABBB63F7B", "thread_id": "24FECFC3-3E15-42F2-B7C0-980E2A793254"}]}
