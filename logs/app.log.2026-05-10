allID": "call_jhr6siwzsz83bf9p4bayehow", "id": "15FC0E56-C6CD-4730-B62C-C22D127BD80C", "kind": "sleepVisualization", "sleepVisualization": {"generatedAt": 1778311935, "schemaVersion": "health_sleep_v1", "days": [{"summary": {"startText": "23:27", "totalSleepMinutes": 33, "start": 1778254063, "end": 1778256202, "endText": "00:03"}, "stages": {"core": 33, "deep": 0, "rem": 0, "awake": 3, "unspecified": 0}, "timeline": [{"endText": "23:42", "end": 1778254967, "startText": "23:27", "stage": "core", "start": 1778254063, "widthPercent": 42.26273959794297, "startPercent": 0, "vitals": {"avgRespiratoryRate": 15.5, "avgHeartRate": 55.75, "maxHeartRate": 59, "minHeartRate": 54}}, {"endText": "23:45", "end": 1778255118, "startText": "23:42", "stage": "awake", "start": 1778254967, "widthPercent": 7.059373539036932, "startPercent": 42.26273959794297}, {"endText": "00:03", "end": 1778256202, "startText": "23:45", "stage": "core", "start": 1778255118, "widthPercent": 50.677886863020106, "startPercent": 49.322113136979894, "vitals": {"avgRespiratoryRate": 15, "avgHeartRate": 54.666666666666664, "maxHeartRate": 55, "minHeartRate": 54}}], "date": "2026-05-08"}]}, "updatedAt": "2026-05-09T07:32:15.386Z"}, {"updatedAt": "2026-05-09T07:32:42.849Z", "id": "14590FB4-65F9-4953-B56E-7D2A09558E15", "kind": "text", "text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "createdAt": "2026-05-09T07:32:39.463Z"}], "thread_top_p": 1, "role": "assistant", "tombstone": false, "thread_system_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "delivery_state": "pending", "thread_temperature": 0.6}, {"thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_id": "206170C4-0895-49E7-86A2-12C0893156F5", "thread_max_tokens": 4096, "model_name": "doubao-seed-2-0-pro-260215", "thread_current_model_name": "doubao-seed-2-0-pro-260215", "thread_max_me