"], "medications": [], "attachments": []}, {"id": 3, "member": 13, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "医院", "age_at_visit": 27, "diagnosis_summary": "test", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-10T05:01:57.072314Z", "updated_at": "2026-04-10T05:01:57.072423Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 1, "member": 13, "record_type": "ai_upload", "status": 2, "title": "AI Medical Upload", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "{\"title\":\"东部战区总医院处方笺\",\"summary\":\"患者王玉兰，女，56岁，自费，神经内科门诊患者，2025年6月27日于东部战区总医院开具此处方，取药药房为第二药房，临床初步诊断为高血压、高脂血症、腔隙性脑梗死、失眠，处方包含三种药品，药费共计55.52元，处方30天内有效，无标注需皮试的药品。\",\"diagnosis\":\"高血压、高脂血症、腔隙性脑梗死、失眠\",\"occurredAt\":\"2025-06-27\",\"rawType\":\"处方笺\",\"items\":[{\"name\":\"阿托伐他汀钙片\",\"specification\":\"20mg×4盒\",\"type\":\"市公乙（4+...", "extra": {"resolved_mode": "general", "requested_mode": "", "source_file_count": "1"}, "created_at": "2026-04-06T10:56:48.671156Z", "updated_at": "2026-04-06T13:37:28.583648Z", "symptoms": [], "medications": [], "attachments": []}], "health_exam_reports": [{"id": 3, "user": 1, "member": 13, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "", "exam_date": "2026-04-07", "exam_type": 1, "summary": null, "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-07T04:33:54.287077Z", "updated_at": "2026-04-07T04:33:54.287087Z", "attachments": []}, {"id": 2, "user": 1, "member": 13, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "", "exam_date": "2026-04-07", "exam_type": 1, "summary": null, "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-07T04:23:35.219351Z", "updated_at": "2026-04-07T04:23:35.219362Z", "attachments": []}, {"id": 1, "user": 1, "member": 13, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "", "exam_date": "2026-04-07", "exam_type": 1, "summary": null, "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-07T04:10:20.994895Z", "updated_at": "2026-04-07T04:10:20.994915Z", "attachments": []}, {"id": 12, "user": 1, "member": 13, "institution_name": "天长佳慈体检中心", "report_no": "106250624002", "exam_date": "2025-06-24", "exam_type": 1, "summary": "1. 超重：节制饮食，适量运动，控制体重。2. 血脂异常：积极控制诱发因素，定期复查。平时应注意控制主食量，保持低脂低糖饮食，忌烟酒，加强体育锻炼。若经严格生活干预，血脂仍明显异常，应在医生指导下药物降脂治疗。3. 高血压：在医生指导下按时服药，平时应低盐低脂饮食，适度有氧运动，控制体重，戒烟限酒，规律休息，监测血压。4. 多灶性腔隙性脑梗塞：必要时请MR检查。5. 副鼻窦炎：随诊。6. 牙结石：可以到医院口腔科做超声波洁治。7. 左侧叶甲状腺囊性结节TI-RADS分级2：定期复查超声，医院内分泌科或外科进一步检查。8. 肢体导联低电压：医院心内科随诊。9. T波改变：复查心电图，如有不适，应及时到医院就诊。平时避免疲劳、熬夜和酗酒。10. 两肺上叶慢性炎性病变：与老片比较，定期复查。11. 双侧乳腺增生：定期自我检查、乳腺超声或乳腺钼靶复查，必要时医院乳腺外科随诊。平时保持心情舒畅、劳逸结合、不过多服食含有激素的滋补品和长期使用含有激素成分的化妆品等。12. 胆囊息肉：定期复查肝胆超声，必要时肝胆外科就诊。13. 胆囊炎？：结合临床分析，定期复查。无症状者无需治疗，但应忌酒，避免油腻食物。如有不适，肝胆外科或消化内科诊治。14. 双肾尿盐结晶（多发）：平时多饮水，多运动，忌饮浓茶及碳酸饮料，定期复查超声，泌尿外科随诊。15. 腰椎骨质增生：戒烟限酒，睡硬板床，加强腰背肌锻炼，可适当理疗、推拿，必要时去骨科或康复科诊治。16. 间接胆红素升高：注意休息，多饮水，忌酒，复查相关项目或医院肝病专科就诊。17. 血流变异常：复查血流变。18. 乳酸脱氢酶偏高：可复查，必要时到医院检查。19. 红细胞平均血红蛋白浓度降低：复查血常规。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-14T01:02:37.307890Z", "updated_at": "2026-04-14T01:02:37.307914Z", "attachments": [{"id": 182, "file_uuid": "512ddbc6-d1e0-4737-ae15-183606acfd03", "original_name": "王玉兰_2025年06月24日_天长佳慈体检中心.pdf", "file_size": 3518319, "mime_type": "application/pdf", "file_md5": "00f6b9471e6b3ccdebe4ed55b50121a6", "business_type": "health_exam_report", "business_id": "12", "object_key": "SparkClient/20260414/512DDBC6-D1E0-4737-AE15-183606ACFD03/王玉兰_2025年06月24日_天长佳慈体检中心.pdf", "storage_type": "oss", "created_at": "2026-04-14T00:59:22.839886Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260414/512DDBC6-D1E0-4737-AE15-183606ACFD03/%E7%8E%8B%E7%8E%89%E5%85%B0_2025%E5%B9%B406%E6%9C%8824%E6%97%A5_%E5%A4%A9%E9%95%BF%E4%BD%B3%E6%85%88%E4%BD%93%E6%A3%80%E4%B8%AD%E5%BF%83.pdf"}]}, {"id": 7, "user": 1, "member": 13, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": null, "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-09T16:08:06.250688Z", "updated_at": "2026-04-09T16:08:06.250706Z", "attachments": []}], "examination_reports": [{"id": 28, "user": 1, "member": 13, "medical_record": 28, "category": "实验室检查", "sub_category": "", "item_name": "看看看看看", "performed_at": "2026-03-23T00:00:00Z", "reported_at": "2026-03-23T00:00:00Z", "organization_name": "发发发躲躲藏藏", "department_name": "", "doctor_name": "张继惠", "findings": "检测项目：甲状腺功能三项，条码号：226032352250，病人：胡月芳，病人号：3105737，标本类型：静脉血清，标本号：63，性别：女，床号：无，病人类型：门诊，申请医生：张继惠，年龄：50岁，科室：内分泌肾内科，诊断：水肿，备注：标*项目为山东省临床检验互认项目，“太”标识等同于“京津冀鲁HR”标识，本报告仅对所检测标本负责，供临床医生参考！", "impression": "检测项目：甲状腺功能三项，条码号：226032352250，病人：胡月芳，病人号：3105737，标本类型：静脉血清，标本号：63，性别：女，床号：无，病人类型：门诊，申请医生：张继惠，年龄：50岁，科室：内分泌肾内科，诊断：水肿，备注：标*项目为山东省临床检验互认项目，“太”标识等同于“京津冀鲁HR”标识，本报告仅对所检测标本负责，供临床医生参考！", "source": 1, "status": 1, "extra": {}, "created_at": "2026-04-11T20:24:54.441153Z", "updated_at": "2026-04-12T09:54:46.400211Z", "attachments": []}, {"id": 29, "user": 1, "member": 13, "medical_record": 29, "category": "影像学检查", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院 苏州市独墅湖医院", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T22:42:01.370490Z", "updated_at": "2026-04-11T22:42:01.370511Z", "attachments": []}, {"id": 25, "user": 1, "member": 13, "medical_record": 26, "category": "内镜报告", "sub_category": "", "item_name": "苏州大学附属第四医院胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡;予个你", "findings": "无痛电子胃镜检查（不含麻醉费），食管通过顺利，黏膜大致正常；贲门开合通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常。诊断为慢性非萎缩性胃炎伴胆汁反流。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T02:32:09.746750Z", "updated_at": "2026-04-11T02:32:09.746756Z", "attachments": []}, {"id": 30, "user": 1, "member": 13, "medical_record": 30, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属第四医院检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "魏和轩、王一發、魏雨轩、王一斐", "findings": "苏州大学附属第四医院检验报告单，标本为静脉血清，送检科室为口腔科门诊，临床印象为口腔黏膜溃疡，送检项目为生化检验、肾功能检，采样时间2025-12-28，核收时间2025-12-28，报告时间2025-12-28，申请医师朱孝明，本报告仅对所测标本负责，标注*的项目为江苏省检验互认项目。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T22:43:21.985558Z", "updated_at": "2026-04-11T22:43:21.985564Z", "attachments": []}, {"id": 27, "user": 1, "member": 13, "medical_record": 27, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属第四医院检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明,魏雨轩,王一斐", "findings": "姓名：赵道凯，性别：男，年龄：27岁1月，标本：静脉血清，条码号：22512283954:3，送检科室：口腔科门诊，门诊号：0000349056，临床印象：口腔黏膜溃疡，送检项目：生化检验，肾功能检，采样时间：2025-12-28，核收时间：2025-12-28，报告时间：2025-12-28，本报告仅对所测标本负责。标注*的项目为江苏省检验互认项目（苏眼）。注释：根据《中国血脂管理指南2023》降脂首要靶点-低密度脂蛋白胆固醇（LD1.-C）的目标值，建议结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。结果解释：TG、TC、IIDL-C、LDL-C、PL.（a）的参考范围源于《中国血脂管理指南2023》。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T20:23:57.750373Z", "updated_at": "2026-04-11T20:23:57.750383Z", "attachments": []}, {"id": 26, "user": 1, "member": 13, "medical_record": 27, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属第四医院检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明,魏和轩,王一發", "findings": "姓名：赵道凯，性别：男，年龄：27岁1月，标本：静脉血清，条码号：225122839543，送检科室：口腔科门