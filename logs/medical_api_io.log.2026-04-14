INFO 2026-04-14 00:56:35,005 medical.api_io [request_id=2357093B-8546-4AC4-BCB3-AF810F099A3E] HTTP 响应摘要: GET /api/v1/medical/resources/ status=200 duration_ms=13 bytes=6605 headers={"Content-Type": "application/json", "ETag": "\"a4e33bc2d0aa32437e1b6d80747c5f1f\"", "Cache-Control": "private, max-age=120", "Vary": "Accept", "Allow": "GET, POST, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": [{"id": 48, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无，专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院（苏州市独墅湖医院）消化内科门诊行无痛电子胃镜检查，胃镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-13T00:44:26.417196Z", "updated_at": "2026-04-13T00:44:26.417225Z"}, {"id": 47, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:46:39.137645Z", "updated_at": "2026-04-12T15:46:39.137664Z"}, {"id": 46, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:45:17.510906Z", "updated_at": "2026-04-12T15:45:17.510919Z"}, {"id": 45, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:44:55.091216Z", "updated_at": "2026-04-12T15:44:55.091244Z"}, {"id": 44, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "1. 窦性心动过缓：无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗，正规医院专科诊治。2. 甲状腺囊肿（多发）：建议专科治疗。3. 中性粒细胞百分数降低：粒细胞异常减少，建议及时复查，如果仍然异常，请尽早去医院，查明原因。4. 淋巴细胞百分数增高：淋巴细胞异常，建议复查，如果仍然异常，请尽早去医院，查明原因。5. 血小板压积增高：血小板压积异常，建议复查，如果仍然异常，请去医院，查明原因。6. 血小板计数增高：血小板计数异常，建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "extra": {"exam_type": "单位体检", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:37:32.955125Z", "updated_at": "2026-04-12T15:37:32.955170Z"}, {"id": 43, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "用药记录 (3项药品)", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"source": "medication_only"}, "created_at": "2026-04-12T14:59:13.289223Z", "updated_at": "2026-04-12T14:59:13.289246Z"}, {"id": 42, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "处方: 高血压、高脂血症、腔隙性脑梗死、失眠", "hospital_name": "东部战区总医院", "age_at_visit": null, "diagnosis_summary": "高血压、高脂血症、腔隙性脑梗死、失眠", "extra": {"batch_no": "7303148447", "occurred_at": "2025-06-27"}, "created_at": "2026-04-12T14:58:17.860263Z", "updated_at": "2026-04-12T14:58:17.860299Z"}, {"id": 41, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无。专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。2025年12月28日行生化检验、肾功能检验，临床印象为口腔黏膜溃疡，检验结果大致正常。处方包含卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T12:38:29.016437Z", "updated_at": "2026-04-12T12:38:29.016462Z"}, {"id": 37, "user": 1, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史无慢性疾病史，过敏史无，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院行无痛电子胃镜检查，内镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T10:27:41.963334Z", "updated_at": "2026-04-12T10:27:41.963346Z"}]}
