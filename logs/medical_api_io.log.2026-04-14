{"id": 148, "file_uuid": "4422a4c2-002d-4e62-9bac-9fe8f0dbc31e", "original_name": "photo_0B8D3F2C-0FA0-488C-BDC6-EF86BF680906.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "36", "object_key": "SparkClient/20260412/4422A4C2-002D-4E62-9BAC-9FE8F0DBC31E/photo_0B8D3F2C-0FA0-488C-BDC6-EF86BF680906.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:16:37.014990Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/4422A4C2-002D-4E62-9BAC-9FE8F0DBC31E/photo_0B8D3F2C-0FA0-488C-BDC6-EF86BF680906.jpg"}]}, {"id": 35, "member": 15, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无。专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿。2025年12月28日行生化检验、肾功能检验，结果大致正常。2026年2月10日行无痛电子胃镜检查，示胃体见胆汁残留，诊断慢性非萎缩性胃炎伴胆汁反流。处方卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T06:06:22.015088Z", "updated_at": "2026-04-12T06:06:22.015100Z", "symptoms": ["口腔检查要求"], "medications": ["伊ffe", "克霉唑阴道膨胀栓", "卢立康唑乳膏", "伊曲康唑分散片"], "attachments": [{"id": 135, "file_uuid": "52e9ef80-9f78-4030-8009-470ce956e069", "original_name": "photo_9FF8629B-0194-47AB-A6DA-7591BED44E7D.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "35", "object_key": "SparkClient/20260412/52E9EF80-9F78-4030-8009-470CE956E069/photo_9FF8629B-0194-47AB-A6DA-7591BED44E7D.jpg", "storage_type": "oss", "created_at": "2026-04-12T06:01:43.803605Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/52E9EF80-9F78-4030-8009-470CE956E069/photo_9FF8629B-0194-47AB-A6DA-7591BED44E7D.jpg"}, {"id": 134, "file_uuid": "6dbaf17b-3db6-4896-ae04-1bc9