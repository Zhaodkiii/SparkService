t": null, "organization_name": "苏州美健奥亚健康体检中心", "department_name": "", "doctor_name": "", "findings": null, "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T15:37:33.060182Z", "updated_at": "2026-04-12T15:37:33.060192Z", "attachments": []}, {"id": 57, "user": 1, "member": 16, "medical_record": 44, "category": "尿常规", "sub_category": "", "item_name": "尿常规检查", "performed_at": "2023-01-08T00:00:00Z", "reported_at": null, "organization_name": "苏州美健奥亚健康体检中心", "department_name": "", "doctor_name": "", "findings": null, "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T15:37:33.021935Z", "updated_at": "2026-04-12T15:37:33.021947Z", "attachments": []}, {"id": 56, "user": 1, "member": 16, "medical_record": 44, "category": "外科", "sub_category": "", "item_name": "外科检查", "performed_at": "2023-01-08T00:00:00Z", "reported_at": null, "organization_name": "苏州美健奥亚健康体检中心", "department_name": "", "doctor_name": "", "findings": null, "impression": "1. 窦性心动过缓：无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗，正规医院专科诊治。2. 甲状腺囊肿（多发）：建议专科治疗。3. 中性粒细胞百分数降低：粒细胞异常减少，建议及时复查，如果仍然异常，请尽早去医院，查明原因。4. 淋巴细胞百分数增高：淋巴细胞异常，建议复查，如果仍然异常，请尽早去医院，查明原因。5. 血小板压积增高：血小板压积异常，建议复查，如果仍然异常，请去医院，查明原因。6. 血小板计数增高：血小板计数异常，建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T15:37:32.964349Z", "updated_at": "2026-04-12T15:37:32.964358Z", "attachments": []}, {"id": 55, "user": 1, "member": 16, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明、魏和轩、王一發、魏雨轩、王一斐", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-12T15:15:37.241891Z", "updated_at": "2026-04-12T15:15:37.241910Z", "attachments": [{"id": 162, "file_uuid": "d8d80804-a19b-4785-a626-cdb939d1b032", "original_nam