rmed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡;予个你", "findings": "无痛电子胃镜检查（不含麻醉费），食管通过顺利，黏膜大致正常；贲门开合通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常。诊断为慢性非萎缩性胃炎伴胆汁反流。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T02:32:09.746750Z", "updated_at": "2026-04-11T02:32:09.746756Z", "attachments": []}, {"id": 30, "user": 1, "member": 13, "medical_record": 30, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属第四医院检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "魏和轩、王一發、魏雨轩、王一斐", "findings": "苏州大学附属第四医院检验报告单，标本为静脉血清，送检科室为口腔科门诊，临床印象为口腔黏膜溃疡，送检项目为生化检验、肾功能检，采样时间2025-12-28，核收时间2025-12-28，报告时间2025-12-28，申请医师朱孝明，本报告仅对所测标本负责，标注*的项目为江苏省检验互认项目。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T22:43:21.985558Z", "updated_at": "2026-04-11T22:43:21.985564Z", "attachments": []}, {"id": 27, "user": 1, "member": 13, "medical_record": 27, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属第四医院检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明,魏雨轩,王一斐", "findings": "姓名：赵道凯，性别：男，年龄：27岁1月，标本：静脉血清，条码号：22512283954:3，送检科室：口腔科门诊，门诊号：0000349056，临床印象：口腔黏膜溃疡，送检项目：生化检验，肾功能检，采样时间：2025-12-28，核收时间：2025-12-28，报告时间：2025-12-28，本报告仅对所测标本负责。标注*的项目为江苏省检验互认项目（苏眼）。注释：根据《中国血脂管理指南2023》降脂首要靶点-低密度脂蛋白胆固醇（LD1.-C）的目标值，建议结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。结果解释：TG、TC、IIDL-C、LDL-C、PL.（a）的参考范围源于《中国血脂管理指南2023》。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-11T20:23:57.750373Z", "updated_at": "2026-04-11T20:23:57.750383Z", "attachments": []}, {"id": 26, "user": 1, "member": 13, "medical_record": 27, "category": "实验室检查", "sub_category": "", "item_name": "苏州大学附属