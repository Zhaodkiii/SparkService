INFO 2026-04-14 00:57:52,642 medical.api_io [request_id=5F76C4E5-27B4-4F90-9882-14A4A4146B8E] HTTP 响应摘要: GET /api/v1/medical/members/13/complete-data/ status=200 duration_ms=105 bytes=58957 headers={"Content-Type": "application/json", "ETag": "\"55fca258f7eabd86231178887a18f8e8\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 13, "member": {"id": 13, "user": 1, "name": "发发发", "gender": "male", "relationship": "self", "birth_date": "1993-04-05", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-05T02:20:48.072504Z", "updated_at": "2026-04-06T13:37:28.582288Z"}, "medical_cases": [{"id": 30, "member": 13, "record_type": "custom", "status": 1, "title": "苏州大学附属第四医院检验报告单", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": null, "diagnosis_summary": "苏州大学附属第四医院检验报告单，标本为静脉血清，送检科室为口腔科门诊，临床印象为口腔黏膜溃疡，送检项目为生化检验、肾功能检，采样时间2025-12-28，核收时间2025-12-28，报告时间2025-12-28，申请医师朱孝明，本报告仅对所测标本负责，标注*的项目为江苏省检验互认项目。", "extra": {"occurred_at": "2025-12-28"}, "created_at": "2026-04-11T22:43:21.982256Z", "updated_at": "2026-04-11T22:43:21.982270Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 29, "member": 13, "record_type": "custom", "status": 1, "title": "胃镜诊断报告单", "hospital_name": "苏州大学附属第四医院 苏州市独墅湖医院", "age_at_visit": null, "diagnosis_summary": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "extra": {"occurred_at": "2026-02-10"}, "created_at": "2026-04-11T22:42:01.358030Z", "updated_at": "2026-04-11T22:42:01.358057Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 28, "member": 13, "record_type": "custom", "status": 1, "title": "阳谷县人民医院检验报告单", "hospital_name": "阳谷县人民医院", "age_at_visit": null, "diagnosis_summary": "检测项目：甲状腺功能三项，条码号：226032352250，病人：胡月芳，病人号：3105737，标本类型：静脉血清，标本号：63，性别：女，床号：无，病人类型：门诊，申请医生：张继惠，年龄：50岁，科室：内分泌肾内科，诊断：水肿，备注：标*项目为山东省临床检验互认项目，“太”标识等同于“京津冀鲁HR”标识，本报告仅对所检测标本负责，供临床医生参考！", "extra": {"occurred_at": "2026-03-23"}, "created_at": "2026-04-11T20:24:54.435633Z", "updated_at": "2026-04-11T20:24:54.435655Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 27, "member": 13, "record_type": "custom", "status": 1, "title": "苏州大学附属第四医院检验报告单", "hospital_name": "苏州大学附属第四医院、苏州市独墅湖医院", "age_at_visit": null, "diagnosis_summary": "姓名：赵道凯，性别：男，年龄：27岁1月，标本：静脉血清，条码号：225122839543，送检科室：口腔科门诊，门诊号：0000349056，临床印象：口腔黏膜溃疡，送检项目：生化检验，肾功能检，采样时间：2025-12-28，核收时间：2025-12-28，报告时间：2025-12-28，本报告仅对所测标本负责。标注*的项目为江苏省检验互认项目（苏HR）。", "extra": {"occurred_at": "2025-12-28"}, "created_at": "2026-04-11T20:23:57.640503Z", "updated_at": "2026-04-11T20:23:57.640530Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 26, "member": 13, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日生，2026年2月6日因要求口腔检查1天至苏州大学附属第四医院口腔科门诊初诊，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙。2025年12月28日送检生化及肾功能检验，2026年2月10日行无痛电子胃镜检查，提示慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-11T02:32:09.653580Z", "updated_at": "2026-04-11T02:32:09.653622Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 111, "file_uuid": "d389655e-242b-48f9-ac6a-26ad4d1f4d77", "original_name": "photo_314C5AB3-01A5-41A4-B234-073A3344A77D.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "26", "object_key": "SparkClient/20260411/D389655E-242B-48F9-AC6A-26AD4D1F4D77/photo_314C5AB3-01A5-41A4-B234-073A3344A77D.jpg", "storage_type": "oss", "created_at": "2026-04-11T02:31:10.855014Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260411/D389655E-242B-48F9-AC6A-26AD4D1F4D7