_uuid": "daccdcb8-7a33-4300-b34d-163acbb51b6f", "original_name": "photo_8C298F91-1FE4-49ED-806A-550B4EF91E7E.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "37", "object_key": "SparkClient/20260412/DACCDCB8-7A33-4300-B34D-163ACBB51B6F/photo_8C298F91-1FE4-49ED-806A-550B4EF91E7E.jpg", "storage_type": "oss", "created_at": "2026-04-12T05:58:45.025775Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/DACCDCB8-7A33-4300-B34D-163ACBB51B6F/photo_8C298F91-1FE4-49ED-806A-550B4EF91E7E.jpg"}, {"id": 129, "file_uuid": "d89ec78c-aeb8-4bb2-937d-b7f76be1583d", "original_name": "photo_C8B667C0-5A27-46FE-8450-2602551CC562.jpg", "file_size": 257804, "mime_type": "image/jpeg", "file_md5": "44f8d8069415467a3e082fe9677ba831", "business_type": "examination_report", "business_id": "37", "object_key": "SparkClient/20260412/D89EC78C-AEB8-4BB2-937D-B7F76BE1583D/photo_C8B667C0-5A27-46FE-8450-2602551CC562.jpg", "storage_type": "oss", "created_at": "2026-04-12T05:58:44.621075Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/D89EC78C-AEB8-4BB2-937D-B7F76BE1583D/photo_C8B667C0-5A27-46FE-8450-2602551CC562.jpg"}]}, {"id": 44, "user": 1, "member": 15, "medical_record": 36, "category": "imaging", "sub_category": "", "item_name": "2胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": "2026-02-10T00:00:00Z", "organization_name": "1苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "1内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非菱缩性胃炎伴胆汁反流。活检部位：无。建议：无。", "impression": "1内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非菱缩性胃炎伴胆汁反流。活检部位：无。建议：无。", "source": 1, "status": 1, "extra": {}, "created_at": "2026-04-12T10:16:58.747532Z", "updated_at": "2026-04-12T10:40:14.042352Z", "attachments": []}, {"id": 43, "user": 1, "member": 15, "medical_record": 35, "category": "imaging", "sub_category": "", "item_name": "苏州大学附属第四医院胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡、予个你", "findings": "无痛电子胃镜（不含麻醉费）检查报告，食管通过顺利，黏膜大致正常；贲门开合伟通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常，诊断慢性非萎缩性胃炎伴胆汁反流，报告时间2026-02-10，备注若有病理请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T06:06:22.084470Z", "updated_at": "2026-04-12T06:06:22.084485Z", "attachments": []}, {"id": 41, "user": 1, "member": 15, "medical_record": 34, "category": "laboratory", "sub_category": "", "item_name": "检验", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "医院", "department_name": "", "doctor_name": "魏和轩", "findings": "f", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T06:06:10.786362Z", "updated_at": "2026-04-12T06:06:10.786366Z", "attachments": []}, {"id": 36, "user": 1, "member": 15, "medical_record": null, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院、苏州市独墅湖医院", "department_name": "", "doctor_name": "欧啡、予个你", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-12T05:59:24.310299Z", "updated_at": "2026-04-12T05:59:24.310316Z", "attachments": []}, {"id": 34, "user": 1, "member": 15, "medical_record": null, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院 苏州市独墅湖医院", "department_name": "", "doctor_name": "欧啡", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-12T05:49:27.489578Z", "updated_at": "2026-04-12T05:49:27.489