INFO 2026-04-18 05:54:43,137 chat_sync.sync [request_id=6E3F3447-7874-4203-94E1-6106B56B33FE] chat push payload request_id=6E3F3447-7874-4203-94E1-6106B56B33FE user_id=6 content_type=application/json body={"messages":[{"thread_id":"f241630a-1602-409d-bf0e-8f51ccc5463c","role":"user","kind":"text","content":"轻武器","client_message_id":"6f267117-0748-4489-9f88-049b6e668b2b","delivery_state":"pending","created_at":"2026-04-18 05:54:43.134000+00:00","tombstone":false,"attachments":[],"reasoning_expanded":false,"reasoning_visibility":"full"}]}
