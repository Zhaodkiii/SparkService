INFO 2026-04-25 16:25:46,169 accounts.api_io [request_id=6B8FF376-95A0-46AB-9DA9-305ED06CC2C1] HTTP 响应摘要: GET /api/v1/ai/chat/sync/pull/ status=200 duration_ms=10 bytes=7210 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "ok", "data": {"cursor": "v2:eyJ0cyI6IjIwMjYtMDQtMjRUMDg6Mjc6MzkuNDU5MjE2KzAwOjAwIiwiaWQiOiIxNTkwIn0", "messages": [{"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "把vv", "model_name": null, "client_message_id": "6ed345ee-9b4f-47ad-9d3a-08c43893515f", "server_message_id": "7e19abce-2674-4f67-aea3-dd5515216a7f", "delivery_state": "sent", "created_at": "2026-04-24T08:05:53.436000+00:00", "server_updated_at": "2026-04-24T08:05:53.578299+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "system", "kind": "system", "content": "🛑 响应已打断", "model_name": null, "client_message_id": "2be78681-2f17-404d-a913-b0fe5753d8df", "server_message_id": "c1a81229-8f7c-4df7-96eb-b40403791fff", "delivery_state": "sent", "created_at": "2026-04-24T08:07:21.153000+00:00", "server_updated_at": "2026-04-24T08:07:34.723922+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "你好", "model_name": null, "client_message_id": "6aa76a65-86f9-4bf4-ab8e-cf95e7521d76", "server_message_id": "da3260c6-2688-4cec-a40c-aa51e73c757b", "delivery_state": "sent", "created_at": "2026-04-24T08:07:34.662000+00:00", "server_updated_at": "2026-04-24T08:07:34.733270+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "assistant", "kind": "text", "content": "你好😊 我是Spark健康助手，请问你有什么健康相关的问题需要咨询吗？比如日常保健、饮食运动建议、常见不适应对等，都可以和我说~", "model_name": null, "client_message_id": "cb2fbec7-b11e-4463-afa6-f3a06bfda30b", "server_message_id": "cc0447a6-2c3b-4b41-aed9-3c3a6379f207", "delivery_state": "sent", "created_at": "2026-04-24T08:07:38.405000+00:00", "server_updated_at": "2026-04-24T08:07:38.640310+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "吧宝贝", "model_name": null, "client_message_id": "865366ee-8ba2-4dc5-8506-c9c4cc5ad653", "server_message_id": "edc005b3-bcf5-4793-bea7-6de497cf6fc6", "delivery_state": "sent", "created_at": "2026-04-24T08:08:57.443000+00:00", "server_updated_at": "2026-04-24T08:08:57.532937+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "assistant", "kind": "text", "content": "😊 如果你有健康相关的疑问，比如饮食调整、运动建议、轻微不适处理或者健康知识科普需求，都可以具体说一下哦，我会尽力给你准确实用的建议~", "model_name": null, "client_message_id": "c0678cb8-e043-4777-ac09-6218edd98038", "server_message_id": "7223e915-0942-414d-adda-3989924041eb", "delivery_state": "sent", "created_at": "2026-04-24T08:09:00.902000+00:00", "server_updated_at": "2026-04-24T08:09:00.973515+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "不不不不", "model_name": null, "client_message_id": "86b47693-d140-4880-bf42-d7f47e2fbf47", "server_message_id": "f623cc46-80ac-4245-b12d-c9d9284f96e2", "delivery_state": "sent", "created_at": "2026-04-24T08:20:48.301000+00:00", "server_updated_at": "2026-04-24T08:20:48.404450+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "assistant", "kind": "text", "content": "如果暂时没有健康相关的问题也没关系~ 之后有任何健康类的疑问，随时找我就可以啦😉", "model_name": null, "client_message_id": "5fe53de5-f57e-4336-8e53-8a63405fda5a", "server_message_id": "87c6b95e-5e06-4bab-a6fd-6b899a1951a3", "delivery_state": "sent", "created_at": "2026-04-24T08:20:51.321000+00:00", "server_updated_at": "2026-04-24T08:20:51.364990+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "不好给宝宝", "model_name": null, "client_message_id": "c7c59db0-3a84-44e5-8141-f4cc80e0512e", "server_message_id": "24dde84f-80a3-4d44-83f1-2722a0f2d19f", "delivery_state": "sent", "created_at": "2026-04-24T08:25:21.428000+00:00", "server_updated_at": "2026-04-24T08:25:21.555751+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "assistant", "kind": "text", "content": "你是想咨询关于宝宝护理、喂养或者健康相关的问题吗？可以把具体情况说清楚哦，比如宝宝年龄、遇到的具体问题（比如辅食添加、常见不适护理之类的），我会给你针对性的实用建议~", "model_name": null, "client_message_id": "edc5ae87-57d0-4814-95e6-bf663da982db", "server_message_id": "cc480aea-f57b-4b6b-9e9a-b5a61e028a36", "delivery_state": "sent", "created_at": "2026-04-24T08:25:25.681000+00:00", "server_updated_at": "2026-04-24T08:25:25.858293+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "user", "kind": "text", "content": "你看看看 你呀", "model_name": null, "client_message_id": "c2e99198-c3a5-4d28-8701-59f514231b77", "server_message_id": "05f74836-c96d-4012-9685-d950dc200697", "delivery_state": "sent", "created_at": "2026-04-24T08:27:35.392000+00:00", "server_updated_at": "2026-04-24T08:27:35.452500+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "3d72466e-135b-40ed-83c6-fdf8343c2a49", "role": "assistant", "kind": "text", "content": "哈哈，如果是有具体的健康相关问题，不管是成人还是宝宝的，都可以把详细情况告诉我哦，我会尽力帮你梳理靠谱的可执行建议~", "model_name": null, "client_message_id": "9ee0ec63-3d33-4032-9807-adab581e066e", "server_message_id": "a4526057-43b1-4195-8e5f-e8574aeb4858", "delivery_state": "sent", "created_at": "2026-04-24T08:27:39.284000+00:00", "server_updated_at": "2026-04-24T08:27:39.459216+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}], "has_more": false}}
