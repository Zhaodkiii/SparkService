y": "bd50d9ce-563c-4b45-bc11-bba75a87835f/IMG_1825.jpeg", "fileMd5": "6043d9b74d98d1c12a0fba40a506c8db"}], "role": "user", "reasoning_visibility": "full", "thread_temperature": 0.6, "thread_current_model_name": "doubao-seed-2-0-pro-260215", "client_message_id": "0F40191E-83E8-40B6-BC54-A297D74AEE6F", "delivery_state": "pending", "tombstone": false, "thread_max_tokens": 4096, "content": "这是什么", "thread_top_p": 1, "created_at": "2026-04-25T16:22:33.660Z", "kind": "text", "model_name": "user", "thread_id": "83EA944D-7291-4BAE-ACB4-767B52EE00FB", "thread_max_messages": 20}]}
