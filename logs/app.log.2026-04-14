INFO 2026-04-14 00:53:40,419 accounts.api_io [request_id=7615CE54-1F56-468F-8D7A-7477412E455C] HTTP 响应摘要: GET /api/v1/ai/chat/sync/pull/ status=200 duration_ms=4 bytes=1323 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "ok", "data": {"cursor": "v2:eyJ0cyI6IjIwMjYtMDQtMDRUMjI6NDI6MjQuNDMwMDM2KzAwOjAwIiwiaWQiOiI2NzkifQ", "messages": [{"thread_id": "4b478e47-069b-4329-86ee-0ea9d73b92bd", "role": "user", "kind": "text", "content": "你好", "client_message_id": "6f2f62d6-cace-4839-8127-e83740114c85", "server_message_id": "110f4807-0b09-4b53-be21-cba5dd17d0a9", "delivery_state": "sent", "created_at": "2026-04-04T22:42:17.658000+00:00", "server_updated_at": "2026-04-04T22:42:21.915476+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "4b478e47-069b-4329-86ee-0ea9d73b92bd", "role": "assistant", "kind": "text", "content": "你好呀😊我是你的专属健康助手Spark，不管是运动规划、饮食营养建议、睡眠质量分析，还是健康相关疑问咨询，我都可以帮到你~ 有什么需要帮忙的吗？", "client_message_id": "ca0ae54e-3948-4356-a9f3-0874e3ee47aa", "server_message_id": "174e0771-86fb-455e-9cdf-59caf086d653", "delivery_state": "sent", "created_at": "2026-04-04T22:42:24.407000+00:00", "server_updated_at": "2026-04-04T22:42:24.430036+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}], "has_more": false}}
