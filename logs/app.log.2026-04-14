INFO 2026-04-14 00:53:40,502 accounts.api_io [request_id=50677BAF-E87B-4A29-BC27-EF9E515A3A95] HTTP 响应摘要: GET /api/v1/ai/chat/sync/pull/ status=200 duration_ms=4 bytes=1276 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "ok", "data": {"cursor": "v2:eyJ0cyI6IjIwMjYtMDQtMDVUMDM6Mzg6MzguMDg1NTI5KzAwOjAwIiwiaWQiOiI3MTAifQ", "messages": [{"thread_id": "149263f3-7c9f-45a6-9041-0e52bd75082a", "role": "user", "kind": "text", "content": "你好", "client_message_id": "cb0c11a9-8e1a-43b4-b12a-e97e823b076b", "server_message_id": "e5c37123-5035-4485-ab30-3b21b8e587c7", "delivery_state": "sent", "created_at": "2026-04-05T03:38:32.179000+00:00", "server_updated_at": "2026-04-05T03:38:38.076101+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "149263f3-7c9f-45a6-9041-0e52bd75082a", "role": "assistant", "kind": "text", "content": "你好呀😊 我是你的专属健康助手，不管是运动规划、饮食建议、睡眠调整还是健康相关的疑问，都可以随时和我说哦~", "client_message_id": "ecc4bcfa-45b8-415a-ade8-684e6b4ae63e", "server_message_id": "50308a78-32f7-4cc8-894b-56c938eb866c", "delivery_state": "sent", "created_at": "2026-04-05T03:38:38.052000+00:00", "server_updated_at": "2026-04-05T03:38:38.085529+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}], "has_more": false}}
