INFO 2026-04-14 00:53:40,127 accounts.api_io [request_id=70E12BD8-69D2-4F59-BA45-59B9DE4A0F1C] HTTP 响应摘要: GET /api/v1/ai/chat/sync/pull/ status=200 duration_ms=8 bytes=3087 headers={"Content-Type": "application/json", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "ok", "data": {"cursor": "v2:eyJ0cyI6IjIwMjYtMDQtMDRUMTM6MTQ6MzcuMzc5ODE1KzAwOjAwIiwiaWQiOiI2MjMifQ", "messages": [{"thread_id": "49497a0e-2a62-4d0f-a2e6-3b33f8fe46ce", "role": "user", "kind": "text", "content": "你好呀", "client_message_id": "3fa82960-82e3-4c98-8c17-db6f089d839a", "server_message_id": "596d4d81-cff5-495d-915e-b08e26517868", "delivery_state": "sent", "created_at": "2026-04-04T13:13:50.049000+00:00", "server_updated_at": "2026-04-04T13:13:57.866275+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "49497a0e-2a62-4d0f-a2e6-3b33f8fe46ce", "role": "assistant", "kind": "text", "content": "你好😊我是Spark健康助手，如果你有健康科普、日常养生、饮食运动指导、常见症状相关的疑问，都可以随时告诉我哦~\n如果出现突发急症/严重不适，请第一时间前往附近正规医疗机构就诊，避免耽误病情。", "client_message_id": "26324136-09c5-4fd2-b5e1-5a312c233a00", "server_message_id": "862016db-afee-4628-8785-10c154ef0423", "delivery_state": "sent", "created_at": "2026-04-04T13:13:57.893000+00:00", "server_updated_at": "2026-04-04T13:13:57.874089+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "49497a0e-2a62-4d0f-a2e6-3b33f8fe46ce", "role": "user", "kind": "text", "content": "你会做什么", "client_message_id": "23c899fa-156d-41db-a213-fe42f8f3a3c1", "server_message_id": "bd259f66-39e1-4052-a27e-e185b7fb789d", "delivery_state": "sent", "created_at": "2026-04-04T13:14:21.572000+00:00", "server_updated_at": "2026-04-04T13:14:37.373803+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "49497a0e-2a62-4d0f-a2e6-3b33f8fe46ce", "role": "assistant", "kind": "text", "content": "我可以为你提供这些健康相关的帮助哦：\n1. 日常健康指导：比如不同人群的饮食搭配建议、适合普通人的运动方案、作息调整、日常养生科普等；\n2. 常见问题答疑：比如感冒、轻微腹泻、颈肩劳损这类常见小不适的家庭护理建议、常用药的使用注意事项科普等；\n3. 健康误区辟谣：可以帮你辨别网上流传的健康类伪科普、不靠谱的偏方。\n\n⚠️注意哦：我不能替代执业医师做疾病诊断、开处方，如果出现突发剧痛、持续严重不适，请第一时间前往正规医疗机构就诊，避免耽误病情。\n你有什么具体的健康相关问题都可以告诉我~", "client_message_id": "2951e742-217b-44eb-a888-5a1837989575", "server_message_id": "6dfc7302-ecb1-49e1-9c3d-6a36e14d5b18", "delivery_state": "sent", "created_at": "2026-04-04T13:14:37.372000+00:00", "server_updated_at": "2026-04-04T13:14:37.379815+00:00", "tombstone": false, "attachments": [], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}], "has_more": false}}
