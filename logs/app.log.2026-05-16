3:45", "end": 1778255118, "stage": "awake", "start": 1778254967, "startText": "23:42", "widthPercent": 7.059373539036932, "startPercent": 42.26273959794297}, {"endText": "00:03", "vitals": {"minHeartRate": 54, "avgRespiratoryRate": 15, "maxHeartRate": 55, "avgHeartRate": 54.666666666666664}, "end": 1778256202, "stage": "core", "start": 1778255118, "startText": "23:45", "widthPercent": 50.677886863020106, "startPercent": 49.322113136979894}], "date": "2026-05-08", "stages": {"deep": 0, "core": 33, "rem": 0, "awake": 3, "unspecified": 0}}], "generatedAt": 1778311935, "schemaVersion": "health_sleep_v1"}, "updatedAt": "2026-05-09T07:32:15.386Z", "createdAt": "2026-05-09T07:32:15.386Z", "toolCallID": "call_jhr6siwzsz83bf9p4bayehow", "kind": "sleepVisualization"}, {"text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "kind": "text", "createdAt": "2026-05-09T07:32:39.463Z", "updatedAt": "2026-05-09T07:32:42.849Z", "id": "14590FB4-65F9-4953-B56E-7D2A09558E15"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "206170c4-0895-49e7-86a2-12c0893156f5", "role": "assistant", "model_name": "doubao-seed-2-0-pro-260215", "client_message_id": "9f8ac741-d784-4f19-ad53-cebf3466c8b2", "server_message_id": "e89f9ecf-aedc-4a85-a631-5023f38068ef", "delivery_state": "sent", "created_at": "2026-05-09T14:20:45.375000+00:00", "server_updated_at": "2026-05-16T02:36:10.948021+00:00", "tombstone": false, "attachments": [], "blocks": [{"text": "你好！我是你的专属健康助手 Spark，不管是运动、饮食、睡眠、健康管理相关的疑问，还是日程规划、知识查询等需求，都可以随时和我说哦~", "kind": "text", "createdAt": "2026-05-09T14:20:49.698Z", "updatedAt": "2026-05-09T14:20:51.028Z", "id": "652030BA-66B6-461F-9B24-B721F0706E4E"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "e9d64c1a-2ac7-4247-a3c6-a5c6d417a289", "role": "assistant", "model_name": "agent-9FED8574-F971-4443-9975-83F240BF5946", "client_message_id": "29985259-a730-4d6b-b386-b15d7cf54796", "server_message_id": "d0698490-a2b9-4b4d-af4a-98d9d4f8c9da", "delivery_state": "sent", "created_at": "2026-05-15T10:39:37.291000+00:00", "server_updated_at": "2026-05-16T02:36:10.954003+00:00", "tombstone": false, "attachments": [], "blocks": [{"text": "你好呀！我是你的健康助手，有什么可以帮你的吗？比如查询运动数据、睡眠质量，或者制定饮食计划都可以告诉我~", "kind": "text", "createdAt": "2026-05-15T10:39:38.769Z", "updatedAt": "2026-05-15T10:39:39.361Z", "id": "07E9E9CA-4B08-440C-86E2-DA8C30179FEE"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}]}}
