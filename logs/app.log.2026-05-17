43", "server_message_id": "d05f7d82-1d7f-4fc6-8674-73879a16090c", "delivery_state": "sent", "created_at": "2026-05-18T05:48:11.110000+00:00", "server_updated_at": "2026-05-18T05:48:11.186198+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "873B265E-4F19-4EA7-805F-5C9C28BC2B9E", "kind": "text", "text": "哈哈", "created_at": "2026-05-18T05:48:11.000Z", "updated_at": "2026-05-18T05:48:11.000Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "ed8adf40-f726-4af7-a1a4-533f8766be67", "role": "assistant", "model_name": "doubao-seed-2-0-pro-260215", "client_message_id": "59e6d379-c362-4402-86af-148289622963", "server_message_id": "8886c3dd-09ad-4521-949b-9188750b8bca", "delivery_state": "sent", "created_at": "2026-05-18T05:48:14.646000+00:00", "server_updated_at": "2026-05-18T05:48:18.898473+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "44B5E007-D122-49AD-8465-BE6C12AE7286", "kind": "text", "text": "😊 有什么我可以帮到你的吗？比如：\n▫️ 查看最近的步数/热量消耗情况\n▫️ 分析近期的饮食营养结构\n▫️ 评估睡眠质量和调整建议\n▫️ 查找健康相关的知识科普\n▫️ 创建日历提醒或健康任务\n随时说你的需求就可以啦~", "created_at": "2026-05-18T05:48:12.000Z", "updated_at": "2026-05-18T05:48:14.000Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "ed8adf40-f726-4af7-a1a4-533f8766be67", "role": "user", "model_name": "user", "client_message_id": "187a9423-78ab-4a8a-9555-83ebba19aeff", "server_message_id": "3943edb4-4b5e-45a1-9e42-edc13e3f7536", "delivery_state": "sent", "created_at": "2026-05-18T05:48:37.177000+00:00", "server_updated_at": "2026-05-18T05:48:37.200908+00:00", "tombstone": false, "attachments": [], "blocks": [{"id": "59011A2A-2D7A-4859-BE76-BB3282A7EBB0", "kind": "text", "text": "我最近睡眠情况怎么样", "created_at": "2026-05-18T05:48:37.000Z", "updated_at": "2026-05-18T05:48:37.000Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "