models": []}, "optimization_text": {"default_model": "", "models": []}, "optimization_visual": {"default_model": "", "models": []}, "context_folding": {"default_model": "", "models": []}, "router": {"default_model": "", "models": []}, "model_config": {"default_model": "", "models": []}, "report_interpretation": {"default_model": "", "models": []}}, "smallTasks": [{"id": 1, "name": "今日健康总结", "code": "Service_1", "brief": "汇总用户最急三天的步数、能量、饮食、睡眠等数据，生成结构化健康卡片、设计健康任务给出个任务 让用户选择 ，对应健康的任务 。生成任务", "prompt": "你是健康分析助手，请根据用户的健康数据生成每日总结：\n\n要求：\n1. 调用相关健康数据工具获取：\n- 步数\n- 能量消耗\n- 营养摄入\n- 睡眠情况\n2. 对数据进行分析：\n- 是否达标\n- 是否异常\n- 是否需要优化\n3. 输出结构化总结\n4. 调用工具生成健康卡片展示结果\n\n风格：\n- 简洁\n- 有建议\n- 不冗长\n{{CURRENT_DATE}}", "icon": "123", "tool_list": ["fetch_step_details", "fetch_energy_details", "fetch_nutrition_details", "fetch_sleep_details", "generate_task", "query_tasks_by_member", "ask_user_question"], "source": "Service"}]}}
