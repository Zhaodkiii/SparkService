或周五下不點望门这樣班\n关注的学郎公\n上容间", "id": "596DC1F0-FE97-4F35-9B87-F878BB960D50", "type": "image", "full_cache_key": "d3ef563c-2743-42e9-abaf-b61b7005b533/IMG_2030.jpeg"}], "kind": "imageGallery"}], "delivery_state": "pending", "thread_max_messages": 20, "model_name": "user"}]}
