_url": "", "source": "system", "position": 8, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 10, "kind": "api", "name": "xAI", "company": "XAI", "request_url": "https://api.x.ai/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://console.x.ai/team/c4aa1fe8-2617-4255-a78f-03d9572d1110/api-keys", "privacy_policy_url": "", "source": "system", "position": 9, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 11, "kind": "api", "name": "Anthropic", "company": "ANTHROPIC", "request_url": "https://api.anthropic.com/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "", "privacy_policy_url": "", "source": "system", "position": 10, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 12, "kind": "api", "name": "零一万物", "company": "YI", "request_url": "https://api.lingyiwanwu.com/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://platform.lingyiwanwu.com/apikeys", "privacy_policy_url": "", "source": "system", "position": 11, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 13, "kind": "api", "name": "腾讯混元", "company": "HUNYUAN", "request_url": "https://api.hunyuan.cloud.tencent.com/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://cloud.tencent.com/document/product/1729/111008", "privacy_policy_url": "", "source": "system", "position": 12, "is_active": true, "updated_at": "2026-03-08T14:49:09Z", "created_at": "2026-03-08T14:49:09Z"}, {"id": 14, "kind": "api", "name": "阶跃星辰", "company": "STEP", "request_url": "https://api.stepfun.com/v1/chat/completions", "is_hidden": false, "is_using": false, "capability_class": "chat", "help": "https://platform.stepfun.com/inte