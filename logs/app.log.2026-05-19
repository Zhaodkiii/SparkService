20260519/C5D57C63-F869-45E0-83D2-271CC91A0534/IMG_2030.jpeg", "file_id": 463, "full_cache_key": "c5d57c63-f869-45e0-83d2-271cc91a0534/IMG_2030.jpeg"}], "kind": "imageGallery", "created_at": "2026-05-19T06:57:25.000Z"}], "created_at": "2026-05-19T06:57:25.167Z", "thread_id": "06027C1C-BA20-4946-B636-BACB2696DF13", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "tombstone": false}]}
