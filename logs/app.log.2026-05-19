药品一经发小，\n概小退换。\n咨询电话：\n0512 6595523/\n容间电话。0512 65955223\n药物线下咨前\n周一至周扣门診药房咨制室\n周四下午-或周五下不點望门这樣班\n关注的学郎公\n上容间", "url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260519/91D23C0A-398F-4C8B-B2A9-3268DDC8D681/IMG_2030.jpeg", "id": "133A6E3C-ADCD-4BAA-90DA-229BB9B6AF32", "full_cache_key": "91d23c0a-398f-4c8b-b2a9-3268ddc8d681/IMG_2030.jpeg", "type": "image", "file_id": 455}], "kind": "imageGallery"}]}]}
