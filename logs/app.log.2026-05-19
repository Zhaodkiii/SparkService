 OCR 传给工具。", "id": "5C9718DD-DF1A-5002-A060-70F2C5C35D19"}, {"workout_visualization": {"notes": ["未找到符合条件的运动记录。"], "generated_at": 1779210161, "workouts": [], "schema_version": "health_workout_v1"}, "created_at": "2026-05-19T17:02:41.000Z", "id": "2E8D6617-9DEB-5FA8-8841-1AB4FEE27439", "anchor": {"value": "call_hh5wpb5s3x7jjlp1grpdv0yj", "type": "toolCall"}, "status": "ready", "kind": "workoutVisualization", "revision": 1779210161626739, "tool_call_id": "call_hh5wpb5s3x7jjlp1grpdv0yj", "updated_at": "2026-05-19T17:02:41.000Z", "order_key": 2100}, {"created_at": "2026-05-19T17:02:59.000Z", "id": "AD0B2944-EBE8-53A2-BFD9-A227146F13EE", "anchor": {"value": "call_ukti5qb4t6cune757hp5lxmm", "type": "toolCall"}, "status": "ready", "structured_health_cards": {"medications": [], "exam_reports": [], "prescriptions": [], "medical_cases": []}, "kind": "structuredHealthCards", "tool_call_id": "call_ukti5qb4t6cune757hp5lxmm", "revision": 1779210179328041, "updated_at": "2026-05-19T17:02:59.000Z", "order_key": 2100}], "created_at": "2026-05-19T17:02:32.690Z", "server_updated_at": "2026-05-19T17:03:00.011Z", "thread_max_messages": 20, "thread_current_model_name": "doubao-seed-2-0-mini-260428", "client_message_id": "AD998EB1-DE97-4E69-929B-30F448D93FD2", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_temperature": 0.6, "role": "assistant", "thread_max_tokens": 14096, "model_name": "doubao-seed-2-0-mini-260428", "thread_top_p": 1}]}
