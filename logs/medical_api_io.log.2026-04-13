INFO 2026-04-13 02:58:43,994 medical.api_io [request_id=646DEA6C-CC43-47B7-B62E-5403D41058C3] HTTP 响应摘要: GET /api/v1/medical/members/16/complete-data/ status=200 duration_ms=111 bytes=59272 headers={"Content-Type": "application/json", "ETag": "\"80a755122b3811c3e96a688049c0b03b\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 16, "member": {"id": 16, "user": 1, "name": "阿瑟费", "gender": "male", "relationship": "other", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T10:26:26.343686Z", "updated_at": "2026-04-12T10:26:26.343723Z"}, "medical_cases": [{"id": 48, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无，专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院（苏州市独墅湖医院）消化内科门诊行无痛电子胃镜检查，胃镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-13T00:44:26.417196Z", "updated_at": "2026-04-13T00:44:26.417225Z", "symptoms": ["口腔检查要求"], "medications": [], "attachments": [{"id": 169, "file_uuid": "c12432c0-5d86-4295-98d1-16476ae5514b", "original_name": "photo_4D5AB5D5-2287-4DED-86FE-7F9C84FBB59A.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "48", "object_key": "SparkClient/20260413/C12432C0-5D86-4295-98D1-16476AE5514B/photo_4D5AB5D5-2287-4DED-86FE-7F9C84FBB59A.jpg", "storage_type": "oss", "created_at": "2026-04-13T00:43:41.499439Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.