INFO 2026-04-13 14:47:07,592 medical.api_io [request_id=4580C0F6-78DD-4D15-AD4C-CAA595322596] HTTP 响应摘要: GET /api/v1/medical/members/16/complete-data/ status=200 duration_ms=141 bytes=62183 headers={"Content-Type": "application/json", "ETag": "\"d3df0ec3f5549ceda9febd5a4ef04bf7\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 16, "member": {"id": 16, "user": 1, "name": "阿瑟费", "gender": "male", "relationship": "other", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T10:26:26.343686Z", "updated_at": "2026-04-12T10:26:26.343723Z"}, "medical_cases": [{"id": 48, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无，专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院（苏州市独墅湖医院）消化内科门诊行无痛电子胃镜检查，胃镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-13T00:44:26.417196Z", "updated_at": "2026-04-13T00:44:26.417225Z", "symptoms": ["口腔检查要求"], "medications": [], "attachments": [{"id": 169, "file_uuid": "c12432c0-5d86-4295-98d1-16476ae5514b", "original_name": "photo_4D5AB5D5-2287-4DED-86FE-7F9C84FBB59A.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "48", "object_key": "SparkClient/20260413/C12432C0-5D86-4295-98D1-16476AE5514B/photo_4D5AB5D5-2287-4DED-86FE-7F9C84FBB59A.jpg", "storage_type": "oss", "created_at": "2026-04-13T00:43:41.499439Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260413/C12432C0-5D86-4295-98D1-16476AE5514B/photo_4D5AB5D5-2287-4DED-86FE-7F9C84FBB59A.jpg"}, {"id": 168, "file_uuid": "55d7c004-4f5f-4d3f-94d8-5fb158b568ff", "original_name": "photo_9246F654-80D4-47F5-9F50-1C3D7E5831F1.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "48", "object_key": "SparkClient/20260413/55D7C004-4F5F-4D3F-94D8-5FB158B568FF/photo_9246F654-80D4-47F5-9F50-1C3D7E5831F1.jpg", "storage_type": "oss", "created_at": "2026-04-13T00:43:41.299453Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260413/55D7C004-4F5F-4D3F-94D8-5FB158B568FF/photo_9246F654-80D4-47F5-9F50-1C3D7E5831F1.jpg"}]}, {"id": 47, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:46:39.137645Z", "updated_at": "2026-04-12T15:46:39.137664Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 46, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:45:17.510906Z", "updated_at": "2026-04-12T15:45:17.510919Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 45, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "", "extra": {"exam_type": "", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:44:55.091216Z", "updated_at": "2026-04-12T15:44:55.091244Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 44, "member": 16, "record_type": "custom", "status": 1, "title": "苏州美健奥亚健康体检中心体检报告", "hospital_name": "苏州美健奥亚健康体检中心", "age_at_visit": null, "diagnosis_summary": "1. 窦性心动过缓：无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗，正规医院专科诊治。2. 甲状腺囊肿（多发）：建议专科治疗。3. 中性粒细胞百分数降低：粒细胞异常减少，建议及时复查，如果仍然异常，请尽早去医院，查明原因。4. 淋巴细胞百分数增高：淋巴细胞异常，建议复查，如果仍然异常，请尽早去医院，查明原因。5. 血小板压积增高：血小板压积异常，建议复查，如果仍然异常，请去医院，查明原因。6. 血小板计数增高：血小板计数异常，建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "extra": {"exam_type": "单位体检", "report_no": "2138111466", "occurred_at": "2023-01-08"}, "created_at": "2026-04-12T15:37:32.955125Z", "updated_at": "2026-04-12T15:37:32.955170Z", "symptoms": [], "medications": [], "attachments": []}, {"id": 43, "member": 16, "record_type": "custom", "status": 1, "title": "用药记录 (3项药品)", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"source": "medication_only"}, "created_at": "2026-04-12T14:59:13.289223Z", "updated_at": "2026-04-12T14:59:13.289246Z", "symptoms": [], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏（路利特）"], "attachments": []}, {"id": 42, "member": 16, "record_type": "custom", "status": 1, "title": "处方: 高血压、高脂血症、腔隙性脑梗死、失眠", "hospital_name": "东部战区总医院", "age_at_visit": null, "diagnosis_summary": "高血压、高脂血症、腔隙性脑梗死、失眠", "extra": {"batch_no": "7303148447", "occurred_at": "2025-06-27"}, "created_at": "2026-04-12T14:58:17.860263Z", "updated_at": "2026-04-12T14:58:17.860299Z", "symptoms": [], "medications": ["甲磺酸倍他司汀片", "硫酸氢氯吡格雷片", "阿托伐他汀钙片"], "attachments": []}, {"id": 41, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史否认慢性疾病史，过敏史无。专科检查示38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。2025年12月28日行生化检验、肾功能检验，临床印象为口腔黏膜溃疡，检验结果大致正常。处方包含卢立康唑乳膏、克霉唑阴道膨胀栓、伊曲康唑分散片。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T12:38:29.016437Z", "updated_at": "2026-04-12T12:38:29.016462Z", "symptoms": ["口腔检查要求"], "medications": ["伊曲康唑分散片", "克霉唑阴道膨胀栓", "卢立康唑乳膏"], "attachments": [{"id": 155, "file_uuid": "30d6e733-bfe1-4faf-a006-c011d973df5f", "original_name": "photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "file_size": 290933, "mime_type": "image/jpeg", "file_md5": "b4647564d696c15d55ede32341c30b54", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/30D6E733-BFE1-4FAF-A006-C011D973DF5F/photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:09.152875Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/30D6E733-BFE1-4FAF-A006-C011D973DF5F/photo_ADDF0EDA-511F-436F-A373-8D2462B3A8B8.jpg"}, {"id": 154, "file_uuid": "db6521d6-89a1-4912-b962-27958cd5925e", "original_name": "photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg", "file_size": 2881639, "mime_type": "image/jpeg", "file_md5": "e2e7eba032f7e39160ba09c79ba20bea", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/DB6521D6-89A1-4912-B962-27958CD5925E/photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:08.961279Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/DB6521D6-89A1-4912-B962-27958CD5925E/photo_747AB1A7-6B36-47ED-9209-1954AE702CEE.jpg"}, {"id": 153, "file_uuid": "a543cc88-ea6e-4827-b212-fca836f479b9", "original_name": "photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/A543CC88-EA6E-4827-B212-FCA836F479B9/photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:07.660368Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/A543CC88-EA6E-4827-B212-FCA836F479B9/photo_FAA3A6B4-1F32-46E3-AD2C-C6364DE00657.jpg"}, {"id": 152, "file_uuid": "776e1fe4-22b1-41e9-9fee-2a869e728b49", "original_name": "photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "41", "object_key": "SparkClient/20260412/776E1FE4-22B1-41E9-9FEE-2A869E728B49/photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg", "storage_type": "oss", "created_at": "2026-04-12T12:28:07.462859Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/776E1FE4-22B1-41E9-9FEE-2A869E728B49/photo_E8CDBDED-74EF-48B4-9393-FA5F757B78B7.jpg"}]}, {"id": 37, "member": 16, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 28, "diagnosis_summary": "患者赵道凯，男，1998年10月29日出生，2026年2月6日于苏州大学附属第四医院（苏州市独墅湖医院）口腔科门诊初诊，主诉要求口腔检查1天，现病史为今日来诊要求口腔检查，既往史无慢性疾病史，过敏史无，专科检查见38/48近中低位阻生，远中牙龈覆盖，龈红肿，诊断为阻生牙，建议择期拔除阻生牙；2026年2月10日于苏州大学附属第四医院行无痛电子胃镜检查，内镜所见食管通过顺利、黏膜大致正常，贲门开合通畅，胃底黏膜正常，胃体见胆汁残留，胃角光整，胃窦黏膜红白相间以红为主，幽门圆、开放好，十二指肠球部及所见降部未见明显异常，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n阻生牙；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2026-02-06"}, "created_at": "2026-04-12T10:27:41.963334Z", "updated_at": "2026-04-12T10:27:41.963346Z", "symptoms": ["口腔检查要求"], "medications": [], "attachments": [{"id": 151, "file_uuid": "7ec2265c-c82b-4a88-9564-830b154f4f3e", "original_name": "photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.546026Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/7EC2265C-C82B-4A88-9564-830B154F4F3E/photo_9B421E8D-0FE6-407F-98B2-B53CFD1D3A3F.jpg"}, {"id": 150, "file_uuid": "5b767615-0755-4757-9034-bd7c9fd78900", "original_name": "photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "file_size": 190624, "mime_type": "image/jpeg", "file_md5": "6d6cb5e75f1eddc12a6012c4d5c87605", "business_type": "medical_case", "business_id": "37", "object_key": "SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg", "storage_type": "oss", "created_at": "2026-04-12T10:26:36.338921Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/5B767615-0755-4757-9034-BD7C9FD78900/photo_DFE8DA9B-BA6F-41BA-9153-F0FC98CCC259.jpg"}]}], "health_exam_reports": [{"id": 11, "user": 1, "member": 16, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）是甲状腺细胞在局部异常生长所致，多系甲状腺良性疾病的表现，少数可为恶性改变。TI-RADS 2类提示甲状腺良性改变，建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:(108/57mmHg)本次检查您的血压偏低。建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分可见于健康的成人和运动量较大的人群，也可见于器质性心脏病、甲状腺功能减退、减慢心率的药物等。无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏建议您年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合后钙盐沉着，也可为肝内胆管壁部分钙化。建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数 24.1 kg/m²)热量摄入多于消耗所致，多与生活方式不当相关。建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高:24.7umol/L(参考区间:≤23)血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80)除外体液浓缩因素影响，建议您不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:0.29%(参考区间:0.10-0.28)建议您结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准(裸眼视力-左眼 0.8 )右眼视力低于正常标准(裸眼视力-右眼 0.8 )增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-13T03:01:45.194883Z", "updated_at": "2026-04-13T03:01:45.194905Z", "attachments": [{"id": 181, "file_uuid": "953030ed-8b3f-4aed-8e81-fc39904c11b7", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "11", "object_key": "SparkClient/20260413/953030ED-8B3F-4AED-8E81-FC39904C11B7/体检报告.pdf", "storage_type": "oss", "created_at": "2026-04-13T03:01:13.861345Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260413/953030ED-8B3F-4AED-8E81-FC39904C11B7/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}, {"id": 10, "user": 1, "member": 16, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": "受检者赵道凯本次体检主要异常结果为窦性心动过缓(54次/分)、甲状腺双叶囊肿（多发）、中性粒细胞百分数降低、淋巴细胞百分数增高、血小板压积增高、血小板计数增高，其余内科、外科、肝胆脾胰肾彩超、前列腺彩超、胸部CT、多项血液生化、尿常规等检查未见明显异常。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-13T02:55:53.426876Z", "updated_at": "2026-04-13T02:55:53.426899Z", "attachments": [{"id": 179, "file_uuid": "79e61aef-0035-4de0-9987-22c7782f5efa", "original_name": "体检报告_1.pdf", "file_size": 306375, "mime_type": "application/pdf", "file_md5": "99149b61a9dbc15919c3d5a912da893b", "business_type": "health_exam_report", "business_id": "10", "object_key": "SparkClient/20260413/79E61AEF-0035-4DE0-9987-22C7782F5EFA/体检报告_1.pdf", "storage_type": "oss", "created_at": "2026-04-13T02:53:07.643534Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260413/79E61AEF-0035-4DE0-9987-22C7782F5EFA/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A_1.pdf"}]}, {"id": 9, "user": 1, "member": 16, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": "主要阳性结果及异常情况★ 心电图检查结果:窦性心动过缓(54次/分)★ 甲状腺彩超:甲状腺双叶囊肿（多发）\n异常指标解读\n窦性心动过缓【医学解释】成人窦性心律的频率低于60次/分，称为窦性心动过缓。【常见原因及后果】常见于健康的青年人、运动员与睡眠状态。其他原因包括颅内疾患、严重缺氧、低温、甲状腺机能减退、阻塞性黄疸以及应用洋地黄等药物。亦可见于窦房结病变和急性下壁心肌梗死。 如心室率过于缓慢低于40次/分，可出现头晕、晕厥、心绞痛等。【建议】无症状的窦性心动过缓通常无需治疗。但如心率显著减慢，出现心排血量不足症状，可用药物治疗，严重者考虑心脏起搏器治疗。正规医院专科诊治。\n甲状腺囊肿（多发）【医学解释】较小的囊肿可无症状，囊肿逐渐增大可出现压迫症状【常见原因及后果】较小的囊肿可无症状，囊肿逐渐增大可出现压迫症状。【建议】建议专科治疗。\n中性粒细胞百分数（NEUT%）降低【医学解释】白细胞分类计数是指计算各类白细胞（中性粒细胞、淋巴细胞、嗜酸性粒细胞、嗜碱性粒细胞和单核细胞）的百分数和绝对值，通过对染色血涂片，进行细胞分类，求得各类白细胞的百分数，对各种疾病的诊断有着重要的参考价值。【常见原因及后果】粒细胞减少： 1.感染性疾病：革兰阴性杆菌感染，如伤寒、副伤寒，白细胞总数与中性粒细胞均减少；某些病毒感染，如流感、水痘、风疹，白细胞亦常减低；某些原虫感染，如疟疾、黑热病等 ，白细胞可减少。 2.血液系统疾病：如再障、巨幼细胞贫血、粒细胞减少症等。 3.慢性理化损伤：长期接触放射线；应用某些化学药物，如氯霉素、抗肿瘤药；某些化学物质，如苯、铅汞等，均可引起白细胞及中性粒细胞减少。 4.自身免疫性疾病：如系统性红斑狼疮（SLE）等，产生自身抗体导致白细胞减少。 5.单核－巨噬细胞系统功能亢进，如脾功能亢进、淋巴瘤、类脂质沉积病等。【建议】粒细胞异常减少，建议及时复查，如果仍然异常，请尽早去医院，查明原因。\n淋巴细胞百分数（LYM%）增高【医学解释】白细胞分类计数是指计算各类白细胞（中性粒细胞、淋巴细胞、嗜酸性粒细胞、嗜碱性粒细胞和单核细胞）的百分数和绝对值，通过对染色血涂片，进行细胞分类，求得各类白细胞的百分数，对各种疾病的诊断有着重要的参考价值。【常见原因及后果】淋巴细胞增高： ⑴ 病毒感染性疾病。 ⑵ 急、慢性淋巴细胞性白血病，淋巴瘤。 ⑶ 慢性炎症，急性传染病的恢复期。 ⑷ 组织移植后的排斥反应。【建议】淋巴细胞异常，建议复查，如果仍然异常，请尽早去医院，查明原因。\n血小板压积（PCT）增高【医学解释】血小板压积(PCT)是指抗凝全血经离心沉淀后，测得下沉的血小板在全血中所占容积的百分比值。【常见原因及后果】在健康人群中该指标意义不大。【建议】血小板压积异常，建议复查，如果仍然异常，请去医院，查明原因。\n血小板计数（PLT）增高【医学解释】血小板由骨髓中的成熟巨核细胞产生，直径2～4μm，寿命10天左右。血小板的数量和质量与止血和凝血功能密切相关。【常见原因及后果】血小板增多见于：①原发性增多，如原发性血小板增多症，真性红细胞增多症等；②反应性增多，如急性感染，急性大出血，急性溶血等。血小板＞600×10^9/L可发生血栓性疾病。【建议】血小板计数异常，建议及时复查，如果仍然异常，请尽早去医院，查明原因。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-13T02:06:35.430349Z", "updated_at": "2026-04-13T02:06:35.430404Z", "attachments": [{"id": 170, "file_uuid": "85922bf3-c06e-4773-b4b2-5b62451a6b6b", "original_name": "体检报告_1.pdf", "file_size": 306375, "mime_type": "application/pdf", "file_md5": "99149b61a9dbc15919c3d5a912da893b", "business_type": "health_exam_report", "business_id": "9", "object_key": "SparkClient/20260413/85922BF3-C06E-4773-B4B2-5B62451A6B6B/体检报告_1.pdf", "storage_type": "oss", "created_at": "2026-04-13T02:01:39.571746Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260413/85922BF3-C06E-4773-B4B2-5B62451A6B6B/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A_1.pdf"}]}, {"id": 8, "user": 1, "member": 16, "institution_name": "苏州美健奥亚健康体检中心", "report_no": "2138111466", "exam_date": "2023-01-08", "exam_type": 1, "summary": "主要阳性结果及异常情况：窦性心动过缓(54次/分)，甲状腺双叶囊肿（多发），中性粒细胞百分数降低，淋巴细胞百分数增高，血小板压积增高，血小板计数增高。建议：无症状的窦性心动过缓通常无需治疗，心率显著减慢出现症状及时专科诊治；甲状腺多发囊肿建议专科治疗；粒细胞、淋巴细胞、血小板相关异常建议及时复查，仍异常需就医查明原因。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-04-12T15:57:11.721265Z", "updated_at": "2026-04-12T15:57:11.721295Z", "attachments": [{"id": 165, "file_uuid": "7f1b1015-973a-464b-9915-5b33c21c7f47", "original_name": "体检报告_1.pdf", "file_size": 306375, "mime_type": "application/pdf", "file_md5": "99149b61a9dbc15919c3d5a912da893b", "business_type": "health_exam_report", "business_id": "8", "object_key": "SparkClient/20260412/7F1B1015-973A-464B-9915-5B33C21C7F47/体检报告_1.pdf", "storage_type": "oss", "created_at": "2026-04-12T15:54:25.071471Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260412/7F1B1015-973A-464B-9915-5B33C21C7F47/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A_1.pdf"}]}], "examination_reports": [{"id": 108, "user": 1, "member": 16, "medical_record": 48, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非菱缩性胃炎伴胆汁反流。活检部位：无。建议：无。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-13T00:44:26.435848Z", "updated_at": "2026-04-13T00:44:26.435876Z", "attachments": []}, {"id": 52, "user": 1, "member": 16, "medical_record": 41, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。活检部位：无。建议：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.035871Z", "updated_at": "2026-04-12T12:38:29.035891Z", "attachments": []}, {"id": 45, "user": 1, "member": 16, "medical_record": 37, "category": "imaging", "sub_category": "", "item_name": "无痛电子胃镜检查报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T10:27:41.975688Z", "updated_at": "2026-04-12T10:27:41.975695Z", "attachments": []}, {"id": 109, "user": 1, "member": 16, "medical_record": 48, "category": "laboratory", "sub_category": "", "item_name": "口腔科专科检查报告", "performed_at": "2026-02-06T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "无", "findings": "38/48近中低位阻生，远中牙龈覆盖，龈红肿", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-13T00:44:26.447766Z", "updated_at": "2026-04-13T00:44:26.447788Z", "attachments": []}, {"id": 53, "user": 1, "member": 16, "medical_record": 41, "category": "laboratory", "sub_category": "", "item_name": "生化检验、肾功能检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "朱孝明", "findings": "采样时间：2025-12-28 09:24，核收时间：2025-12-28 10:08，报告时间：2025-12-28 10:48，送检科室：口腔科门诊，临床印象：口腔黏膜溃疡。检验项目包括总胆红素、直接胆红素、间接胆红素、天门冬氨酸氨基转移酶、丙氨酸氨基转移酶、总蛋白、白蛋白、球蛋白、白蛋白/球蛋白、γ-谷氨酰转肽酶、碱性磷酸酶、前白蛋白、尿素、肌酐、尿酸、胱抑素C、葡萄糖、肌酸激酶、乳酸脱氢酶、α-羟丁酸脱氢酶、胆碱酯酶、甘油三酯、总胆固醇、高密度脂蛋白胆固醇、低密度脂蛋白胆固醇等，结果均在参考区间内。检验建议：结合疾病特点和风险分级，咨询专科医生，开展血脂个性化管理，有效降低动脉粥样硬化性心血管疾病风险。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-04-12T12:38:29.045232Z", "updated_at": "2026-04-12T12:38:29.045246Z", "attachments": []}, {"id": 107, "user": 1, "member": 16, "medical_record": 47, "category": "肾功能", "sub_category": "", "item_name": "肾功能检查", "performed_at": "202