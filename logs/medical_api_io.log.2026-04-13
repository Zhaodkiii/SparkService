INFO 2026-04-13 03:00:49,354 medical.api_io [request_id=41511117-3634-4ADF-8D8E-8F91D2948038] HTTP 响应摘要: GET /api/v1/medical/resources/ status=200 duration_ms=13 bytes=1473 headers={"Content-Type": "application/json", "ETag": "\"ce11fb256daf1d906baa52d0999667d9\"", "Cache-Control": "private, max-age=120", "Vary": "Accept", "Allow": "GET, POST, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": [{"id": 16, "user": 1, "name": "阿瑟费", "gender": "male", "relationship": "other", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T10:26:26.343686Z", "updated_at": "2026-04-12T10:26:26.343723Z"}, {"id": 15, "user": 1, "name": "Fefew", "gender": "male", "relationship": "self", "birth_date": "2001-04-12", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-12T05:41:29.847517Z", "updated_at": "2026-04-12T05:41:29.847546Z"}, {"id": 13, "user": 1, "name": "发发发", "gender": "male", "relationship": "self", "birth_date": "1993-04-05", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-05T02:20:48.072504Z", "updated_at": "2026-04-06T13:37:28.582288Z"}, {"id": 8, "user": 1, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "1996-04-04", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-03T16:25:07.217432Z", "updated_at": "2026-04-06T13:37:28.581427Z"}, {"id": 14, "user": 1, "name": "Fff", "gender": "male", "relationship": "husband", "birth_date": "1998-04-06", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-04-06T07:17:40.149794Z", "updated_at": "2026-04-06T13:37:28.579436Z"}]}
