INFO 2026-05-21 21:47:16,478 chat_sync.sync [request_id=8395C2FB-3913-4090-9D4F-303FF4FD937F] chat push payload request_id=8395C2FB-3913-4090-9D4F-303FF4FD937F user_id=5 content_type=application/json body={"messages":[{"thread_id":"4725b9d2-2421-4157-b410-36c376c55530","role":"user","model_name":"user","client_message_id":"34b8c39e-f41f-4d0f-9281-d21372e86a3a","delivery_state":"sending","created_at":"2026-05-21 21:47:15.815000+00:00","tombstone":false,"thread_current_model_name":"deepseek-v4-pro","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":14096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}","blocks":[{"node_role":"timeline","id":"3C42C10C-0664-4408-9CD6-B6B811C66246","created_at":"2026-05-21T21:47:15.815Z","payload":{"text":{"_0":"结合这份报来看"}},"revision":1,"updated_at":"2026-05-21T21:47:15.815Z","status":"ready"},{"node_role":"timeline","id":"DF8A7BFF-82CB-475A-9E5C-779A69E642B3","created_at":"2026-05-21T21:47:15.815Z","payload":{"image_gallery":{"_0":[{"id":"B5AB2203-59F2-43DA-99EC-54A35FC91284","full_cache_key":"736a2843-4315-4ccb-97eb-364d059a6d44/IMG_1247.png","type":"image","text":"苏州大学附属第四医院\n苏州市独墅湖医院\n胃镜诊断报告单\n姓名：赵道凯\n性别：男\n年龄：28 岁\n申请科室：消化内科门诊\n门诊号：0000349056\n住院号：\n床号：\n病区：\n检查项目：无痛电子胃镜（不含林醉费）\n申请单号：260821105\n①食管\n②齿状线\n③胃底\n①胃体\n⑤胃角\n6胃窦\n⑦十二指肠球部\n⑧十二指肠降部\n内镜所见：\n食管：通过顺利，黏膜大致正常；\n贵门：开合佳通畅；\n胃底：黏膜正常；\n胃体：见胆汁残留；\n胃角：光整；\n胃窦：黏膜红白相间，以红为主；\n幽门：圆，开放好；\n十二指肠球部及所见降部：未见明显异常。\n诊断：\n慢性非菱缩性胃炎伴胆汁反流\n活检部位：\n建议：\n报告医生：健\n审核医师：F26\n报告时间：2026-02-10\n备注：若有病理，请于3-5个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告！","file_md5":"b549c88052b52d02e02867117b763749","file_id":582,"url":"https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/736A2843-4315-4CCB-97EB-364D059A6D44/IMG_1247.png"}]}},"revision":1,"updated_at":"2026-05-21T21:47:15.815Z","status":"ready"}]}],"block_updates":[]}
