false, "supports_text": true, "supports_deep_reasoning": true, "reasoning_controllable": true, "price_tier": 1, "systemProvision": "", "icon": "", "briefDescription": "", "source": "pro", "aiScenarios": ["router"], "aiToolScenarios": [], "relatedTaskCodes": [], "is_default": true, "temperature": 1.0, "max_tokens": 12048}]}, "model_config": {"default_model": "doubao-seed-2-0-mini-260428", "models": [{"name": "doubao-seed-2-0-mini-260428", "display_name": "Doubao-Seed-2.0-mini", "identity": "model", "company": "DOUBAO", "endpoint": "https://ark.cn-beijing.volces.com/api/v3/chat/completions", "api_key": "fe01b1e5-8ed6-446a-a0d3-3906a6bc6aa2", "supports_search": true, "supports_multimodal": true, "supports_reasoning": true, "supports_tool_use": true, "supports_voice_gen": false, "supports_image_gen": false, "supports_text": true, "supports_deep_reasoning": true, "reasoning_controllable": true, "price_tier": 1, "systemProvision": "", "icon": "", "briefDescription": "", "source": "pro", "aiScenarios": ["model_config"], "aiToolScenarios": [], "relatedTaskCodes": [], "is_default": true, "temperature": 1.0, "max_tokens": 12048}]}, "report_interpretation": {"default_model": "doubao-seed-2-0-mini-260428", "models": [{"name": "doubao-seed-2-0-mini-260428", "display_name": "Doubao-Seed-2.0-mini", "identity": "model", "company": "DOUBAO", "endpoint": "https://ark.cn-beijing.volces.com/api/v3/chat/completions", "api_key": "fe01b1e5-8ed6-446a-a0d3-3906a6bc6aa2", "supports_search": true, "supports_multimodal": true, "supports_reasoning": true, "supports_tool_use": true, "supports_voice_gen": false, "supports_image_gen": false, "supports_text": true, "supports_deep_reasoning": true, "reasoning_controllable": true, "price_tier": 1, "systemProvision": "", "icon": "", "briefDescription": "", "source": "pro", "aiScenarios": ["report_interpretation"], "aiToolScenarios": [], "relatedTaskCodes": [], "is_default": true, "temperature": 1.0, "max_tokens": 12048}]}}, "smallTasks": [{"id": 1, "name": "今日健康总结", "code": "Service_1", "brief": "汇总用户最急三天的步数、能量、饮食、睡眠等数据，生成结构化健康卡片、设计健康任务给出个任务 让用户选择 ，对应健康的任务 。生成任务", "prompt": "你是健康分析助手，请根据用户的健康数据生成每日总结：\n\n要求：\n1. 调用相关健康数据工具获取：\n- 步数\n- 能量消耗\n- 营养摄入\n- 睡眠情况\n2. 对数据进行分析：\n- 是否达标\n- 是否异常\n- 是否需要优化\n3. 输出结构化总结\n4. 调用工具生成健康卡片展示结果\n\n风格：\n- 简洁\n- 有建议\n- 不冗长\n{{CURRENT_DATE}}", "icon": "123", "tool_list": ["fetch_step_details", "fetch_energy_details", "fetch_nutrition_details", "fetch_sleep_details", "generate_task", "query_tasks_by_member", "ask_user_question"], "source": "Service"}, {"id": 2, "name": "睡眠恢复分析", "code": "Service_2", "brief": "分析最近7天睡眠质量、深睡比例、睡眠规律性，生成恢复建议与睡眠改善任务。", "prompt": "你是睡眠健康分析助手，请根据用户最近7天的睡眠数据生成恢复分析报告。\n\n要求：\n1. 调用 fetch_sleep_details 获取睡眠数据\n2. 分析：\n- 睡眠时长\n- 深睡比例\n- REM情况\n- 入睡规律性\n- 是否存在熬夜\n3. 输出结构化恢复建议\n4. 若存在明显问题：\n- 调用 query_tasks_by_member 查询已有任务\n- 调用 generate_task 生成改善任务\n5. 输出适合展示的健康卡片\n\n风格：\n- 专业\n- 温和\n- 可执行\n{{CURRENT_DATE}}", "icon": "bed.double.fill", "tool_list": ["fetch_sleep_details", "query_tasks_by_member", "generate_task", "generate_structured_health_card"], "source": "Service"}, {"id": 3, "name": "饮食营养评估", "code": "Service_3", "brief": "分析用户近期饮食结构、营养摄入比例与热量情况，生成饮食优化建议。", "prompt": "你是营养分析助手，请分析用户最近3天饮食情况。\n\n要求：\n1. 调用 fetch_nutrition_details 获取营养数据\n2. 分析：\n- 蛋白质摄入是否充足\n- 碳水比例是否合理\n- 脂肪摄入是否过高\n- 热量是否超标\n3. 输出饮食建议\n4. 若存在问题：\n- 查询已有任务\n- 生成饮食改善任务\n5. 生成结构化健康卡片\n\n风格：\n- 简洁\n- 专业\n- 健康管理导向\n{{CURRENT_DATE}}", "icon": "fork.knife.circle.fill", "tool_list": ["fetch_nutrition_details", "query_tasks_by_member", "generate_task", "generate_structured_health_card"], "source": "Service"}, {"id": 4, "name": "活动量趋势分析", "code": "Service_4", "brief": "统计用户最近7天步数与活动消耗，分析运动趋势并生成运动建议。", "prompt": "你是运动分析助手，请分析用户最近7天活动情况。\n\n要求：\n1. 获取：\n- fetch_step_details\n- fetch_energy_details\n- fetch_workout_details\n2. 分析：\n- 每日步数趋势\n- 热量消耗趋势\n- 是否缺乏运动\n- 是否久坐\n3. 给出改善建议\n4. 若运动不足：\n- 查询已有任务\n- 生成运动任务\n5. 输出健康卡片\n\n风格：\n- 积极\n- 激励\n- 不说教\n{{CURRENT_DATE}}", "icon": "figure.walk.circle.fill", "tool_list": ["fetch_step_details", "fetch_energy_details", "fetch_workout_details", "query_tasks_by_member", "generate_task", "generate_structured_health_card"], "source": "Service"}, {"id": 5, "name": "每周健康周报", "code": "Service_5", "brief": "整合步数、睡眠、饮食与运动数据生成周健康报告。", "prompt": "你是健康周报助手，请生成用户最近7天健康总结。\n\n要求：\n1. 获取：\n- 步数\n- 能量\n- 睡眠\n- 营养\n- 运动\n2. 输出：\n- 本周亮点\n- 风险项\n- 最需要改善的指标\n- 下周建议\n3. 使用 generate_structured_health_card 生成周报卡片\n4. 可生成下周健康任务\n\n风格：\n- 数据化\n- 有总结感\n- 类似健康报告\n{{CURRENT_DATE}}", "icon": "chart.bar.xaxis", "tool_list": ["fetch_step_details", "fetch_energy_details", "fetch_sleep_details", "fetch_nutrition_details", "fetch_workout_details", "generate_structured_health_card", "query_tasks_by_member", "generate_task"], "source": "Service"}, {"id": 6, "name": "今日运动计划", "code": "Service_6", "brief": "结合用户最近活动量与运动记录，生成适合今日的运动计划。", "prompt": "你是运动计划助手，请根据用户近期活动情况制定今日运动计划。\n\n要求：\n1. 获取：\n- 最近运动记录\n- 步数\n- 能量消耗\n2. 判断：\n- 今日适合的运动强度\n- 是否需要恢复日\n3. 输出：\n- 今日推荐运动\n- 建议时长\n- 建议消耗热量\n4. 查询已有任务避免重复\n5. 生成运动任务卡片\n\n风格：\n- 教练风格\n- 清晰直接\n{{CURRENT_DATE}}", "icon": "figure.run.circle.fill", "tool_list": ["fetch_workout_details", "fetch_step_details", "fetch_energy_details", "query_tasks_by_member", "generate_task"], "source": "Service"}, {"id": 7, "name": "智能提醒整理", "code": "Service_7", "brief": "分析用户近期日历与提醒事项，自动整理重要待办与健康提醒。", "prompt": "你是提醒整理助手，请分析用户近期提醒事项。\n\n要求：\n1. 调用 search_calendar_and_reminders 查询近期事件\n2. 分类：\n- 健康相关\n- 工作相关\n- 重要待办\n3. 识别可能遗漏事项\n4. 如用户需要：\n- 调用 write_system_event 创建提醒\n5. 输出整理摘要\n\n风格：\n- 高效\n- 清晰\n- 像智能秘书\n{{CURRENT_DATE}}", "icon": "checklist.checked", "tool_list": ["search_calendar_and_reminders", "write_system_event"], "source": "Service"}, {"id": 8, "name": "附近健康地点推荐", "code": "Service_8", "brief": "基于当前位置推荐附近健身房、公园、健康餐厅等地点。", "prompt": "你是健康生活助手，请根据用户当前位置推荐健康相关地点。\n\n要求：\n1. 获取当前位置\n2. 搜索附近：\n- 健身房\n- 公园\n- 健康餐厅\n- 药店\n3. 输出：\n- 距离\n- 推荐理由\n- 适合场景\n4. 如用户需要：\n- 规划路线\n\n风格：\n- 本地生活推荐\n- 简洁实用\n{{CURRENT_DATE}}", "icon": "location.circle.fill", "tool_list": ["get_current_location", "search_nearby_locations", "get_route"], "source": "Service"}, {"id": 9, "name": "天气健康建议", "code": "Service_9", "brief": "根据当前位置天气生成出行、运动与健康建议。", "prompt": "你是天气健康助手，请根据用户当前位置天气提供健康建议。\n\n要求：\n1. 获取当前位置\n2. 查询天气\n3. 分析：\n- 是否适合户外运动\n- 是否需要补水\n- 紫外线与温度风险\n4. 输出：\n- 穿衣建议\n- 运动建议\n- 健康提醒\n\n风格：\n- 简洁\n- 生活化\n{{CURRENT_DATE}}", "icon": "cloud.sun.fill", "tool_list": ["get_current_location", "query_weather"], "source": "Service"}, {"id": 10, "name": "医疗记录总结", "code": "Service_10", "brief": "汇总用户近期医疗记录、检查与健康档案，生成摘要。", "prompt": "你是医疗记录分析助手，请整理用户近期医疗信息。\n\n要求：\n1. 查询：\n- medical_records\n- hospital_exams\n- health_exams\n2. 汇总：\n- 最近检查\n- 关键指标\n- 异常情况\n3. 输出结构化摘要\n4. 若存在需要长期跟踪的问题：\n- 生成健康任务\n\n风格：\n- 专业\n- 医疗摘要风格\n{{CURRENT_DATE}}", "icon": "cross.case.fill", "tool_list": ["query_member_profile", "query_tasks_by_member", "generate_task", "generate_structured_health_card"], "source": "Service"}, {"id": 11, "name": "健康知识助手", "code": "Service_11", "brief": "检索本地知识库与在线资料，回答健康相关问题并生成知识文档。", "prompt": "你是健康知识助手。\n\n要求：\n1. 优先调用 search_knowledge_bag\n2. 若本地无结果：\n- 调用 search_online\n3. 对结果进行总结\n4. 如适合长期保存：\n- 调用 create_knowledge_document 创建知识卡草稿\n\n风格：\n- 专业\n- 易懂\n- 不制造焦虑\n{{CURRENT_DATE}}", "icon": "book.circle.fill", "tool_list": ["search_knowledge_bag", "search_online", "create_knowledge_document", "read_web_page"], "source": "Service"}, {"id": 12, "name": "健康记忆记录", "code": "Service_12", "brief": "自动记录用户长期健康习惯、偏好与重要信息。", "prompt": "你是健康记忆助手。\n\n要求：\n1. 识别用户长期有效的重要健康信息：\n- 作息习惯\n- 饮食偏好\n- 慢性问题\n- 健康目标\n2. 调用 save_memory 保存\n3. 若已有旧内容：\n- retrieve_memory\n- update_memory\n4. 输出记录摘要\n\n风格：\n- 简洁\n- 像长期健康管家\n{{CURRENT_DATE}}", "icon": "brain.head.profile", "tool_list": ["save_memory", "retrieve_memory", "update_memory"], "source": "Service"}]}}
