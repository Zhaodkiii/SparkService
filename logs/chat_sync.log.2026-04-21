INFO 2026-04-21 00:36:42,929 chat_sync.sync [request_id=AECB4FBD-4AA8-4EBD-AB02-D71483E8F6B4] chat push payload request_id=AECB4FBD-4AA8-4EBD-AB02-D71483E8F6B4 user_id=6 content_type=application/json body={"messages":[{"thread_id":"724a2248-d1c5-4282-8f8f-624cbb0abc0d","role":"user","kind":"text","content":"创建处方档案","client_message_id":"e6c8399e-b00b-4727-ad7e-83e062dc6838","delivery_state":"pending","created_at":"2026-04-21 00:36:43.051000+00:00","tombstone":false,"thread_current_model_name":"qwen3.5-flash","thread_temperature":0.8,"thread_top_p":1.0,"thread_max_tokens":4096,"thread_max_messages":20,"thread_role_prompt":"","attachments":[{"fileId":280,"id":"69966C6D-3345-4F80-8F86-04271135F405","type":"image","text":"窗口：6号\n年龄：27岁\n2026/04/20 10:11\n药品数量/用法\n1盒\nMY25-02-04\n1盒\nMY25-01-04\n苏州大学附属第四医院\n门诊用药单\n门诊号：0000349056\n姓名：赵道凯\n性别：男\n科室：皮肤科门诊\n诊断：结膜炎\n药品名称/规格\n（MY25-02-04）普拉洛芬滴眼\nOpto\n液（普南扑灵）\n5ml:5mg\n用法：滴眼 每天4次 每次1滴\n友情提示：无\n（MY25-01-04） 盐酸氮卓斯汀\n滴眼液（爱赛平）\n6ml:3mg （0.05%）\n用法：滴眼 每天2次 每次1滴\n友情提示：开启瓶封后，使用不可超过四周。","url":"https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260421/59CC08A4-CAE2-406F-9087-DC0C24602315/IMG_1812.jpeg","fileMd5":"de257a30b3e928fa067b0df812b1f8cb","fullCacheKey":"59cc08a4-cae2-406f-9087-dc0c24602315/IMG_1812.jpeg"}],"reasoning_expanded":false,"reasoning_visibility":"full"}]}
