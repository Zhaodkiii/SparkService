reasoning_visibility": "full", "client_message_id": "58A06FBD-66BE-499E-8E90-1CE2FDFF325B", "reasoning_expanded": false, "blocks": [{"text": "我需要先了解最近三天的健康相关数据，包括运动、睡眠、步数和能量消耗等情况，以便进行分析并生成合适的健康任务。首先，我要查询最近三天的睡眠情况。\n", "createdAt": "2026-04-28T23:44:09.008Z", "kind": "text", "id": "4249B623-4E7D-4012-8B86-FED00D602FF3", "updatedAt": "2026-04-28T23:44:10.215Z"}, {"kind": "tool", "text": "正在使用工具：睡眠详情\n2026-04-25 睡眠时长 250 分钟（深睡 28 分钟，核心 153 分钟，REM 69 分钟，清醒 8 分钟）", "updatedAt": "2026-04-28T23:44:11.039Z", "createdAt": "2026-04-28T23:44:10.259Z", "id": "E922A6B5-BB8E-41C3-9671-8CF2DDD5312A", "anchor": {"value": "call_eeqwcyo9ozsm40ryt7p9icz0", "type": "toolCall"}, "toolCallID": "call_eeqwcyo9ozsm40ryt7p9icz0", "toolName": "fetch_sleep_details"}, {"createdAt": "2026-04-28T23:44:11.035Z", "id": "51EB392B-3F83-4955-A3FC-6CDBAAE0E984", "sleepVisualization": {"days": [{"date": "2026-04-25", "summary": {"end": 1777160871, "endText": "07:47", "totalSleepMinutes": 250, "startText": "03:34", "start": 1777145692}, "stages": {"core": 153, "deep": 28, "awake": 8, "rem": 69, "unspecified": 0}, "timeline": [{"end": 1777145843, "start": 1777145692, "startPercent": 0, "widthPercent": 0.9947954410698993, "stage": "core", "endText": "03:37", "startText": "03:34"}, {"end": 1777145903, "start": 1777145843, "startPercent": 0.9947954410698993, "widthPercent": 0.39528295671651625, "stage": "awake", "endText": "03:38", "startText": "03:37"}, {"start": 1777145903, "widthPercent": 5.94900849858357, "startText": "03:38", "endText": "03:53", "end": 1777146806, "stage": "core", "startPercent": 1.3900783977864155}, {"start": 1777146806, "widthPercent": 0.7971539627116411, "startText": "03:53", "endText": "03:55", "end": 1777146927, "stage": "deep", "startPercent": 7.339086896369985}, {"start": 1777146927, "widthPercent": 3.373081230647605, "startText": "03:55", "endText": "04:03", "end": 1777147439, "stage": "core", "startPercent": 8.136240859081626}, {"start": 1777147439, "widthPercent": 2.1806443112