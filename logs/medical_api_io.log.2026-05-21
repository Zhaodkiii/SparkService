, "flag": "", "result_at": "2025-05-16T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:19:09.874693Z", "updated_at": "2026-05-21T16:19:09.874703Z"}, {"id": 860, "business_type": "health_exam_report", "business_id": 4, "member": 19, "category": "生化检测", "sub_category": "", "item_name": "血清尿酸", "item_code": "UA", "result_value": "339.80", "unit": "umol/L", "reference_range": "210-430", "flag": "", "result_at": "2025-05-16T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:19:09.872437Z", "updated_at": "2026-05-21T16:19:09.872447Z"}, {"id": 859, "business_type": "health_exam_report", "business_id": 4, "member": 19, "category": "生化检测", "sub_category": "", "item_name": "血清低密度脂蛋白胆固醇", "item_code": "LDL-C", "result_value": "3.36", "unit": "mmol/L", "reference_range": "≤3.37", "flag": "", "result_at": "2025-05-16T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:19:09.870260Z", "updated_at": "2026-05-21T16:19:09.870267Z"}, {"id": 858, "business_type": "health_exam_report", "business_id": 4, "member": 19, "category": "生化检测", "sub_category": "", "item_name": "血清高密度脂蛋白胆固醇", "item_code": "HDL-C", "result_value": "1.54", "unit": "mmol/L", "reference_range": "≥1.04", "flag": "", "result_at": "2025-05-16T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:19:09.868012Z", "updated_at": "2026-05-21T16:19:09.868019Z"}, {"id": 857, "business_type": "health_exam_report", "business_id": 4, "member": 19, "category": "生化检测", "sub_category": "", "item_name": "血清甘油三酯", "item_code": "TG", "result_value": "0.87", "unit": "mmol/L", "reference_range": "≤2.3", "flag": "", "result_at": "2025-05-16T16:00:00Z", "modality": "", "body_part": "", "diagnosis": "", "extra": {}, "sort_order": 4, "created_at": "2026-05-21T16:19: