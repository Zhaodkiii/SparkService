INFO 2026-05-21 16:19:10,101 medical.api_io [request_id=4F0CF428-D183-4205-8ABE-0C221EBD0649] HTTP 响应摘要: GET /api/v1/medical/members/19/complete-data/ status=200 duration_ms=93 bytes=8907 headers={"Content-Type": "application/json", "ETag": "\"7944d89aff237049505f107b664ce2a5\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 19, "member": {"id": 19, "user": 5, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "1999-05-21", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-21T10:56:31.523140Z", "updated_at": "2026-05-21T10:56:31.523176Z"}, "medical_cases": [{"id": 37, "member": 19, "record_type": "outpatient", "status": 1, "title": "哈哈", "hospital_name": "", "age_at_visit": null, "diagnosis_summary": "", "extra": {"visit_date": "2026-05-21"}, "created_at": "2026-05-21T12:38:12.847773Z", "updated_at": "2026-05-21T12:38:12.847796Z", "symptoms": [], "medications": [], "attachments": []}], "health_exam_reports": [{"id": 4, "user": 5, "member": 19, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）：建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分：无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏：建议年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶：建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数24.1kg/m²)：建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高、血清直接胆红素测定（结合胆红素）增高：建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:建议结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准、右眼视力低于正常标准：增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:19:09.820253Z", "updated_at": "2026-05-21T16:19:09.820274Z", "attachments": [{"id": 580, "file_uuid": "fd1a01fb-5305-4fcd-a593-50cb7a1cab43", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "4", "object_key": "SparkClient/20260521/FD1A01FB-5305-4FCD-A593-50CB7A1CAB43/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-21T16:16:50.866629Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/FD1A01FB-5305-4FCD-A593-50CB7A1CAB43/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 108, "user": 5, "member": 19, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T16:01:11.207503Z", "updated_at": "2026-05-21T16:01:11.207524Z", "attachments": [{"id": 572, "file_uuid": "ee578a06-7446-4197-b2ab-800f8691804c", "original_name": "IMG_1691.png", "file_size": 479578, "mime_type": "image/png", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "108", "object_key": "SparkClient/20260521/EE578A06-7446-4197-B2AB-800F8691804C/IMG_1691.png", "storage_type": "oss", "created_at": "2026-05-21T15:59:12.454872Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260521/EE578A06-7446-4197-B2AB-800F8691804C/IMG_1691.png"}]}, {"id": 107, "user": 5, "member": 19, "medical_record": null, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-21T12:37:32.381792Z", "updated_at": "2026-05-21T12:37:32.381818Z", "attachments": [{"id": 568, "file_uuid": "2