object_key": "SparkClient/20260506/659772C1-7FA6-43D3-9FA3-933CA8AA09FC/photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg", "storage_type": "oss", "created_at": "2026-05-06T09:50:33.208234Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/659772C1-7FA6-43D3-9FA3-933CA8AA09FC/photo_175805A0-8745-40AF-85A0-84F3F378AFD9.jpg"}]}], "health_exam_reports": [{"id": 14, "user": 12, "member": 34, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类） 是甲状腺细胞在局部异常生长所致，多系甲状腺良性疾病的表现，少数可为恶性改变。TI-RADS 2类提示甲状腺良性改变，建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:(108/57mmHg) 本次检查您的血压偏低。建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分 可见于健康的成人和运动量较大的人群，也可见于器质性心脏病、甲状腺功能减退、减慢心率的药物等。无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏 建议您年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶 多为肝脏组织局灶性创伤、炎症、寄生虫感染等病变愈合后钙盐沉着，也可为肝内胆管壁部分钙化。建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数 24.1 kg/m²) 热量摄入多于消耗所致，多与生活方式不当相关。建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高:24.7umol/L(参考区间:≤23) 血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80) 除外体液浓缩因素影响，建议您不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:0.29%(参考区间:0.10-0.28) 建议您结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准(裸眼视力-左眼 0.8 ) 右眼视力低于正常标准(裸眼视力-右眼 0.8 ) 增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-06T11:02:40.922317Z", "updated_at": "2026-05-06T11:02:40.922337Z", "attachments": [{"id": 370, "file_uuid": "09e1acd7-eabf-4f54-a718-4be856acd280", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "14", "object_key": "SparkClient/20260506/09E1ACD7-EABF-4F54-A718-4BE856ACD280/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-06T11:02:16.138757Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260506/09E1ACD7-EABF-4F54-A718-4BE856ACD280/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 130, "user": 12, "member": 34, "medical_record": 77, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州大学附属第四医院 苏州市独墅湖医院", "department_name": "", "doctor_name": "欧啡", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-07T04:00:07.151343Z", "updated_at": "2026-05-08T05:02:13.698280Z", "attachments": [{"id": 372, "file_uuid": "e545cf7c-cb1b-4199-b5a6-050d1ac3e227", "original_name": "photo_B6E0FA45-8FC5-46B0-B3A8-578D2C343FEA.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "130", "object_key": "SparkClient/20260507/E545CF7C-CB1B-4199-B5A6-050D1AC3E227/photo_B6E0FA45-8FC5-46B0-B3A8-578D2C343FEA.jpg", "storage_type": "oss", "created_at": "2026-05-07T04:00:00.772214Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260507/E545CF7C-CB1B-4199-B5A6-050D1AC3E227/photo_B6E0FA45-8FC5-46B0-B3A8-578D2C343FEA.jpg"}]}, {"id": 132, "user": 12, "member": 34, "medical_record": 77, "category": "imaging", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-07T22:07:26.167022Z", "updated_at": "2026-05-08T04:35:54.100303Z", "attachments": []}, {"id": 131, "user": 12, "member": 34, "medical_record": 70, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-07T16:25:04.87