xHeartRate":57},"startText":"06:19","endText":"06:47","startPercent":90.70741203261589},{"widthPercent":0.1101887901270844,"end":1778280506,"stage":"awake","start":1778280476,"startText":"06:47","endText":"06:48","startPercent":97.01388378755601},{"widthPercent":0.9953720708146624,"end":1778280777,"stage":"core","start":1778280506,"startText":"06:48","endText":"06:52","startPercent":97.1240725776831},{"widthPercent":1.8805553515022406,"end":1778281289,"stage":"rem","start":1778280777,"vitals":{"avgHeartRate":53,"minHeartRate":51,"maxHeartRate":55},"startText":"06:52","endText":"07:01","startPercent":98.11944464849776}]}],"generatedAt":1778309846},"anchor":{"value":"call_nn0ga51hoi0oc1xcey5l9wgk","type":"toolCall"},"createdAt":"2026-05-09T06:57:26.638Z","updatedAt":"2026-05-09T06:57:26.638Z","kind":"sleepVisualization","id":"F303DCD7-1286-4C41-8B7F-9EBD681E4DB2"},{"kind":"text","id":"52181FD3-84B6-4E59-944F-8D8B4A65819A","createdAt":"2026-05-09T06:57:38.339Z","updatedAt":"2026-05-09T06:57:44.802Z","text":"你昨晚（5月8日）的睡眠情况如下：\n\n### 整体概况\n- 总睡眠时长：7小时33分钟，实际有效睡眠7小时2分钟，清醒占比8.2%\n- 睡眠结构：\n  * 核心睡眠：3小时48分钟（占比50.2%，正常范围）\n  * 深度睡眠：1小时11分钟（占比15.6%，略低于推荐的20%-25%）\n  * REM睡眠：2小时3分钟（占比27.1%，高于常规15%-20%的平均水平）\n\n### 睡眠特点\n- 睡眠周期转换正常，整夜共经历5段深度睡眠、6段REM睡眠，符合睡眠周期规律\n- 夜间清醒共5次，总时长37分钟，属于正常碎片化清醒范围\n- 睡眠过程中心率稳定在47-67 bpm，呼吸频率14-16次/分钟，生理指标平稳\n\n### 建议\n深度睡眠占比略低，可尝试睡前1小时避免电子设备蓝光、降低卧室温度至18-22℃，有助于提升深度睡眠质量。"}]}]}
