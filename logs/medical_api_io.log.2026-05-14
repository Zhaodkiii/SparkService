镜", "result_value": "慢性非萎缩性胃炎伴胆汁反流", "sub_category": "胃镜"}], "organization_name": "苏州大学附属第四医院"}, {"performed_at": "2025-07-05", "item_name": "检验报告单（血细胞分析+CRP）", "doctor_name": "冯玎琦", "category": "laboratory", "findings": "临床印象：肠功能紊乱；送检项目：血细胞分析+CRP；结果无明显异常", "details": [{"category": "检验科", "unit": "10^9/L", "reference_range": "3.5--9.5", "item_name": "白细胞计数", "result_value": "5.56", "sub_category": "血细胞分析"}, {"reference_range": "1.8--6.3", "category": "检验科", "item_name": "中性粒细胞计数", "result_value": "3.24", "sub_category": "血细胞分析", "unit": "10^9/L"}, {"reference_range": "1.1--3.2", "category": "检验科", "item_name": "淋巴细胞计数", "result_value": "1.95", "sub_category": "血细胞分析", "unit": "10^9/L"}, {"reference_range": "0.1--0.6", "category": "检验科", "item_name": "单核细胞计数", "result_value": "0.34", "sub_category": "血细胞分析", "unit": "10^9/L"}, {"reference_range": "0.02--0.52", "category": "检验科", "item_name": "嗜酸性粒细胞计数", "result_value": "0.03", "sub_category": "血细胞分析", "unit": "10^9/L"}, {"reference_range": "0--0.06", "category": "检验科", "item_name": "嗜碱性粒细胞计数", "result_value": "0.00", "sub_category": "血细胞分析", "unit": "10^9/L"}, {"reference_range": "40--75", "category": "检验科", "item_name": "中性粒细胞百分比", "result_value": "58.2", "sub_category": "血细胞分析", "unit": "%"}, {"reference_range": "20--50", "category": "检验科", "item_name": "淋巴细胞百分比", "result_value": "35.1", "sub_category": "血细胞分析", "unit": "%"}, {"reference_range": "3--10", "category": "检验科", "item_name": "单核细胞百分比", "result_value": "6.1", "sub_category": "血细胞分析", "unit": "%"}, {"reference_range": "0.4--8", "category": "检验科", "item_name": "嗜酸性粒细胞百分比", "result_value": "0.6", "sub_category": "血细胞分析", "unit": "%"}, {"reference_range": "0--1", "category": "检验科", "item_name": "嗜碱性粒细胞百分比", "result_value": "0.0", "sub_category": "血细胞分析", "unit": "%"}, {"reference_range": "4.3--5.8", "category": "检验科", "item_name": "红细胞计数", "result_value": "4.74", "sub_category": "血细胞分析", "unit": "10^12/L"}, {"reference_range": "130--175", "category": "检验科", "