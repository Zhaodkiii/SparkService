INFO 2026-05-14 08:25:05,883 medical.api_io [request_id=7AAE26B7-6E77-4B96-8876-70BD369EF3AB] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "172.20.10.2:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc4NzQ3NDU5LCJpYXQiOjE3Nzg3NDU2NTksImp0aSI6IjNjYThjMmY5NjI2ZDQyYjI5NWRkODM4ZDNkMTE3ZDRmIiwidXNlcl9pZCI6IjEifQ.3oKRSBBpbZHuEoApRrntgo6meTolzHUvxxcVkf07arQ", "X-Request-Id": "7AAE26B7-6E77-4B96-8876-70BD369EF3AB", "Content-Length": "12630"} body={"source_file_ids": [], "member": {"id": 9}, "medical_case": {"hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "title": "就诊病例", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"occurred_at": "2025-08-02", "source": "typed_upload"}}, "visit": {"visit_no": "0000349056", "doctor_name": "", "visited_at": "2025-08-02", "department": "神经内科门诊", "visit_type": "门诊"}, "symptom": {"body_part": "头部", "severity": "medium", "duration_value": 2, "notes": "伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，无行走不稳", "name": "头晕", "duration_unit": "月"}, "examination_reports": [{"performed_at": "2025-06-04", "item_name": "放射科诊断报告书", "details": [{"sub_category": "CT", "body_part": "头颈部", "item_name": "颈椎椎间盘平扫，头颅平扫", "result_value": "1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "diagnosis": "头颅CT平扫未见明显异常；C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚", "category": "放射科"}], "organization_name": "苏州工业园区星塘医院", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "doctor_name": "仿德话", "category": "imaging"}, {"performed_at": "2026-02-10", "item_name": "胃镜诊断报告单", "details": [{"result_value": "慢性非萎缩性胃炎伴胆汁反流", "category": "消化内科", "item_name": "无痛电子胃镜", "diagnosis": "慢性非萎缩性胃炎伴胆汁反流", "sub_category": "胃镜", "body_part": "上消化道"}], "organization_name": "苏州大学附属第四医院", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "category": "imaging"}, {"performed_at": "2025-07-05", "item_name": "检验报告单（血细胞分析+CRP）", "details": [{"unit": "10^9/L", "result_value": "5.56", "category": "检验科", "item_name": "白细胞计数", "reference_range": "3.5--9.5", "sub_category": "血细胞分析"}, {"unit": "10^9/L", "result_value": "3.24", "category": "检验科", "item_name": "中性粒细胞计数", "reference_range": "1.8--6.3", "sub_category": "血细胞分析"}, {"unit": "10^9/L", "result_value": "1.95", "category": "检验科", "item_name": "淋巴细胞计数", "reference_range": "1.1--3.2", "sub_category": "血细胞分析"}, {"unit": "10^9/L", "result_value": "0.34", "category": "检验科", "item_name": "单核细胞计数", "reference_range": "0.1--0.6", "sub_category": "血细胞分析"}, {"unit": "10^9/L", "result_value": "0.03", "category": "检验科", "item_name": "嗜酸性粒细胞计数", "reference_range": "0.02--0.52", "sub_category": "血细胞分析"}, {"unit": "10^9/L", "result_value": "0.00", "category": "检验科", "item_name": "嗜碱性粒细胞计数", "reference_range": "0--0.06", "sub_category": "血细胞分析"}, {"unit": "%", "result_value": "58.2", "category": "检验科", "item_name": "中性粒细胞百分比", "reference_range": "40--75", "sub_category": "血细胞分析"}, {"item_name": "淋巴细胞百分比", "unit": "%", "result_value": "35.1", "reference_range": "20--50", "category": "检验科", "sub_category": "血细胞分析"}, {"item_name": "单核细胞百分比", "unit": "%", "