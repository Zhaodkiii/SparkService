_file_id 一致，勿把完整 OCR 传给工具。"}, {"type": "structured_health_cards", "id": "DEC7345C-A4FF-45D3-B147-5CBD92B3375C", "text": "{\"medicalCases\":[],\"medications\":[{\"ossFileId\":286,\"displayName\":\"普拉洛芬滴眼液\",\"draftJSON\":\"{\\\"brandName\\\":\\\"普南扑灵\\\",\\\"dosageForm\\\":\\\"滴眼液\\\",\\\"dosePerTime\\\":\\\"1滴\\\",\\\"doseUnit\\\":\\\"滴\\\",\\\"doseValue\\\":\\\"1\\\",\\\"drugName\\\":\\\"普拉洛芬滴眼液\\\",\\\"frequencyText\\\":\\\"每日四次\\\",\\\"genericName\\\":\\\"普拉洛芬\\\",\\\"instructions\\\":\\\"开启瓶封后，使用不可超过四周\\\",\\\"period\\\":\\\"日\\\",\\\"route\\\":\\\"滴眼\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"5ml:5mg\\\",\\\"timesPerPeriod\\\":\\\"4\\\"}\",\"id\":\"EA4134C8-5084-4F6E-A8FD-AC326A61F93E\",\"specification\":\"5ml:5mg 滴眼液\",\"dosageLine\":\"1滴 · 每日四次\",\"memberID\":21,\"isSaved\":true},{\"ossFileId\":286,\"displayName\":\"盐酸氮卓斯汀滴眼液\",\"draftJSON\":\"{\\\"brandName\\\":\\\"爱赛平\\\",\\\"dosageForm\\\":\\\"滴眼液\\\",\\\"dosePerTime\\\":\\\"1滴\\\",\\\"doseUnit\\\":\\\"滴\\\",\\\"doseValue\\\":\\\"1\\\",\\\"drugName\\\":\\\"盐酸氮卓斯汀滴眼液\\\",\\\"frequencyCode\\\":\\\"bid\\\",\\\"frequencyText\\\":\\\"每日两次\\\",\\\"genericName\\\":\\\"盐酸氮卓斯汀\\\",\\\"instructions\\\":\\\"开启瓶封后，使用不可超过四周\\\",\\\"period\\\":\\\"日\\\",\\\"route\\\":\\\"滴眼\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"6ml:3mg 0.05%\\\",\\\"timesPerPeriod\\\":\\\"2\\\"}\",\"id\":\"8B94B43B-6167-426B-B068-D2A92B095370\",\"specification\":\"6ml:3mg 0.05% 滴眼液\",\"dosageLine\":\"1滴 · 每日两次\",\"memberID\":21,\"isSaved\":true}],\"prescriptions\":[],\"examReports\":[]}"}], "client_message_id": "4F5BDB7F-DD2E-4CDB-911C-79B125D9FDFF", "server_updated_at": "2026-04-22T06:44:10.229Z", "created_at": "2026-04-22T01:16:24.408Z", "thread_temperature": 0.6, "thread_max_tokens": 4096, "thread_role_prompt": "", "reasoning_expanded": false, "kind": "text", "reasoning_visibility": "full", "thread_id": "229F3622-5AE0-490D-A0B0-004E58E31AEF"}]}
