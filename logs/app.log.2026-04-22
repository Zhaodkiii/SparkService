\":\\\"ml\\\",\\\"doseValue\\\":\\\"10\\\",\\\"drugName\\\":\\\"左西替利嗪口服溶液（平可宁）\\\",\\\"frequencyText\\\":\\\"每日1次\\\",\\\"genericName\\\":\\\"左西替利嗪口服溶液\\\",\\\"instructions\\\":\\\"酒后避免使用，司机、操作机器或高空作业慎用\\\",\\\"route\\\":\\\"口服\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"75mg:150ml\\\"},{\\\"brandName\\\":\\\"信谊\\\",\\\"dosePerTime\\\":\\\"10mg\\\",\\\"doseUnit\\\":\\\"mg\\\",\\\"doseValue\\\":\\\"10\\\",\\\"drugName\\\":\\\"泼尼松片（信谊）\\\",\\\"frequencyText\\\":\\\"每日3次\\\",\\\"genericName\\\":\\\"泼尼松片\\\",\\\"instructions\\\":\\\"遵医嘱\\\",\\\"route\\\":\\\"口服\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"5mg*10片\\\"}],\\\"prescribedAt\\\":\\\"2026-04-18\\\"}],\\\"symptom\\\":{\\\"bodyPart\\\":\\\"双上臂、前胸、后背\\\",\\\"durationUnit\\\":\\\"小时\\\",\\\"durationValue\\\":\\\"2\\\",\\\"name\\\":\\\"皮疹瘙痒\\\"},\\\"title\\\":\\\"就诊病例\\\",\\\"visit\\\":{\\\"department\\\":\\\"急诊内科\\\",\\\"visitType\\\":\\\"急诊\\\",\\\"visitedAt\\\":\\\"2026-04-18\\\"}}\",\"title\":\"就诊病例\",\"ossFileId\":299,\"id\":\"FD0A9900-211B-4399-9E36-D47FB61EAE2E\",\"isSaved\":false}],\"prescriptions\":[]}", "type": "structured_health_cards", "id": "3017FE65-A151-43EA-B9F3-F49FADC59901"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": false, "reasoning_visibility": "full"}, {"thread_id": "5bf13f50-1749-49f9-9607-6f6a7212247c", "role": "user", "kind": "text", "content": "看看", "client_message_id": "e8cfb537-5f85-4bca-968d-cd7ec0433ac9", "server_message_id": "bd100671-8711-41b2-9f78-812fe227d396", "delivery_state": "sent", "created_at": "2026-04-22T09:26:15.668000+00:00", "server_updated_at": "2026-04-22T09:26:15.914317+00:00", "tombstone": false, "attachments": [{"url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260422/1AFCE258-091F-4DB8-8B32-06C8E67FD6B4/IMG_1806.jpeg", "fullCacheKey": "1afce258-091f-4db8-8b32-06c8e67fd6b4/IMG_1806.jpeg", "id": "DB2B4CF5-290A-4D2E-8CC6-294B32922ECD", "fileId": 304, "fileMd5": "4890f149d00377b5e0fbbceee9bdf375", "type"