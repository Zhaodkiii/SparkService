lity": "full", "thread_id": "8AA3A688-C75B-4304-8BB2-44D6CD19EF69", "client_message_id": "81326749-7661-446F-978D-8F0DDE27459A", "thread_max_tokens": 4096, "role": "assistant", "thread_role_prompt": "", "reasoning_expanded": false, "thread_current_model_name": "doubao-seed-2-0-lite-260215", "thread_temperature": 0.6, "tombstone": false, "kind": "text"}]}
