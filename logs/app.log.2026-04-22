统】结构化保存卡片正在后台生成中。请直接根据用户消息或对话中的相关原文进行专业解读，无需等待卡片即可继续回答；卡片生成后将显示在本条助手回复下方。若再次调用 generate_structured_health_card：raw_text 必须是你提炼后的医学要点，可选 oss_file_id 与消息中的 oss_file_id 一致，勿把完整 OCR 传给工具。", "id": "2C587375-7482-4832-9B19-98BBEE6454BE"}, {"type": "structured_health_cards", "text": "{\"prescriptions\":[],\"examReports\":[],\"medications\":[{\"specification\":\"5ml:5mg 滴眼液\",\"displayName\":\"普拉洛芬滴眼液\",\"isSaved\":false,\"id\":\"EA4134C8-5084-4F6E-A8FD-AC326A61F93E\",\"memberID\":21,\"draftJSON\":\"{\\\"brandName\\\":\\\"普南扑灵\\\",\\\"dosageForm\\\":\\\"滴眼液\\\",\\\"dosePerTime\\\":\\\"1滴\\\",\\\"doseUnit\\\":\\\"滴\\\",\\\"doseValue\\\":\\\"1\\\",\\\"drugName\\\":\\\"普拉洛芬滴眼液\\\",\\\"frequencyText\\\":\\\"每日四次\\\",\\\"genericName\\\":\\\"普拉洛芬\\\",\\\"instructions\\\":\\\"开启瓶封后，使用不可超过四周\\\",\\\"period\\\":\\\"日\\\",\\\"route\\\":\\\"滴眼\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"5ml:5mg\\\",\\\"timesPerPeriod\\\":\\\"4\\\"}\",\"dosageLine\":\"1滴 · 每日四次\",\"ossFileId\":286},{\"specification\":\"6ml:3mg 0.05% 滴眼液\",\"displayName\":\"盐酸氮卓斯汀滴眼液\",\"isSaved\":true,\"id\":\"8B94B43B-6167-426B-B068-D2A92B095370\",\"memberID\":21,\"draftJSON\":\"{\\\"brandName\\\":\\\"爱赛平\\\",\\\"dosageForm\\\":\\\"滴眼液\\\",\\\"dosePerTime\\\":\\\"1滴\\\",\\\"doseUnit\\\":\\\"滴\\\",\\\"doseValue\\\":\\\"1\\\",\\\"drugName\\\":\\\"盐酸氮卓斯汀滴眼液\\\",\\\"frequencyCode\\\":\\\"bid\\\",\\\"frequencyText\\\":\\\"每日两次\\\",\\\"genericName\\\":\\\"盐酸氮卓斯汀\\\",\\\"instructions\\\":\\\"开启瓶封后，使用不可超过四周\\\",\\\"period\\\":\\\"日\\\",\\\"route\\\":\\\"滴眼\\\",\\\"sortOrder\\\":null,\\\"strength\\\":\\\"6ml:3mg 0.05%\\\",\\\"timesPerPeriod\\\":\\\"2\\\"}\",\"dosageLine\":\"1滴 · 每日两次\",\"ossFileId\":286}],\"medicalCases\":[]}", "id": "DEC7345C-A4FF-45D3-B147-5CBD92B3375C"}], "thread_top_p": 1, "thread_temperature": 0.6, "thread_max_tokens": 4096, "server_updated_at": "2026-04-22T06:44:09.596Z", "kind": "text", "role": "assistant"}]}
