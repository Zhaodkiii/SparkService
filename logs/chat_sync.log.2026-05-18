t":"05:45","start_percent":61.66316421495046,"end":1779054311},{"start_text":"05:45","start":1779054311,"stage":"core","width_percent":1.6271389972981085,"end_text":"05:49","start_percent":64.1909336535575,"end":1779054582},{"start_text":"05:49","start":1779054582,"vitals":{"avg_respiratory_rate":14.833333333333334,"min_heart_rate":52,"max_heart_rate":60,"avg_heart_rate":54.4},"stage":"rem","width_percent":10.129090363254278,"end_text":"06:17","start_percent":65.8180726508556,"end":1779056269},{"start_text":"06:17","start":1779056269,"vitals":{"avg_respiratory_rate":14,"min_heart_rate":53,"max_heart_rate":59,"avg_heart_rate":55.74607887268066},"stage":"core","width_percent":14.464124887421196,"end_text":"06:57","start_percent":75.94716301410988,"end":1779058678},{"start_text":"06:57","start":1779058678,"vitals":{"min_heart_rate":54,"max_heart_rate":58,"avg_heart_rate":55.666666666666664},"stage":"awake","width_percent":3.8006604623236266,"end_text":"07:08","start_percent":90.41128790153107,"end":1779059311},{"start_text":"07:08","start":1779059311,"vitals":{"avg_respiratory_rate":14.25,"min_heart_rate":52,"max_heart_rate":54,"avg_heart_rate":53},"stage":"core","width_percent":5.788051636145302,"end_text":"07:24","start_percent":94.2119483638547,"end":1779060275}],"stages":{"awake":12,"rem":59,"unspecified":0,"deep":32,"core":177}}],"generated_at":1779083367,"schema_version":"health_sleep_v1"},"id":"38F9D77A-811E-4CED-BEA4-8BA0A2F39F68","kind":"sleepVisualization","updated_at":"2026-05-18T05:49:27.000Z"},{"kind":"text","text":"### 最近睡眠情况总结（近7天有完整记录的2天）\n| 日期 | 总睡眠时长 | 深度睡眠占比 | REM睡眠占比 | 夜间清醒时长 |\n|------|------------|--------------|-------------|--------------|\n| 5月11日 | 7小时10分钟 | 7.5%（34分钟） | 21.1%（1小时36分钟） | 32分钟 |\n| 5月17日 | 4小时28分钟 | 11.5%（32分钟） | 21.3%（59分钟） | 12分钟 |\n\n### 现状分析&建议\n1. **睡眠时长波动大**：5月17日睡眠不足5小时，长期睡眠不足可能诱发或加重你本身的前庭性眩晕症状，建议尽量固定作息，每天睡够6~8小时。\n2. **深度睡眠整体偏少**：正常深度睡眠占比应为15%~25%，你两次记录均低于10%~11%，可以尝试睡前1小时避免看电子屏幕、睡前10分钟做5组缓慢深呼吸，帮助提升深度睡眠质量。\n3. 整体REM睡眠占比在正常范围（20%~25%），睡眠节律相对稳定。\n\n如果需要调整睡眠计划，我可以帮你设置定时入睡提醒哦~","created_at":"2026-05-18T05:49:30.000Z","updated_at":"2026-05-18T05:49:37.000Z","id":"53006E8A-BED6-4F27-BE43-886F39062A39"}]},{"thread_id":"ed8adf40-f726-4af7-a1a4-533f8766be67","role":"user","model_name":"user","client_message_id":"d6d5ff39-6e9f-41e2-804e-02a02f92e270","delivery_state":"pending","created_at":"2026-05-18 05:49:55.901000+00:00","tombstone":false,"thread_current_model_name":"doubao-seed-2-0-pro-260215","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":14096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}","blocks":[{"kind":"text","text":"哈哈","created_at":"2026-05-18T05:49:55.000Z","updated_at":"2026-05-18T05:49:55.000Z","id":"035C6BED-78F8-4CE0-B879-82E828316CEC"}]}]}
