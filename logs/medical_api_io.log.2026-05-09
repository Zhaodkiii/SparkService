b763749", "business_type": "medical_case", "business_id": "1", "object_key": "SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg", "storage_type": "oss", "created_at": "2026-05-09T00:09:39.000521Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg"}]}], "health_exam_reports": [], "examination_reports": [{"id": 2, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "内锐所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常；诊断：慢性非菱缩性胃炎伴胆汁反流；建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.634817Z", "updated_at": "2026-05-09T00:09:54.634829Z", "attachments": []}, {"id": 1, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "门（急）诊病历", "performed_at": "2026-02-06T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "主诉：要求口腔检查1天；现病史：今日来诊要求口腔检查；既往史：慢性疾病史：否认；其他：；过敏史：无；体格检查：皮肤黏膜：未检；胸部：未检；肺脏及胸膜：未检；心脏：未检；腹部：未检；神经反射：未检；其他专科检查：38/48近中低位阻生，远中牙龈覆盖，龈红肿；诊断：阻生牙 K01.100；处理措施：保持口腔卫生，建议择期拔除阻生牙", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.629258Z", "updated_at": "2026-05-09T00:09:54.629271Z", "attachments": []}], "medicine_boxes": [{"id": 1, "user": 1, "member": 1, "drug_name": "还好吧", "medicine_type": "uncategorized", "generic_name": "感冒呀", "brand_name": "把vv", "dosage_form": "把v", "strength": "20毫克", "total_quantity": 84548.0, "remaining_quantity": 484.0, "unit": "片", "expire_date": "2026-05-09", "production_batch": "", "notes": "", "ext