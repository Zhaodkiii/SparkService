b763749", "business_type": "medical_case", "business_id": "1", "object_key": "SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg", "storage_type": "oss", "created_at": "2026-05-09T00:09:39.000521Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/55818F88-0897-46E3-BE50-E9E2C674EBFD/photo_1EDE478E-ABD4-4EFC-B22F-AF01D2313A7B.jpg"}]}], "health_exam_reports": [{"id": 1, "user": 1, "member": 1, "institution_name": "苏州相城美年大健康体检中心", "report_no": "2025-05-17", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类），建议6～12个月复查，甲状腺专科随诊；2、舒张压偏低，建议多饮水，加强运动，结合病史必要时复测血压，若出现头昏、头晕、胸闷等症状，请及时心内科就诊；3、窦性心动过缓伴不齐，建议年度复查心电图和心脏超声，结合病史和症状心内科随诊；4、心电轴左偏，建议年度复查心电图和心脏超声，结合病史和症状心内科随诊；5、肝内钙化灶，建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊；6、超重，建议控制膳食总量，低脂、低糖饮食，增加新鲜蔬菜和水果比重，逐渐增加规律有氧运动，控制体重增长；7、血清总胆红素测定增高、血清直接胆红素测定增高，除外体液浓缩因素影响，建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊；8、血小板压积增高，建议结合病史和症状定期复查血常规，如有明显异常请内科就诊；9、左眼、右眼视力低于正常标准，增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-09T05:58:59.689065Z", "updated_at": "2026-05-09T05:58:59.689083Z", "attachments": [{"id": 12, "file_uuid": "4ae6517a-abe8-4d53-a9e8-afea15256dce", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "1", "object_key": "SparkClient/20260509/4AE6517A-ABE8-4D53-A9E8-AFEA15256DCE/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-09T05:58:28.911350Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260509/4AE6517A-ABE8-4D53-A9E8-AFEA15256DCE/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 2, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "内锐所见：食管：通过顺利，黏膜大致正常；贲门：开合伟通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常；诊断：慢性非菱缩性胃炎伴胆汁反流；建议：若有病理，请于35个工作日后在手机公众号上查询及去一楼或五楼的自助报告机取报告", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.634817Z", "updated_at": "2026-05-09T00:09:54.634829Z", "attachments": []}, {"id": 1, "user": 1, "member": 1, "medical_record": 1, "category": "imaging", "sub_category": "", "item_name": "门（急）诊病历", "performed_at": "2026-02-06T00:00:00Z", "reported_at": null, "organization_name": "", "department_name": "", "doctor_name": "", "findings": "主诉：要求口腔检查1天；现病史：今日来诊要求口腔检查；既往史：慢性疾病史：否认；其他：；过敏史：无；体格检查：皮肤黏膜：未检；胸部：未检；肺脏及胸膜：未检；心脏：未检；腹部：未检；神经反射：未检；其他专科检查：38/48近中低位阻生，远中牙龈覆盖，龈红肿；诊断：阻生牙 K01.100；处理措施：保持口腔卫生，建议择期拔除阻生牙", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-09T00:09:54.629258Z", "updated_at": "2026-05-09T00:09:54.629271Z", "attachments": []}], "medicine_boxes": [{"id": 3, "user": 1, "member": 1, "drug_name": "把v", "medicine_type": "vbb", "generic_name": "把vv", "brand_name": "把v额v", "dosage_form": "", "strength": "", "total_quantity": 30.0, "remaining_quantity": 30.0, "unit": "个", "expire_date": null, "production_batch": "", "notes": "", "extra": {}, "created_at": "2026-05-09T04:41:14.812610Z", "updated_at": "2026-05-09T04:59:57.502419Z"}, {"id": 4, "user": 1, "member": 1, "drug_name": "宝贝", "medicine_type": null, "generic_name": "哈哈", "brand_name": "", "dosage_form": "", "strength": "", "total_quantity": 508.0, "remaining_quantity": 80.0, "unit": "片", "expire_date": null, "production_batch": "", "notes": "", "extra": {}, "created_at": "2026-05-09T04:56:17.980127Z", "updated_at": "2026-05-09T04:56:17.980149Z"}, {"id": 2, "user": 1, "member": 1, "drug_name": "吧", "medicine_type": "感冒发烧", "generic_name": "把vbb", "brand_name": "", "dosage_form": "", "strength": "", "total_quantity": 888.0, "remaining_quantity": 880.0, "unit": "片", "expire_date