INFO 2026-05-22 20:48:47,916 chat_sync.sync [request_id=A184D1E4-A062-4E16-BED8-86232A04B81F] chat push payload request_id=A184D1E4-A062-4E16-BED8-86232A04B81F user_id=5 content_type=application/json body={"messages":[{"thread_id":"e37820f6-1d76-4e84-be4f-a25296fc0e73","role":"assistant","model_name":"doubao-seed-2-0-pro-260215","client_message_id":"5bebfb54-3266-4c20-b69d-9170cbccb731","delivery_state":"sending","created_at":"2026-05-22 20:48:02.208000+00:00","server_updated_at":"2026-05-22 20:48:47.085000+00:00","tombstone":false,"thread_current_model_name":"doubao-seed-2-0-pro-260215","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":14096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}","blocks":[{"order_key":2000,"id":"52A6C8D1-EAFE-54FA-9005-95996C7C8159","tool_call_id":"call_w5yzk5cv6d5bntlxd6w9ppsb","payload":{"tool":{"_0":{"name":"generate_structured_health_card","content":"【系统】结构化保存卡片正在后台生成中。请直接根据用户消息或对话中的相关原文进行专业解读，无需等待卡片即可继续回答；卡片生成后将显示在本条助手回复下方。若再次调用 generate_structured_health_card：raw_text 必须是你提炼后的医学要点，可选 oss_file_id 与消息中的 oss_file_id 一致，勿把完整 OCR 传给工具。","invocation_arguments":{"report_type":"exam_report","raw_text":"苏州大学附属第四医院2025-12-28生化+肾功能检验报告，受检人赵道凯，27岁男性，口腔科门诊，临床印象口腔黏膜溃疡。异常结果：天门冬氨酸氨基转移酶（AST）9.3U/L↓（参考15-40U/L），低密度脂蛋白胆固醇（LDL-C）3.51mmol/L↑（参考适宜<3.40mmol/L，增高3.40-4.14mmol/L）。其余指标：总胆红素13.5umol/L、直接胆红素4.2umol/L、间接胆红素9.3umol/L、丙氨酸氨基转移酶14.6U/L、总蛋白77.0g/L、白蛋白47.4g/L、球蛋白29.6g/L、白球比1.6、γ-谷氨酰转肽酶19.9U/L、碱性磷酸酶75.9U/L、前白蛋白287.0mg/L、尿素5.14mmol/L、肌酐77.50umol/L、尿酸324.6umol/L、胱抑素C0.76mg/L、葡萄糖5.42mmol/L、肌酸激酶104.3U/L、乳酸脱氢酶168.0U/L、α-羟丁酸脱氢酶140.4U/L、胆碱酯酶11124U/L、甘油三酯0.70mmol/L、总胆固醇5.07mmol/L、高密度脂蛋白胆固醇1.51mmol/L均在参考区间内。血脂分层提示当前LDL-C属于增高范围，对应健康人群降脂目标值<3.4mmol/L。"}}}},"updated_at":"2026-05-22T20:48:47.084Z","status":"ready","created_at":"2026-05-22T20:48:46.998Z","node_role":"tool","revision":1779482927084033},{"order_key":2100,"id":"AA71F73D-B754-511A-A7E1-7846EE0504AE","tool_call_id":"call_w5yzk5