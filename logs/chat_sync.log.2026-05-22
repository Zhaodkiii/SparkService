a_version":"health_workout_v1","generated_at":1779439213,"notes":[]}}},"status":"ready","id":"0CF314D3-C5ED-5D21-B0C6-769D5CF5CA6A","node_role":"toolPresentation","order_key":2100,"created_at":"2026-05-22T08:40:13.822Z","updated_at":"2026-05-22T08:40:13.822Z","anchor":{"value":"call_ohb12rbz3f6xc23wtlnu0n8y","type":"toolCall"},"tool_call_id":"call_ohb12rbz3f6xc23wtlnu0n8y","revision":1779439213821857,"parent_tool_call_id":"call_ohb12rbz3f6xc23wtlnu0n8y"},{"payload":{"text":{"_0":"### 近7天运动健康报告\n你这7天共进行2次羽毛球运动，总时长3小时2分钟，总消耗1545千卡，属于中等偏高的活动量，有以下健康提示：\n1. **强度风险提示**：两次运动的Z4（有氧强化）、Z5（极限负荷）区间占比合计都超过了60%，最高峰值心率达到195bpm，整体强度过高，长期维持这类高负荷运动容易增加心脏负担、提升运动损伤概率。\n2. **恢复能力待提升**：第一次运动后1分钟心率仅下降7bpm，恢复偏慢，建议你下次长时间高强度运动前做好10~15分钟动态热身，运动后不要立刻停下，做5~10分钟慢走+拉伸帮助心率回落。\n3. **运动频率建议**：7天仅2次运动，间隔有5天，建议每周保持3~4次中等强度运动（比如慢跑、快走，心率控制在最大心率的60%~70%，大概110~130bpm左右），更有助于维持心肺能力，也能避免突然高强度运动带来的不适。"}},"status":"ready","id":"4065B865-ECE1-5BB6-9D8E-2D6966F8742F","order_key":3000,"node_role":"timeline","created_at":"2026-05-22T08:40:22.389Z","updated_at":"2026-05-22T08:40:22.389Z","revision":1779439222389087}]}],"block_updates":[]}
