INFO 2026-05-22 21:00:15,798 chat_sync.sync [request_id=0727650E-0811-461D-8D4B-20E658AC36E3] chat push payload request_id=0727650E-0811-461D-8D4B-20E658AC36E3 user_id=5 content_type=application/json body={"messages":[],"block_updates":[{"thread_id":"e37820f6-1d76-4e84-be4f-a25296fc0e73","client_message_id":"72934360-5417-4d2e-ae70-95cb5c0265da","block":{"parent_tool_call_id":"call_5wn5jonfzrvr7eyfh6xj4397","tool_call_id":"call_5wn5jonfzrvr7eyfh6xj4397","order_key":2100,"created_at":"2026-05-22T20:59:30.587Z","updated_at":"2026-05-22T21:00:15.164Z","payload":{"structured_health_cards":{"_0":{"exam_reports":[{"draft_json":"{\"attachment_file_ids\":[],\"category\":\"laboratory\",\"content\":\"临床印象：口腔黏膜溃疡。检验结果：1. 异常指标：天门冬氨酸氨基转移酶（AST）9.3U\\/L，参考区间15-40U\\/L，结果降低；低密度脂蛋白胆固醇（LDL-C）3.51mmol\\/L，健康人群适宜参考区间<3.40mmol\\/L，结果轻度升高。2. 正常指标：总胆红素13.5μmol\\/L、直接胆红素4.2μmol\\/L、间接胆红素9.3μmol\\/L、丙氨酸氨基转移酶（ALT）14.6U\\/L、总蛋白77.0g\\/L、白蛋白47.4g\\/L、球蛋白29.6g\\/L、白蛋白\\/球蛋白1.6、γ-谷氨酰转肽酶（GGT）19.9U\\/L、碱性磷酸酶（ALP）75.9U\\/L、前白蛋白287.0mg\\/L；尿素5.14mmol\\/L、肌酐77.50μmol\\/L、尿酸324.6μmol\\/L、胱抑素C 0.76mg\\/L；空腹葡萄糖5.42mmol\\/L、肌酸激酶（CK）104.3U\\/L、乳酸脱氢酶（LDH）168.0U\\/L、α-羟丁酸脱氢酶（HBDH）140.4U\\/L、胆碱酯酶（CHE）11124U\\/L、甘油三酯（TG）0.70mmol\\/L、总胆固醇（TC）5.07mmol\\/L、高密度脂蛋白胆固醇（HDL-C）1.51mmol\\/L。\",\"date\":\"2025-12-28\",\"details\":[{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"L\",\"item_name\":\"天门冬氨酸氨基转移酶（AST）\",\"result_value\":\"9.3U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"H\",\"item_name\":\"低密度脂蛋白胆固醇（LDL-C）\",\"result_value\":\"3.51mmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"总胆红素\",\"result_value\":\"13.5μmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"直接胆红素\",\"result_value\":\"4.2μmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"间接胆红素\",\"result_value\":\"9.3μmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"丙氨酸氨基转移酶（ALT）\",\"result_value\":\"14.6U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"总蛋白\",\"result_value\":\"77.0g\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"白蛋白\",\"result_value\":\"47.4g\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"球蛋白\",\"result_value\":\"29.6g\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"白蛋白\\/球蛋白\",\"result_value\":\"1.6\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"γ-谷氨酰转肽酶（GGT）\",\"result_value\":\"19.9U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"碱性磷酸酶（ALP）\",\"result_value\":\"75.9U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"前白蛋白\",\"result_value\":\"287.0mg\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能检\",\"diagnosis\":\"阴性\",\"item_name\":\"尿素\",\"result_value\":\"5.14mmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能检\",\"diagnosis\":\"阴性\",\"item_name\":\"肌酐\",\"result_value\":\"77.50μmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能检\",\"diagnosis\":\"阴性\",\"item_name\":\"尿酸\",\"result_value\":\"324.6μmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"肾功能检\",\"diagnosis\":\"阴性\",\"item_name\":\"胱抑素C\",\"result_value\":\"0.76mg\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"空腹葡萄糖\",\"result_value\":\"5.42mmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"肌酸激酶（CK）\",\"result_value\":\"104.3U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"乳酸脱氢酶（LDH）\",\"result_value\":\"168.0U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"α-羟丁酸脱氢酶（HBDH）\",\"result_value\":\"140.4U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"胆碱酯酶（CHE）\",\"result_value\":\"11124U\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"甘油三酯（TG）\",\"result_value\":\"0.70mmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"总胆固醇（TC）\",\"result_value\":\"5.07mmol\\/L\",\"sort_order\":null},{\"attachment_file_ids\":[],\"category\":\"生化检验\",\"diagnosis\":\"阴性\",\"item_name\":\"高密度脂蛋白胆固醇（HDL-C）\",\"result_value\":\"1.51mmol\\/L\",\"sort_order\":null}],\"doctor\":\"口腔科门诊\",\"hospital\":\"苏州大学附属第四医院（苏州市独墅湖医院）\",\"title\":\"生化检验、肾功能检\"}","date_text":"2025-12-28","is_saved":true,"oss_file_id":586,"hospital":"苏州大学附属第四医院（苏州市独墅湖医院）","member_id":21,"title":"生化检验、肾功能检","id":"CE6A60EF-6B16-4470-A7FB-60114B19BA3B"}]}}},"parent_block_id":"E9EEA276-178D-5131-BF39-180503070A04","anchor":{"value":"call_5wn5jonfzrvr7eyfh6xj4397","type":"toolCall"},"node_role":"toolPresentation","status":"ready","revision":1779483570588174,"id":"A9DFDDCA-73B8-50DF-9459-0937FCE40379"}}]}
