rk 当前汇总为全量计数）\n成员：赵道凯\n关系：self\n病例数：1\n症状数：0\n就诊数：0\n手术数：0\n随访数：0\n检查报告数：4\n体检主表数：2\n医技明细数：0\n医疗报告数：0\n药箱药品数：0\n处方数：0\n服药计划数：0\n今日服药记录数：0"}}},"updated_at":"2026-05-22T09:30:50.245Z","tool_call_id":"call_00_CMpphDJdNA716ZAMylFW5064"},{"id":"422B96CC-3525-5008-B069-93FFEB24CB0C","node_role":"tool","order_key":6000,"revision":1779442250278593,"created_at":"2026-05-22T09:30:49.883Z","status":"ready","payload":{"tool":{"_0":{"name":"list_member_health_sources","content":"{\"version\":1,\"truncated\":false,\"member_id\":19,\"candidates\":[{\"match_reason\":\"符合当前筛选\",\"institution\":\"今日已服 0/0\",\"occurred_at\":\"2026-05-22\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":19,\"confidence\":0.55,\"resource_type\":\"medication_summary\",\"title\":\"用药统计\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"苏州大学附属第四医院（苏州市独墅湖医院）\",\"occurred_at\":\"2026-05-22\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":108,\"confidence\":0.55,\"resource_type\":\"examination_report\",\"title\":\"医疗报告\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"—\",\"occurred_at\":\"2026-05-21\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":37,\"confidence\":0.55,\"resource_type\":\"medical_case\",\"title\":\"哈哈\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"苏州工业园区星塘医院\",\"occurred_at\":\"2026-05-21\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":107,\"confidence\":0.55,\"resource_type\":\"examination_report\",\"title\":\"医疗报告\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"苏州大学附属第四医院（苏州市独墅湖医院）\",\"occurred_at\":\"2026-05-21\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":106,\"confidence\":0.55,\"resource_type\":\"examination_report\",\"title\":\"医疗报告\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"苏州大学附属第四医院\",\"occurred_at\":\"2026-05-21\",\"member_id\":19,\"matched_fields\":[],\"resource_id\":103,\"confidence\":0.55,\"resource_type\":\"examination_report\",\"title\":\"医疗报告\"},{\"match_reason\":\"符合当前筛选\",\"institution\":\"2025年5月17日\",\"occurred_at\":