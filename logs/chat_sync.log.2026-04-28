agent-BDF88EAF-6D5E-4308-B7BB-13F1E37C018C","client_message_id":"cca45408-5113-4581-a5fb-d49abda1ccda","delivery_state":"pending","created_at":"2026-04-28 01:15:44.362000+00:00","tombstone":false,"thread_current_model_name":"agent-BDF88EAF-6D5E-4308-B7BB-13F1E37C018C","thread_temperature":0.6,"thread_top_p":1.0,"thread_max_tokens":4096,"thread_max_messages":20,"thread_role_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。","thread_system_prompt":"你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。","attachments":[],"blocks":[],"reasoning_expanded":false,"reasoning_visibility":"full"}]}
