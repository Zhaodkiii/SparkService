INFO 2026-05-19 03:56:38,068 medical.api_io [request_id=3663285F-94D9-4D4A-A25D-C2A5A1D3EFA2] HTTP 响应摘要: GET /api/v1/medical/members/15/complete-data/ status=200 duration_ms=105 bytes=17553 headers={"Content-Type": "application/json", "ETag": "\"dcea4861bd7bae4a4e4357b6047534f7\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 15, "member": {"id": 15, "user": 3, "name": "规划", "gender": "male", "relationship": "younger_brother", "birth_date": "1998-05-19", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T17:00:14.416412Z", "updated_at": "2026-05-18T17:00:14.416434Z"}, "medical_cases": [{"id": 35, "member": 15, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，男，反复头晕2月，伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时，后自行缓解。社区医院头颅CT未见异常。2025-08-02就诊于苏州大学附属第四医院神经内科门诊，诊断为前庭性眩晕。2025-06-04苏州工业园区星塘医院颈椎CT示C4/5、C5/6椎间盘轻微突出、颈椎失稳。2025-07-05苏州大学附属第四医院血细胞分析+CRP、粪便检验未见明显异常。2026-02-10胃镜示慢性非萎缩性胃炎伴胆汁反流。2025-12-28生化检验、肾功能检验基本正常。2026-04-20皮肤科门诊诊断结膜炎，开具普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-18T17:04:10.578152Z", "updated_at": "2026-05-18T17:04:10.578172Z", "symptoms": ["头晕"], "medications": [], "attachments": []}], "health_exam_reports": [], "examination_reports": [{"id": 90, "user": 3, "member": 15, "medical_record": 35, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "食管：通过顺利，黏膜大致正常；贲门：开合通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相问，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T17:04:10.604737Z", "updated_at": "2026-05-18T17:04:10.604751Z", "attachments": [{"id": 429, "file_uuid": "a682508f-f3f1-4642-b02d-fc9934a5ee23", "original_name": "photo_682B21A5-F6B0-42DC-B2A4-4A720BBCA4CE.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "90", "object_key": "SparkClient/20260518/A682508F-F3F1-4642-B02D-FC9934A5EE23/photo_682B21A5-F6B0-42DC-B2A4-4A720BBCA4CE.jpg", "storage_type": "oss", "created_at": "2026-05-18T17:01:13.568623Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/A682508F-F3F1-4642-B02D-FC9934A5EE23/photo_682B21A5-F6B0-42DC-B2A4-4A720BBCA4CE.jpg"}]}, {"id": 92, "user": 3, "member": 15, "medical_record": 35, "category": "laboratory", "sub_category": "", "item_name": "检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "朱孝明", "findings": "生化检验、肾功能检验结果：总胆红素13.5，直接胆红素4.2，间接胆红素9.3，天门冬氨酸氨基转移酶13.5，丙氨酸氨基转移酶14.6，总蛋白77.0，白蛋白47.4，球蛋白29.6，白蛋白/球蛋白1.6，γ-谷氨酰转肽酶19.9，碱性磷酸酶75.9，总胆汁酸287.0，总胆红素5.14，直接胆红素77.50，间接胆红素324.6，等等。参考区间见报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T17:04:10.644021Z", "updated_at": "2026-05-18T17:04:10.644025Z", "attachments": [{"id": 430, "file_uuid": "33b5db4c-344e-4729-922b-76daddb6b0ac", "original_name": "photo_B5EC8B01-97A4-4330-9B97-1BA26B36D478.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "92", "object_key": "SparkClient/20260518/33B5DB4C-344E-4729-922B-76DADDB6B0AC/photo_B5EC8B01-97A4-4330-9B97-1BA26B36D478.jpg", "storage_type": "oss", "created_at": "2026-05-18T17:01:13.844553Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/33B5DB4C-344E-4729-922B-76DADDB6B0AC/photo_B5EC8B01-97A4-4330-9B97-1BA26B36D478.jpg"}]}, {"id": 93, "user": 3, "member": 15, "medical_record": 35, "category": "laboratory", "sub_category": "", "item_name": "检验报告单", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "严海荣", "findings": "粪便检验+隐血结果：颜色黄色，性状软便，白细胞未见，红细胞未见，吞噬细胞未见，淀粉颗粒未见，脂肪球未见，花粉未见，寄生虫未见，虫卵未见，夏科莱登结晶未见，孢子未见，菌丝未见，隐血阴性。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T17:04:10.664914Z", "updated_at": "2026-05-18T17:04:10.664918Z", "attachments": [{"id": 431, "file_uuid": "8721989c-62f0-41e6-a858-9d51fb5b6bfa", "original_name": "photo_578BEF17-D499-412B-A010-7DB98B82999D.jpg", "file_size": 660716, "mime_type": "image/jpeg", "file_md5": "e3086cf080cb57da5dee63211a761de0", "business_type": "examination_report", "business_id": "93", "object_key": "SparkClient/20260518/8721989C-62F0-41E6-A858-9D51FB5B6BFA/photo_578BEF17-D499-412B-A010-7DB98B82999D.jpg", "storage_type": "oss", "created_at": "2026-05-18T17:01:14.191542Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/8721989C-62F0-41E6-A858-9D51FB5B6BFA/photo_578BEF17-D499-412B-A010-7DB98B82999D.jpg"}]}, {"id": 91, "user": 3, "member": 15, "medical_record": 35, "category": "laboratory", "sub_category": "", "item_name": "检验报告单", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "严海荣", "findings": "血细胞分析+CRP结果：白细胞计数5.56，中性粒细胞计数3.24，淋巴细胞计数1.95，单核细胞计数0.34，嗜酸性粒细胞计数0.03，嗜碱性粒细胞计数0.00，中性粒细胞百分比58.2，淋巴细胞百分比35.1，单核细胞百分比6.1，嗜酸性粒细胞百分比0.6，嗜碱性粒细胞百分比0.0，红细胞计数4.74，血红蛋白141，红细胞比积41.30，红细胞平均体积87.2，红细胞平均血红蛋白量29.8，红细胞平均血红蛋白浓度341，红细胞分布宽度13.2，血小板计数270，血小板比积0.240，平均血小板体积8.9，血小板分布宽度16.0，超敏C反应蛋白0.93。参考区间见报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T17:04:10.609586Z", "updated_at": "2026-05-18T17:04:10.609592Z", "attachments": [{"id": 428, "file_uuid": "c28e065a-ded8-4ab8-bd00-4c4ab44d6e7d", "original_name": "photo_55DFC387-DB40-4509-99C2-CDCC5CA36D22.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "examination_report", "business_id": "91", "object_key": "SparkClient/20260518/C28E065A-DED8-4AB8-BD00-4C4AB44D6E7D/photo_55DFC387-DB40-4509-99C2-CDCC5CA36D22.jpg", "storage_type": "oss", "created_at": "2026-05-18T17:01:13.359343Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/C28E065A-DED8-4AB8-BD00-4C4AB44D6E7D/photo_55DFC387-DB40-4509-99C2-CDCC5CA36D22.jpg"}]}, {"id": 89, "user": 3, "member": 15, "medical_record": 35, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "仿德话", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压；骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T17:04:10.593098Z", "updated_at": "2026-05-18T17:04:10.593109Z", "attachments": [{"id": 427, "file_uuid": "389c2644-0e29-4d5e-b2f2-517a9fd5a752", "original_name": "photo_244BF086-8D33-4D08-9DEE-27913D466544.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "examination_report", "business_id": "89", "object_key": "SparkClient/20260518/389C2644-0E29-4D5E-B2F2-517A9FD5A752/photo_244BF086-8D33-4D08-9DEE-27913D466544.jpg", "storage_type": "oss", "created_at": "2026-05-18T17:01:12.443896Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/389C2644-0E29-4D5E-B2F2-517A9FD5A752/photo_244BF086-8D33-4D08-9DEE-27913D466544.jpg"}]}], "medicine_boxes": [{"id