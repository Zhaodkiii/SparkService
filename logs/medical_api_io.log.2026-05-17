ings": "临床印象：肠功能紊乱；送检项目：粪便检验+隐血；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.963658Z", "updated_at": "2026-05-14T08:25:05.963667Z", "attachments": []}, {"id": 48, "user": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（血细胞分析+CRP）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "冯玎琦", "findings": "临床印象：肠功能紊乱；送检项目：血细胞分析+CRP；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.918020Z", "updated_at": "2026-05-14T08:25:05.918032Z", "attachments": []}, {"id": 51, "user": 1, "member": 9, "medical_record": 21, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "仿德话", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.655958Z", "updated_at": "2026-05-14T09:01:03.655969Z", "attachments": []}, {"id": 46, "user": 1, "member": 9, "medical_record": 20, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "仿德话", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.906354Z", "updated_at": "2026-05-14T08:25:05.906367Z", "attachments": []}], "medicine_boxes": [{"id": 45, "user": 1, "member": 9, "medicine_type": null, "medicine_name": "甲磺酸倍他司汀片", "brand_name": "敏使朗", "dosage_form": "", "strength": "6mg/片", "dose_unit": "mg", "total_quantity": null, "expire_date": null, "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-17T09:35:25.356022Z", "updated_at": "2026-05-17T09:35:25.356034Z"}, {"id": 44, "user": 1, "member": 9, "medicine_type": null, "medicine_name": "盐酸氮卓斯汀滴眼液（爱赛平）", "brand_name": "", "dosage_form": "", "strength": "6ml:3mg（0.05%）", "dose_unit": "片", "total_quantity": null, "expire_date": null, "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-14T09:01:03.755743Z", "updated_at": "2026-05-14T09:01:03.755747Z"}, {"id": 43, "user": 1, "member": 9, "medicine_type": null, "medicine_name": "普拉洛芬滴眼液（普南扑灵）", "brand_name": "", "dosage_form": "", "strength": "5ml:5mg", "dose_unit": "片", "total_quantity": null, "expire_date": "2028-09-01", "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-14T09:01:03.750687Z", "updated_at": "2026-05-14T09:01:03.750691Z"}, {"id": 42, "user": 1, "member": 9, "medicine_type": null, "medicine_name": "甲磺酸倍他司汀片（敏使朗）", "brand_name": "", "dosage_form": "", "strength": "6mg", "dose_unit": "片", "total_quantity": null, "expire_date": null, "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-14T09:01:03.742833Z", "updated_at": "2026-05-14T09:01:03.742837Z"}], "prescriptions": [{"id": 7, "user": 1, "member": 9, "medical_case": 21, "prescriber_name": "", "institution_name": "苏州大学附属第四医院", "prescribed_at": "2026-04-20T00:00:00Z", "diagnosis": "结膜炎", "prescription_no": null, "status": "active", "extra": {"source": "combined_create"}, "attachments": [{"id": 22, 