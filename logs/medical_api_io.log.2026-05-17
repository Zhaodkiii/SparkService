INFO 2026-05-17 18:37:15,684 medical.api_io [request_id=692C874A-E5C6-4BF3-9982-AFB90EDE7602] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "192.168.31.192:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MDQ0NDQ2LCJpYXQiOjE3NzkwNDI2NDYsImp0aSI6ImQ2MzBlZjVjYmY0NDQwMTg5ZTE1MWJkMzI2NDQxYWJlIiwidXNlcl9pZCI6IjEifQ.48cJ4kzeY2anCJmBpl-TZ_RWtHMfgcxglxpFn_Hk5XQ", "X-Request-Id": "692C874A-E5C6-4BF3-9982-AFB90EDE7602", "Content-Length": "4465"} body={"member": {"id": 9}, "examination_reports": [{"item_name": "放射科诊断报告书", "details": [{"body_part": "颈椎、头颅", "category": "影像检查", "result_value": "1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "modality": "CT", "item_name": "颈椎椎间盘平扫+头颅平扫", "sub_category": "CT"}], "performed_at": "2025-06-04", "category": "imaging", "organization_name": "苏州工业园区星塘医院", "findings": "检查部位：颈椎椎间盘平扫，头颅平扫。检查所见：头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压；骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。"}, {"findings": "检查项目：无痛电子胃镜（不含麻醉费）。内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。建议：若有病理，请于35个工作日后任手机公众号上查询及去一楼或五楼的自助报告机取报告。", "category": "imaging", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10", "doctor_name": "欧啡；产珍", "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "details": [{"category": "内镜检查", "result_value": "慢性非萎缩性胃炎伴胆汁反流", "sub_category": "胃镜", "body_part": "食管、胃、十二指肠球部及降部", "item_name": "无痛电子胃镜", "modality": "电子胃镜"}]}], "symptom": {"duration_value": 2, "notes": "伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，无行走不稳", "duration_unit": "月", "severity": "medium", "name": "头晕"}, "prescriptions": [{"diagnosis": "前庭性眩晕", "prescribed_at": "2025-08-02", "status": "active", "extra": {"source": "typed_upload"}, "medication_plans": [{"dose_per_time": "6mg", "medicine_box": {"brand_name": "敏使朗", "medicine_name": "甲磺酸倍他司汀片", "notes": "", "strength": "6mg", "dosage_form": "", "extra": {"source": "typed_upload"}, "dose_unit": "片"}, "frequency_text": "每天3次，口服", "instructions": "", "dose_unit": "片", "start_date": "2026-05-18", "reminder_enabled": false, "reminder_times": [], "status": "active", "frequency_type": "daily", "extra": {"source": "typed_upload", "sort_order": "0"}, "drug_name": "甲磺酸倍他司汀片", "weekly_weekdays": []}]}], "medical_case": {"age_at_visit": 26, "title": "就诊病例", "diagnosis_summary": "患者赵道凯2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，头晕伴视物旋转、体位改变明显、恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍等不适，既往社区医院头颅CT无异常；2025年6月4日于苏州工业园区星塘医院行颈椎+头颅CT平扫，提示C4/5、C5/6椎间盘轻微突出等；2026年2月10日于苏州大学附属第四医院行胃镜检查诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚；鼻咽顶后壁软组织增厚", "extra": {"occurred_at": "2025-08-02", "source": "typed_upload"}, "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院"}, "visit": {"visit_type": "门诊", "department": "神经内科门诊", "visited_at": "2025-08-02", "visit_no": "0000349056"}, "source_file_ids": [329, 330, 331]}
