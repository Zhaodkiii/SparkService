INFO 2026-05-17 16:27:50,940 medical.api_io [request_id=F33079B9-AD7C-467C-A7F7-7E761B8EA019] HTTP 响应摘要: GET /api/v1/medical/members/9/complete-data/ status=200 duration_ms=114 bytes=21209 headers={"Content-Type": "application/json", "ETag": "\"38be1949a2275cc1bfbacb50b35119b4\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 9, "member": {"id": 9, "user": 1, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "2002-05-14", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-14T08:24:43.376165Z", "updated_at": "2026-05-14T08:24:43.376194Z"}, "medical_cases": [{"id": 22, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，26岁，反复头晕2月，伴视物旋转，体位改变时症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，社区医院头颅CT未见异常。2025-07-05于苏州大学附属第四医院消化内科门诊就诊，临床印象肠功能紊乱，行血细胞分析+CRP检查结果均正常；2025-08-02于该院神经内科门诊初诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。\n\n肠功能紊乱；前庭性眩晕", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T09:35:25.261827Z", "updated_at": "2026-05-17T09:35:25.261849Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 258, "file_uuid": "2296ea84-d29f-4424-b117-2d7acccc1f68", "original_name": "photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:33.362500Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg"}, {"id": 257, "file_uuid": "d4314d83-dec6-4592-b25e-be5d2fed17ac", "original_name": "photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:31.646877Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg"}]}, {"id": 21, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T09:01:03.644379Z", "updated_at": "2026-05-14T09:01:03.644406Z", "symptoms": ["头晕"], "medications": [], "attachments": []}, {"id": 20, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T08:25:05.894058Z", "updated_at": "2026-05-14T08:25:05.894078Z", "symptoms": ["头晕"], "medications": [], "attachments": []}], "health_exam_reports": [], "examination_reports": [{"id": 52, "user": 1, "member": 9, "medical_record": 21, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.664050Z", "updated_at": "2026-05-14T09:01:03.664063Z", "attachments": []}, {"id": 47, "user": 1, "member": 9, "medical_record": 20, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.912584Z", "updated_at": "2026-05-14T08:25:05.912595Z", "attachments": []}, {"id": 55, "user": 1, "member": 9, "medical_record": 21, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（生化检验、肾功能检验）", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "王斐", "findings": "临床印象：口腔黏膜溃疡；送检项目：生化检验，肾功能检验；低密度脂蛋白胆固醇3.511mmol/L略高于适宜范围，其余无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.719541Z", "updated_at": "2026-05-14T09:01:03.719545Z", "attachments": []}, {"id": 50, "user": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（生化检验、肾功能检验）", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "王斐", "findings": "临床印象：口腔黏膜溃疡；送检项目：生化检验，肾功能检验；低密度脂蛋白胆固醇3.511mmol/L略高于适宜范围，其余无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.989640Z", "updated_at": "2026-05-14T08:25:05.989650Z", "attachments": []}, {"id": 56, "user": 1, "member": 9, "medical_record": 22, "category": "laboratory", "sub_category": "", "item_name": "血细胞分析+CRP检验报告单", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "钱思程；冯玎琦", "findings": "标本为静脉全血，临床印象肠功能紊乱，行血细胞分析+CRP检查，所有项目结果均在参考区间内。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-17T09:35:25.278120Z", "updated_at": "2026-05-17T09:35:25.278141Z", "attachments": []}, {"id": 54, "user": 1, "member": 9, "medical_record": 21, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（粪便检验+隐血）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "丁海浜", "findings": "临床印象：肠功能紊乱；送检项目：粪便检验+隐血；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.702937Z", "updated_at": "2026-05-14T09:01:03.702941Z", "attachments": []}, {"id": 53, "user": 1, "member": 9, "medical_record": 21, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（血细胞分析+CRP）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "冯玎琦", "findings": "临床印象：肠功能紊乱；送检项目：血细胞分析+CRP；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.668797Z", "updated_at": "2026-05-14T09:01:03.668805Z", "attachments": []}, {"id": 49, "user": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（粪便检验+隐血）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "丁海浜", "findings": "临床印象：肠功能紊乱；送检项目：粪便检验+隐血；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.963658Z", "updated_at": "2026-05-14T08:25:05.963667Z", "attachments": []}, {"id": 48, "user": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（血细胞分析+CRP）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "冯玎琦", "findings": "临床印象：肠功能紊乱；送检项目：血细胞分析+CRP；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.918020Z", "updated_at": "2026-05-14T08:25:05.918032Z", "attachments": []}, {"id": 51, "user": 1, "member": 9, "medical_record": 21, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "仿德话", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.655958Z", "updated_at": "2026-05-14T09:01:03.655969Z", "attachments": []}, {"id": 46, "user": 1, "member": 9, "medical_record": 20, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "仿德话", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "i