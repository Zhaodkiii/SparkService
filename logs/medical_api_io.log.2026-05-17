INFO 2026-05-17 18:18:14,665 medical.api_io [request_id=0D6E040D-E751-461D-B250-90C60CCAA7CB] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "192.168.31.192:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MDQyNjc1LCJpYXQiOjE3NzkwNDA4NzUsImp0aSI6IjA3NDY2ZTRlMTkyNzQxNDY4ZWFiMGVjYjg4YTdjNzdmIiwidXNlcl9pZCI6IjEifQ.InK_9YueV65hZUWMODjEleXYSuBrzD355kFxAxcsujA", "X-Request-Id": "0D6E040D-E751-461D-B250-90C60CCAA7CB", "Content-Length": "5336"} body={"examination_reports": [{"details": [{"diagnosis": "头颅CT平扫未见明显异常；C4/5、C5/6椎间盘轻微突出；颈椎失稳；鼻咽顶后壁软组织增厚；两侧颈部、颌下区多发小淋巴结；右侧声带稍厚", "sub_category": "颈椎椎间盘平扫，头颅平扫", "result_value": "1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；所示右侧声带相对稍厚。", "modality": "CT", "category": "CT检查", "body_part": "颈椎；头颅"}], "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；所示右侧声带相对稍厚。", "item_name": "放射科诊断报告书", "doctor_name": "天聚定；仿德话", "category": "imaging", "organization_name": "苏州工业园区星塘医院", "performed_at": "2025-06-04"}, {"details": [{"diagnosis": "慢性非萎缩性胃炎伴胆汁反流", "sub_category": "无痛电子胃镜", "result_value": "慢性非萎缩性胃炎伴胆汁反流", "body_part": "食管；胃；十二指肠", "category": "内镜检查"}], "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。", "item_name": "胃镜诊断报告单", "doctor_name": "欧啡；产珍", "category": "imaging", "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "performed_at": "2026-02-10"}], "medical_case": {"extra": {"occurred_at": "2025-08-02", "source": "typed_upload"}, "hospital_name": "苏州工业园区星塘医院；苏州大学附属第四医院（苏州市独墅湖医院）", "title": "就诊病例", "diagnosis_summary": "患者赵道凯27岁，2025年6月4日于苏州工业园区星塘医院行颈椎椎间盘平扫+头颅平扫CT，提示头颅CT无明显异常，C4/5、C5/6椎间盘轻微突出、颈椎失稳，鼻咽顶后壁软组织增厚、两侧颈部颌下多发小淋巴结、右侧声带稍厚。2025年8月2日因反复头晕2月至苏州大学附属第四医院神经内科门诊就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流", "age_at_visit": 27}, "prescriptions": [{"extra": {"source": "typed_upload"}, "status": "active", "medication_plans": [{"drug_name": "甲磺酸倍他司汀片", "dose_per_time": "6mg", "weekly_weekdays": [], "reminder_enabled": false, "status": "active", "instructions": "", "reminder_times": [], "dose_unit": "片", "medicine_box": {"extra": {"source": "typed_upload"}, "notes": "", "dosage_form": "", "medicine_name": "甲磺酸倍他司汀片", "dose_unit": "片", "strength": "", "brand_name": "敏使朗"}, "start_date": "2026-05-18", "frequency_type": "daily", "frequency_text": "每天3次，口服", "extra": {"source": "typed_upload", "sort_order": "0"}}, {"drug_name": "复方双花口服液", "dose_per_time": "20ml", "weekly_weekdays": [], "reminder_enabled": false, "status": "active", "instructions": "疗程3天，成人一次20ml，一日4次", "reminder_times": [], "dose_unit": "片", "medicine_box": {"extra": {"source": "typed_upload"}, "dosage_form": "口服液", "notes": "", "medicine_name": "复方双花口服液", "total_quantity": "12", "dose_unit": "片", "strength": "10ml/支", "brand_name": ""}, "start_date": "2026-05-18", "frequency_type": "daily", "frequency_text": "一日4次", "extra": {"source": "typed_upload", "sort_order": "1"}}, {"drug_name": "普拉洛芬滴眼液", "dose_per_time": "片", "weekly_weekdays": [], "reminder_enabled": false, "status": "active", "instructions": "", "reminder_times": [], "dose_unit": "片", "medicine_box": {"extra": {"source": "typed_upload"}, "dosage_form": "滴眼液", "notes": "", "medicine_type": "uncategorized", "medicine_name": "普拉洛芬滴眼液", "dose_unit": "片", "strength": "5ml:5mg", "brand_name": "普南扑灵"}, "start_date": "2026-05-18", "frequency_type": "daily", "frequency_text": "按医嘱", "extra": {"sort_order": "2", "source": "typed_upload"}}]}], "symptom": {"name": "头晕", "notes": "伴视物旋转，体位改变时症状明显，伴恶心呕吐，每次持续2小时后可自行缓解，无肢体活动障碍及行走不稳", "duration_value": 2, "duration_unit": "月"}, "visit": {"visit_type": "门诊", "visit_no": "0000349056", "visited_at": "2025-08-02", "department": "神经内科门诊"}, "member": {"id": 9}, "source_file_ids": [323, 324, 325, 326, 327, 328]}
