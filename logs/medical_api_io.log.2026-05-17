40", "reference_range": "0.11--0.28", "result_at": "2025-07-05", "item_code": "PCT", "category": "血细胞分析"}, {"unit": "fL", "item_code": "MPV", "item_name": "平均血小板体积", "category": "血细胞分析", "result_at": "2025-07-05", "reference_range": "6.5--12fL", "result_value": "8.9"}, {"item_name": "血小板分布宽度", "result_value": "16.0", "reference_range": "≤17", "result_at": "2025-07-05", "item_code": "PDW", "category": "血细胞分析"}, {"result_value": "0.93", "unit": "mg/L", "item_code": "hs-CRP", "result_at": "2025-07-05", "reference_range": "0--6mg/L", "category": "炎症指标", "item_name": "超敏C反应蛋白"}], "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "doctor_name": "钱思程；冯玎琦", "performed_at": "2025-07-05", "findings": "标本为静脉全血，临床印象肠功能紊乱，行血细胞分析+CRP检查，所有项目结果均在参考区间内。", "item_name": "血细胞分析+CRP检验报告单", "category": "laboratory"}], "member": {"id": 9}, "medical_case": {"title": "就诊病例", "diagnosis_summary": "患者赵道凯，26岁，反复头晕2月，伴视物旋转，体位改变时症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，社区医院头颅CT未见异常。2025-07-05于苏州大学附属第四医院消化内科门诊就诊，临床印象肠功能紊乱，行血细胞分析+CRP检查结果均正常；2025-08-02于该院神经内科门诊初诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。\n\n肠功能紊乱；前庭性眩晕", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 26, "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}}, "symptom": {"body_part": "头部", "notes": "伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，无行走不稳", "name": "头晕", "duration_value": 2, "severity": "medium", "duration_unit": "月"}, "source_file_ids": [257, 258], "visit": {"visit_type": "门诊", "visited_at": "2025-08-02", "doctor_name": "严海荣", "department": "神经内科门诊", "visit_no": "0000349056"}, "prescriptions": [{"prescribed_at": "2025-08-02", "status": "active", "medication_plans": [{"status": "active", "frequency_text": "每天3次口服", "frequency_type": "daily", "reminder_enabled": false, "weekly_weekdays": [], "dose_value": "6", "reminder_times": [], "start_date": "2026-05-17", "dose_per_time": "6mg", "instructions": "口服，每次6mg，每天3次", "medicine_box": {"brand_name": "敏使朗", "medicine_name": "甲磺酸倍他司汀片", "dose_unit": "mg", "dosage_form": "", "strength": "6mg/片"