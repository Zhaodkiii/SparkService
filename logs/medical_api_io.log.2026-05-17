69691b7a859c", "original_name": "photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/DEC4B083-2534-4B10-A28A-69691B7A859C/photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.281020Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/DEC4B083-2534-4B10-A28A-69691B7A859C/photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg"}, {"id": 323, "file_uuid": "38d7a992-4f75-4044-9e8e-d2699e42c7e2", "original_name": "photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/38D7A992-4F75-4044-9E8E-D2699E42C7E2/photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:30.971371Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/38D7A992-4F75-4044-9E8E-D2699E42C7E2/photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg"}]}, {"id": 22, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，26岁，反复头晕2月，伴视物旋转，体位改变时症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，社区医院头颅CT未见异常。2025-07-05于苏州大学附属第四医院消化内科门诊就诊，临床印象肠功能紊乱，行血细胞分析+CRP检查结果均正常；2025-08-02于该院神经内科门诊初诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。\n\n肠功能紊乱；前庭性眩晕", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T09:35:25.261827Z", "updated_at": "2026-05-17T09:35:25.261849Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 258, "file_uuid": "2296ea84-d29f-4424-b117-2d7acccc1f68", "original_name": "photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:33.362500Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg"}, {"id": 257, "file_uuid": "d4314d83-dec6-4592-b25e-be5d2fed17ac", "original_name": "photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:31.646877Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg"}]}, {"id": 21, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T09:01:03.644379Z", "updated_at": "2026-05-14T09:01:03.644406Z", "symptoms": ["头晕"], "medications": [], "attachments": []}, {"id": 20, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T08:25:05.894058Z", "updated_at": "2026-05-14T08:25:05.894078Z", "symptoms": ["头晕"], "medications": [], "attachments": []}], "health_exam_reports": [], "examination_reports": [{"id": 65, "user": 1, "member": 9, "medical_record": 29, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡；产珍", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-17T18:29:10.806267Z", "updated_at": "2026-05-17T18:29:10.806279Z", "attachments": []}, {"id": 52, "user": 1, "member": 9, "medical_record": 21, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T09:01:03.664050Z", "updated_at": "2026-05-14T09:01:03.664063Z", "attachments": []}, {"id": 47, "user": 1, "member": 9, "medical_record": 20, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未