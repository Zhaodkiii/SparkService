INFO 2026-05-17 23:57:47,152 medical.api_io [request_id=D10BF711-ECDF-4A32-8A4D-C85054EF68B9] HTTP 响应摘要: GET /api/v1/medical/members/8/complete-data/ status=200 duration_ms=73 bytes=24618 headers={"Content-Type": "application/json", "ETag": "\"d611c6bc944ef811303d187bbf1e98c9\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 8, "member": {"id": 8, "user": 1, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "1998-10-29", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-14T07:59:05.316401Z", "updated_at": "2026-05-14T07:59:05.316429Z"}, "medical_cases": [{"id": 19, "member": 8, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T08:24:17.279741Z", "updated_at": "2026-05-14T08:24:17.279769Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 135, "file_uuid": "e5589a0a-eba5-48f7-9c54-96eddbbab343", "original_name": "photo_693DDE9D-B42A-45FA-A48C-071E39030546.jpg", "file_size": 905160, "mime_type": "image/jpeg", "file_md5": "122088e38f06563b55d360e1d5a2fd19", "business_type": "medical_case", "business_id": "19", "object_key": "SparkClient/20260514/E5589A0A-EBA5-48F7-9C54-96EDDBBAB343/photo_693DDE9D-B42A-45FA-A48C-071E39030546.jpg", "storage_type": "oss", "created_at": "2026-05-14T08:12:42.753548Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260514/