INFO 2026-05-17 18:30:46,607 medical.api_io [request_id=4F79E3E9-9B24-44DB-94DF-4565BDE86DF8] HTTP 响应摘要: GET /api/v1/medical/members/9/complete-data/ status=200 duration_ms=68 bytes=31855 headers={"Content-Type": "application/json", "ETag": "\"4b054acd137feaf6de2c6625ce248f95\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 9, "member": {"id": 9, "user": 1, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "2002-05-14", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-14T08:24:43.376165Z", "updated_at": "2026-05-14T08:24:43.376194Z"}, "medical_cases": [{"id": 29, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州工业园区星塘医院；苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯27岁，2025年6月4日于苏州工业园区星塘医院行颈椎椎间盘平扫+头颅平扫CT，提示头颅CT无明显异常，C4/5、C5/6椎间盘轻微突出、颈椎失稳，鼻咽顶后壁软组织增厚、两侧颈部颌下多发小淋巴结、右侧声带稍厚。2025年8月2日因反复头晕2月至苏州大学附属第四医院神经内科门诊就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T18:29:10.790943Z", "updated_at": "2026-05-17T18:29:10.790969Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 328, "file_uuid": "17e9ca4c-0d0b-4b4c-ae60-8712023f8424", "original_name": "photo_CDA5B7B0-2EC3-4083-A907-190F2480CC7D.jpg", "file_size": 905160, "mime_type": "image/jpeg", "file_md5": "122088e38f06563b55d360e1d5a2fd19", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/17E9CA4C-0D0B-4B4C-AE60-8712023F8424/photo_CDA5B7B0-2EC3-4083-A907-190F2480CC7D.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.796614Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/17E9CA4C-0D0B-4B4C-AE60-8712023F8424/photo_CDA5B7B0-2EC3-4083-