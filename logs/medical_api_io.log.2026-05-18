INFO 2026-05-18 16:58:27,386 medical.api_io [request_id=9B634207-44B7-4BA6-81BE-F225F33A3D6B] HTTP 响应摘要: GET /api/v1/medical/members/13/complete-data/ status=200 duration_ms=51 bytes=17693 headers={"Content-Type": "application/json", "ETag": "\"5fcbffc48e921db7e17f3b108b28a132\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 13, "member": {"id": 13, "user": 3, "name": "是我", "gender": "male", "relationship": "self", "birth_date": "1998-05-18", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T14:09:31.235918Z", "updated_at": "2026-05-18T14:09:31.235932Z"}, "medical_cases": [{"id": 34, "member": 13, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院；苏州工业园区星塘医院", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，反复头晕2月，伴视物旋转、恶心呕吐，社区医院头颅CT无异常，诊断前庭性眩晕；多次就诊于苏州大学附属第四医院、苏州工业园区星塘医院，行头颅CT、颈椎CT、粪便检验、血常规、生化检验、胃镜等检查，胃镜诊断慢性非萎缩性胃炎伴胆汁反流，门诊诊断结膜炎，予药物治疗\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-18T14:14:24.980270Z", "updated_at": "2026-05-18T14:14:24.980296Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 414, "file_uuid": "abb68d13-ea72-4507-a954-c45dd26b5d85", "original_name": "photo_AFC8DD8C-94E3-4F0B-AB7F-A012725064F1.jpg", "file_size": 3462115, "mime_type": "image/jpeg", "file_md5": "51bde0358dfb7324a9fbe95b4fed90b0", "business_type": "medical_case", "business_id": "34", "object_key": "SparkClient/20260518/ABB68D13-EA72-4507-A954-C45DD26B5D85/photo_AFC8DD8C-94E3-4F0B-AB7F-A012725064F1.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:11.216902Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/ABB68D13-EA72-4507-A954-C45DD26B5D85/photo_AFC8DD8C-94E3-4F0B-AB7F-A012725064F1.jpg"}]}], "health_exam_reports": [], "examination_reports": [{"id": 86, "user": 3, "member": 13, "medical_record": 34, "category": "imaging", "sub_category": "", "item_name": "苏州大学附属第四医院无痛电子胃镜报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "食管通过顺利，黏膜大致正常；贲门开合通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.030053Z", "updated_at": "2026-05-18T14:14:25.030065Z", "attachments": [{"id": 412, "file_uuid": "51d1ab7f-ab9d-48a4-b90d-534f700db6d0", "original_name": "photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "86", "object_key": "SparkClient/20260518/51D1AB7F-AB9D-48A4-B90D-534F700DB6D0/photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:10.089058Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/51D1AB7F-AB9D-48A4-B90D-534F700DB6D0/photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg"}]}, {"id": 85, "user": 3, "member": 13, "medical_record": 34, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院生化检验+肾功能检验报告", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "魏舟轩", "findings": "标本为静脉血清，总胆红素、直接胆红素、间接胆红素、乳酸脱氢酶等各项指标均在参考范围内，甘油三酯0.70mmol/L、总胆固醇5.07mmol/L、高密度脂蛋白胆固醇1.51mmol/L、低密度脂蛋白胆固醇3.511mmol/L，均符合参考区间，检验建议结合疾病特点咨询专科医生", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.023658Z", "updated_at": "2026-05-18T14:14:25.023675Z", "attachments": [{"id": 411, "file_uuid": "eea308b0-90c8-403b-959d-fe867b171632", "original_name": "photo_55AB5805-22D5-488E-B128-92AEE123A30E.jpg", "file_size": 479578, "mime_type": "image/jpeg", "fi