INFO 2026-05-18 13:39:23,367 medical.api_io [request_id=82178CF3-D898-4A58-B474-97773443641A] HTTP 响应摘要: GET /api/v1/medical/members/11/complete-data/ status=200 duration_ms=100 bytes=22431 headers={"Content-Type": "application/json", "ETag": "\"736b800552785948f607805f787ce185\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 11, "member": {"id": 11, "user": 3, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "1998-05-18", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T07:48:15.645511Z", "updated_at": "2026-05-18T07:48:15.645536Z"}, "medical_cases": [{"id": 32, "member": 11, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州工业园区星塘医院；苏州大学附属第四医院；苏州市独墅湖医院", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯，2025-08-02于苏州大学附属第四医院神经内科门诊就诊，主诉反复头晕2月，伴视物旋转、恶心呕吐，体位改变时明显，社区医院头颅CT未见异常；2025-07-05于该院消化内科门诊就诊，临床印象肠功能紊乱，粪便检验未见异常；2025-12-28于该院口腔科门诊就诊，临床印象口腔黏膜溃疡，生化检验未见明显异常；2026-02-10于该院消化内科门诊行无痛电子胃镜检查，诊断慢性非萎缩性胃炎伴胆汁反流；2025-06-04于苏州工业园区星塘医院放射科行颈椎及头颅CT检查，见颈椎失稳、C4/5、C5/6椎间盘轻微突出、两侧颈部颌下区多发小淋巴结等；2026-04-20于该院皮肤科门诊就诊，诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；口腔黏膜溃疡；结膜炎；颈椎失稳；C4/5、C5/6椎间盘轻微突出；两侧颈部、颌下区多发小淋巴结", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-18T13:39:16.285013Z", "updated_at": "2026-05-18T13:39:16.285034Z", "symptoms": ["头晕"], "medications": [], "attachments": []}], "health_exam_reports": [{"id": 2, "user": 3, "member": 11, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）：建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:(108/57mmHg)：建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分：无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏：建议年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶：建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数24.1kg/m²)：建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高:24.7umol/L(参考区间:≤23)、血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80)：建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:0.29%(参考区间:0.10-0.28)：建议结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准(裸眼视力-左眼0.8)、右眼视力低于正常标准(裸眼视力-右眼0.8)：增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-18T08:29:43.894014Z", "updated_at": "2026-05-18T08:29:43.894052Z", "attachments": [{"id": 349, "file_uuid": "089aa086-f849-4275-ba6c-08dd27b02e78", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "2", "object_key": "SparkClient/20260518/089AA086-F849-4275-BA6C-08DD27B02E78/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-18T08:28:09.024904Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/089AA086-F849-4275-BA6C-08DD27B02E78/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 76, "user": 3, "member": 11, "medical_record": 32, "category": "imaging", "sub_category": "", "item_name": "苏州大学附属第四医院无痛电子胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "食管黏膜大致正常，贲门开合通畅，胃底见胆汁残留，胃体黏膜正常，胃角光整，胃窦黏膜红白相间以红为主，幽门圆开放好，十二指肠球部及所见降部未见明显异常；诊断慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:39:16.337123Z", "updated_at": "2026-05-18T13:39:16.337133Z", "attachments": [{"id": 381, "file_uuid": "ade96e5b-10bb-40bd-9942-8c5d927d8b34", "original_name": "photo_A176FD72-8B1B-4732-A424-93137EF7621A.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "76", "object_key": "SparkClient/20260518/ADE96E5B-10BB-40BD-9942-8C5D927D8B34/photo_A176FD72-8B1B-4732-A424-93137EF7621A.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:36:32.697626Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/ADE96E5B-10BB-40BD-9942-8C5D927D8B34/photo_A176FD72-8B1B-4732-A424-93137EF7621A.jpg"}]}, {"id": 74, "user": 3, "member": 11, "medical_record": 32, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院生化检验报告单", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "魏舟轩", "findings": "各项生化指标基本正常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:39:16.323895Z", "updated_at": "2026-05-18T13:39:16.323906Z", "attachments": [{"id": 382, "file_uuid": "a3435545-e9fa-484b-94c5-b7bb40f4ea18", "original_name": "photo_0F33115A-CA11-45B8-8AB2-8C9DEE4CFDDD.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "examination_report", "business_id": "74", "object_key": "SparkClient/20260518/A3435545-E9FA-484B-94C5-B7BB40F4EA18/photo_0F33115A-CA11-45B8-8AB2-8C9DEE4CFDDD.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:36:33.091837Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/A3435545-E9FA-484B-94C5-B7BB40F4EA18/photo_0F33115A-CA11-45B8-8AB2-8C9DEE4CFDDD.jpg"}]}, {"id": 75, "user": 3, "member": 11, "medical_record": 32, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院血细胞分析+CRP报告单", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "钱思程", "findings": "白细胞计数、红细胞计数、血小板计数等各项血细胞指标及超敏C反应蛋白均正常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:39:16.331232Z", "updated_at": "2026-05-18T13:39:16.331244Z", "attachments": [{"id": 380, "file_uuid": "f332310e-1072-4722-a37d-1e2b815d5c96", "original_name": "photo_C47BF391-3974-45F7-9B64-3E5E0E01E706.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "75", "object_key": "SparkClient/20260518/F332310E-1072-4722-A37D-1E2B815D5C96/photo_C47BF391-3974-45F7-9B64-3E5E0E01E706.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:36:32.535630Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/F332310E-1072-4722-A37D-1E2B815D5C96/photo_C47BF391-3974-45F7-9B64-3E5E0E01E706.jpg"}]}, {"id": 73, "user": 3, "member": 11, "medical_record": 32, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院粪便检验报告单", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "铉思程", "findings": "粪便颜色黄色，性状软便；粪白细胞、粪红细胞、吞噬细胞、淀粉颗粒、脂肪球、花粉、寄生虫、虫卵、夏科莱登结晶、孢子、菌丝、隐血均阴性或未见", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:39:16.315696Z", "updated_at": "2026-05-18T13:39:16.315707Z", "attachments": [{"id": 378, "file_uuid": "d3fcefdb-ec78-416a-84fb-5801e75008fd", "original_name": "photo_E62640CD-7BB6-445A-853D-C178DA44968C.jpg", "file_size": 660716, "mime_type": "image/jpeg", "file_md5": "e3086cf080cb57da5dee63211a761de0", "business_type": "examination_report", "business_id": "73", "object_key": "SparkClient/20260518/D3FCEFDB-EC78-416A-84FB-5801E75008FD/photo_E62640CD-7BB6-445A-853D-C178DA44968C.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:36:31.031237Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/D3FCEFDB-EC78-416A-84FB-5801E75008FD/photo_E62640CD-7BB6-445A-853D-C178DA44968C.jpg"}]}, {"id": 72, "user": 3, "member": 11, "medical_record": 32, "category": "imaging", "sub_category": "", "item_name": "苏州工业园区星塘医院放射科颈椎椎间盘平扫头颅平扫报告", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "天聚定", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:39:16.302104Z", "updated_at": "2026-05-18T13:39:16.302119Z", "attachments": [{"id": 377, "file_uuid": "77325877-eae5-4c34-aea8-3df700390220", "original_name": "photo_51132406-E50D-46CF-9AA7-56DA179EB568.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "examination_report", "business_id": "72", "object_key": "SparkClient/20260518/77325877-EAE5-4C34-AEA8-3DF700390220/photo_51132406-E50D-46CF-9AA7-56DA179EB568.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:36:30.620077Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/77325877-EAE5-4C34-AEA8-3DF700390220/photo_51132406-E50D-46CF-9AA7-56DA179EB568.jpg"}]}, {"id": 71, "user": 3, "member": 11, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-18T08:01:13.317723Z", "updated_at": "2026-05-18T08:01:13.317736Z", "attachments": [{"id": 345, "file_uuid": "7130c5b4-6212-4c92-aa89-305ca4028084", "original_name": "photo_4EFCAE7A-275F-48DD-B19F-2CFC9AA3534F.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "71", "object_key": "SparkClient/20260518/7130C5B4-6212-4C92-AA89-305CA4028084/photo_4EFCAE7A-275F-48DD-B19F-2CFC9AA3534F.jpg", "storage_type": "oss", "created_at": "2026-05-18T08:00:27.535682Z", "file_url": "https://zhaodkdream.oss-cn-beijin