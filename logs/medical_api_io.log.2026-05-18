": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（粪便检验+隐血）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "丁海浜", "findings": "临床印象：肠功能紊乱；送检项目：粪便检验+隐血；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.963658Z", "updated_at": "2026-05-14T08:25:05.963667Z", "attachments": []}, {"id": 48, "user": 1, "member": 9, "medical_record": 20, "category": "laboratory", "sub_category": "", "item_name": "检验报告单（血细胞分析+CRP）", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "冯玎琦", "findings": "临床印象：肠功能紊乱；送检项目：血细胞分析+CRP；结果无明显异常", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-14T08:25:05.918020Z", "updated_at": "2026-05-14T08:25:05.918032Z", "attachments": []}, {"id": 66, "user": 1, "member": 9, "medical_record": 30, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "", "findings": "检查部位：颈椎椎间盘平扫，头颅平扫。检查所见：头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压；骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-17T18:37:15.711627Z", "updated_at": "2026-05-17T18:37:15.711633Z", "attachments": []}, {"id": 64, "user": 1, "member": 9, "medical_record": 29, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "天聚定；仿德话", "findi