INFO 2026-05-18 13:16:12,783 medical.api_io [request_id=6FECCA5C-E9AC-420B-ABC0-AA3EE6D63C11] HTTP 响应摘要: GET /api/v1/medical/members/10/complete-data/ status=200 duration_ms=69 bytes=8171 headers={"Content-Type": "application/json", "ETag": "\"7c571945df4ea99132eafeddb9d58651\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 10, "member": {"id": 10, "user": 3, "name": "赵道凯", "gender": "male", "relationship": "self", "birth_date": "1999-10-29", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T05:06:48.706823Z", "updated_at": "2026-05-18T05:06:48.706851Z"}, "medical_cases": [{"id": 31, "member": 10, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025-08-02在苏州大学附属第四医院神经内科门诊就诊，反复头晕2月，伴视物旋转、恶心呕吐，每次持续2小时自行缓解，社区医院头颅CT无异常，诊断为前庭性眩晕；2026-04-20在该院皮肤科门诊就诊，诊断为结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液滴眼治疗\n\n前庭性眩晕；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-18T05:28:27.445010Z", "updated_at": "2026-05-18T05:28:27.445039Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 340, "file_uuid": "ea9d0c7a-e2fd-4794-90b8-dac628adb058", "original_name": "photo_6459C6CF-5F6E-48D9-9D2E-ACDA2078C4BE.jpg", "file_size": 2347376, "mime_type": "image/jpeg", "file_md5": "5cd495adce333a42bb781f52c42d7f02", "business_type": "medical_case", "business_id": "31", "object_key": "SparkClient/20260518/EA9D0C7A-E2FD-4794-90B8-DAC628ADB058/photo_6459C6CF-5F6E-48D9-9D2E-ACDA2078C4BE.jpg", "storage_type": "oss", "created_at": "2026-05-18T05:28:06.654800Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/EA9D0C7A-E2FD-4794-90B8-DAC628ADB058/photo_6459C6CF-5F6E-48D9-9D2E-ACDA2078C4BE.jpg"}, {"id": 339, "file_uuid": "b6593256-2a82-4c3b-9514-e10984b1