INFO 2026-05-18 14:14:24,967 medical.api_io [request_id=CE9C8F47-628B-48D1-AFA1-F9A0C571692E] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "192.168.31.192:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MTEzNzUzLCJpYXQiOjE3NzkxMTE5NTMsImp0aSI6IjRjOGIxYzZmYWEzZjQ3NGFiYTAwNTEzYmUzZGJjOGY2IiwidXNlcl9pZCI6IjMifQ.P3QCTSTwPW6GFPwzTG4f4oG1izwUAMmm1xtimdAi290", "X-Request-Id": "CE9C8F47-628B-48D1-AFA1-F9A0C571692E", "Content-Length": "7385"} body={"member": {"id": 13}, "medical_case": {"diagnosis_summary": "患者赵道凯，反复头晕2月，伴视物旋转、恶心呕吐，社区医院头颅CT无异常，诊断前庭性眩晕；多次就诊于苏州大学附属第四医院、苏州工业园区星塘医院，行头颅CT、颈椎CT、粪便检验、血常规、生化检验、胃镜等检查，胃镜诊断慢性非萎缩性胃炎伴胆汁反流，门诊诊断结膜炎，予药物治疗\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；结膜炎", "age_at_visit": 27, "extra": {"occurred_at": "2025-08-02", "source": "typed_upload"}, "source_file_ids": [414], "title": "就诊病例", "hospital_name": "苏州大学附属第四医院；苏州工业园区星塘医院"}, "visit": {"visited_at": "2025-08-02", "visit_no": "0000349056", "notes": "初诊", "visit_type": "门诊", "doctor_name": "严海荣", "source_file_ids": [410], "department": "神经内科门诊"}, "examination_reports": [{"item_name": "苏州工业园区星塘医院放射科颈椎椎间盘平扫+头颅平扫报告", "category": "imaging", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "source_file_ids": [408], "doctor_name": "天聚定", "details": [{"reference_range": "正常", "category": "影像", "item_name": "头颅CT平扫", "result_value": "未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中，小脑及脑干未见异常密度影", "body_part": "头颅", "diagnosis": "头颅CT平扫未见明显异常，必要时MRI检查"}, {"reference_range": "正常", "category": "影像", "item_name": "颈椎椎间盘平扫", "result_value": "C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压，颈椎生理曲度平直，椎体缘骨质增生，两侧颈部、颌下区多发小淋巴结，所示右侧声带相对稍厚", "body_part": "颈椎", "diagnosis": "C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；所示右侧声带相对稍厚"}], "performed_at": "2025-06-04", "organization_name": "苏州工业园区星塘医院"}, {"item_name": "苏州大学附属第四医院粪便检验+隐血报告", "category": "laboratory", "findings": "标本为粪便，粪便颜色黄色，性状软便，粪白细胞、粪红细胞、吞噬细胞、淀粉颗粒、脂肪球、花粉、寄生虫、虫卵、夏科莱登结晶、孢子、菌丝、隐血均未见或阴性，检验建议无特殊", "source_file_ids": [409], "doctor_name": "铉思程", "details": [{"category": "粪便检验", "item_name": "隐血", "reference_range": "阴性", "result_value": "阴性", "body_part": "粪便"}], "performed_at": "2025-07-05", "organization_name": "苏州大学附属第四医院"}, {"item_name": "苏州大学附属第四医院血细胞分析+CRP报告", "category": "laboratory", "findings": "标本为静脉全血，白细胞计数、中性粒细胞计数、淋巴细胞计数等各项指标均在参考范围内，超敏C反应蛋白0.93mg/L，检验建议无特殊", "source_file_ids": [413], "doctor_name": "钱思程", "details": [{"reference_range": "0--6mg/L", "category": "血细胞分析", "item_name": "超敏C反应蛋白", "result_value": "0.93mg/L", "body_part": "血液"}], "performed_at": "2025-07-05", "organization_name": "苏州大学附属第四医院"}, {"item_name": "苏州大学附属第四医院生化检验+肾功能检验报告", "category": "laboratory", "findings": "标本为静脉血清，总胆红素、直接胆红素、间接胆红素、乳酸脱氢酶等各项指标均在参考范围内，甘油三酯0.70mmol/L、总胆固醇5.07mmol/L、高密度脂蛋白胆固醇1.51mmol/L、低密度脂蛋白胆固醇3.511mmol/L，均符合参考区间，检验建议结合疾病特点咨询专科医生", "source_file_ids": [411], "doctor_name": "魏舟轩", "details": [{"category": "生化检验", "item_name": "低密度脂蛋白胆固醇", "reference_range": "理想≤2.60mmol/L，适宜＜3.40mmol/L", "result_value": "3.511mmol/L", "body_part": "血液"}], "performed_at": "2025-12-28", "organization_name": "苏州大学附属第四医院"}, {"item_name": "苏州大学附属第四医院无痛电子胃镜报告", "category": "imaging", "findings": "食管通过顺利，黏膜大致正常；贲门开合通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "source_file_ids": [412], "doctor_name": "欧啡", "details": [{"category": "胃镜", "item_name": "胃", "result_value": "胃体见胆汁残留，胃窦黏膜红白相间，以红为主，其余部位未见明显异常", "diagnosis": "慢性非萎缩性胃炎伴胆汁反流"}], "performed_at": "2026-02-10", "organization_name": "苏州大学附属第四医院"}], "prescriptions": [{"prescriber_name": "严海荣", "prescribed_at": "2025-08-02", "diagnosis": "前庭性眩晕", "extra": {"source": "typed_upload"}, "medication_plans": [], "source_file_ids": [], "institution_name": "苏州大学附属第四医院", "status": "active"}, {"prescriber_name": "无", "prescribed_at": "2026-04-20", "diagnosis": "结膜炎", "extra": {"source": "typed_upload"}, "medication_plans": [{"weekly_weekdays": [], "frequency_type": "daily", "dose_per_time": "1滴", "reminder_times": [], "status": "active", "frequency_text": "每天4次", "instructions": "滴眼", "reminder_enabled": false, "dose_unit": "片", "medicine_box": {"medicine_name": "普拉洛芬滴眼液（普南扑灵）", "dose_unit": "片", "notes": "", "strength": "", "dosage_form": "", "extra": {"source": "typed_upload"}, "brand_name": ""}, "drug_name": "普拉洛芬滴眼液（普南扑灵）", "extra": {"sort_order": "0", "source": "typed_upload"}, "start_date": "2026-05-18", "file_ids": []}, {"weekly_weekdays": [], "frequency_type": "daily", "dose_per_time": "1滴", "reminder_times": [], "status": "active", "frequency_text": "每天2次", "instructions": "滴眼；开启瓶封后使用不可超过四周", "reminder_enabled": false, "dose_unit": "片", "medicine_box": {"medicine_name": "盐酸氮卓斯汀滴眼液（爱赛平）", "dose_unit": "片", "notes": "", "strength": "", "dosage_form": "", "extra": {"source": "typed_upload"}, "brand_name": ""}, "drug_name": "盐酸氮卓斯汀滴眼液（爱赛平）", "extra": {"sort_order": "1", "source": "typed_upload"}, "start_date": "2026-05-18", "file_ids": []}], "source_file_ids": [415], "institution_name": "苏州大学附属第四医院", "status": "active"}], "symptom": {"name": "头晕", "severity": "medium", "started_at": "2025-06-02", "duration_value": 2, "duration_unit": "月", "notes": "反复出现，伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时后自行缓解", "body_part": "头部", "source_file_ids": []}}
