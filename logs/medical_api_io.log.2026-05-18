INFO 2026-05-18 13:16:17,104 medical.api_io [request_id=E55F1321-A8EC-4886-9963-761A5CF72AC7] HTTP 响应摘要: GET /api/v1/medical/members/11/complete-data/ status=200 duration_ms=62 bytes=10031 headers={"Content-Type": "application/json", "ETag": "\"55aab45802a6d1c739f5e5f327426e56\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 11, "member": {"id": 11, "user": 3, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "1998-05-18", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T07:48:15.645511Z", "updated_at": "2026-05-18T07:48:15.645536Z"}, "medical_cases": [], "health_exam_reports": [{"id": 2, "user": 3, "member": 11, "institution_name": "苏州相城美年大健康体检中心", "report_no": "", "exam_date": "2025-05-17", "exam_type": 1, "summary": "1、甲状腺左叶囊肿（TI-RADS 2类）：建议6～12个月复查，甲状腺专科随诊。2、舒张压偏低:(108/57mmHg)：建议多饮水，加强运动，结合病史必要时复测血压。若出现头昏、头晕、胸闷等症状，请及时心内科就诊。3、窦性心动过缓伴不齐56次/分：无症状且心率减慢不显著者无需治疗，若心率低于50次/分应做24小时动态心电图或心内科就诊。4、心电轴左偏：建议年度复查心电图和心脏超声，结合病史和症状心内科随诊。5、肝内钙化灶：建议定期复查肝胆超声，伴有肝区不适等症状时请肝胆科随诊。6、超重(体重指数24.1kg/m²)：建议控制膳食总量，低脂、低糖饮食，同时增加新鲜蔬菜和水果在膳食中的比重，逐渐增加规律的有氧运动，控制体重增长。7、血清总胆红素测定增高:24.7umol/L(参考区间:≤23)、血清直接胆红素测定（结合胆红素）增高:7.1umol/L(参考区间:0.00-6.80)：建议不要饮酒、低脂饮食后复查，仍高考虑肝胆疾病，消化内科就诊。8、血小板压积增高:0.29%(参考区间:0.10-0.28)：建议结合病史和症状定期复查血常规，如有明显异常请内科就诊。9、左眼视力低于正常标准(裸眼视力-左眼0.8)、右眼视力低于正常标准(裸眼视力-右眼0.8)：增加户外活动时间，注意用眼卫生，减少视疲劳，定期检查视力和眼底，必要时眼科就诊。", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-18T08:29:43.894014Z", "updated_at": "2026-05-18T08:29:43.894052Z", "attachments": [{"id": 349, "file_uuid": "089aa086-f849-4275-ba6c-08dd27b02e78", "original_name": "体检报告.pdf", "file_size": 11159138, "mime_type": "application/pdf", "file_md5": "bd7e3d30b9c04e79b80248bef17e4185", "business_type": "health_exam_report", "business_id": "2", "object_key": "SparkClient/20260518/089AA086-F849-4275-BA6C-08DD27B02E78/体检报告.pdf", "storage_type": "oss", "created_at": "2026-05-18T08:28:09.024904Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/089AA086-F849-4275-BA6C-08DD27B02E78/%E4%BD%93%E6%A3%80%E6%8A%A5%E5%91%8A.pdf"}]}], "examination_reports": [{"id": 71, "user": 3, "member": 11, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州市独墅湖医院", "department_name": "", "doctor_name": "朱孝明", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-18T08:01:13.317723Z", "updated_at": "2026-05-18T08:01:13.317736Z", "attachments": [{"id": 345, "file_uuid": "7130c5b4-6212-4c92-aa89-305ca4028084", "original_name": "photo_4EFCAE7A-275F-48DD-B19F-2CFC9AA3534F.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "71", "object_key": "SparkClient/20260518/7130C5B4-6212-4C92-AA89-305CA4028084/photo_4EFCAE7A-275F-48DD-B19F-2CFC9AA3534F.jpg", "storage_type": "oss", "created_at": "2026-05-18T08:00:27.535682Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/7130C5B4-6212-4C92-AA89-305CA4028084/photo_4EFCAE7A-275F-48DD-B19F-2CFC9AA3534F.jpg"}]}, {"id": 70, "user": 3, "member": 11, "medical_record": null, "category": "laboratory", "sub_category": "", "item_name": "医疗报告", "performed_at": null, "reported_at": null, "organization_name": "苏州市独墅湖医院", "department_name": "", "doctor_name": "严海荣", "findings": "", "impression": "", "source": 2, "status": 1, "extra": {"source": "typed_upload"}, "created_at": "2026-05-18T08:01:13.209447Z", "updated_at": "2026-05-18T08:01:13.209472Z", "attachments": [{"id": 344, "file_uuid": "2f92c540-7e86-4252-891d-6f6fd161a926", "original_name": "photo_90C0C584-3752-4D35-AE62-3EF5EA76BAA9.jpg", "file_size": 1283509, "mim