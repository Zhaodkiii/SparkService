", "visit_no": "0000349056", "source_system_id": "", "notes": "主诉反复头晕2月，诊断前庭性眩晕", "extra": {}, "created_at": "2026-05-18T13:47:55.720446Z", "updated_at": "2026-05-18T13:47:55.720469Z"}], "surgeries": [{"id": 1, "user": 3, "member": 12, "medical_case": 33, "procedure_name": "无痛电子胃镜", "procedure_code": "", "site": "", "performed_at": "2026-02-10T00:00:00Z", "surgeon": "", "anesthesia_type": "", "incision_level": "", "asa_class": "", "source_system_id": "", "notes": "检查所见：食管通过顺利，黏膜大致正常；胃体见胆汁残留；胃窦黏膜红白相间，以红为主。诊断慢性非萎缩性胃炎伴胆汁反流", "extra": {}, "created_at": "2026-05-18T13:47:55.729116Z", "updated_at": "2026-05-18T13:47:55.729187Z"}], "follow_ups": []}}
