: "active", "extra": {"source": "combined_create"}, "attachments": [], "created_at": "2026-05-18T13:47:55.945324Z", "updated_at": "2026-05-18T13:47:55.945336Z"}], "medication_plans": [{"id": 56, "user": 3, "member": 12, "medical_case": 33, "medicine_box": 62, "prescription": 23, "drug_name": "复方双花口服液", "dose_per_time": "一次20ml", "dose_value": 20.0, "dose_unit": "ml", "frequency_type": "daily", "every_n_days": null, "weekly_weekdays": [], "frequency_text": "一日4次", "reminder_times": [], "start_date": "2026-05-18", "end_date": null, "instructions": "口服。成人一次20ml，一日4次；儿童3岁以下一次10ml，一日3次；3岁到7岁一次10ml，一日4次；7岁以上一次20ml，一日3次。疗程3天。", "reminder_enabled": false, "status": "active", "extra": {"source": "typed_upload", "sort_order": "0"}, "attachments": [{"id": 403, "file_uuid": "11de2a67-ca33-44b6-a7c9-25679c0bd70b", "original_name": "photo_B62C1AB7-7F62-42B9-A665-5E75A2D6DA1C.jpg", "file_size": 3337732, "mime_type": "image/jpeg", "file_md5": "d6626b7f94f4b77246b2ed174645e633", "business_type": "medication_plan", "business_id": "56", "object_key": "SparkClient/20260518/11DE2A67-CA33-44B6-A7C9-25679C0BD70B/photo_B62C1AB7-7F62-42B9-A665-5E75A2D6DA1C.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:47.496569Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/11DE2A67-CA33-44B6-A7C9-25679C0BD70B/photo_B62C1AB7-7F62-42B9-A665-5E75A2D6DA1C.jpg"}], "created_at": "2026-05-18T13:47:55.957563Z", "updated_at": "2026-05-18T13:47:55.957576Z"}, {"id": 55, "user": 3, "member": 12, "medical_case": 33, "medicine_box": 61, "prescription": 22, "drug_name": "盐酸氮卓斯汀滴眼液", "dose_per_time": "每次1滴", "dose_value": null, "dose_unit": "片", "frequency_type": "daily", "every_n_days": null, "weekly_weekdays": [], "frequency_text": "每天2次", "reminder_times": [], "start_date": "2026-05-18", "end_date": null, "instructions": "滴眼，开启瓶封后使用不可超过四周", "reminder_enabled": false, "status": "active", "extra": {"source": "typed_upload", "sort_order": "1"}, "attachments": [], "creat