INFO 2026-05-18 04:44:36,318 medical.api_io [request_id=37DAC480-5A59-4125-B773-12D7F213E604] HTTP 响应摘要: GET /api/v1/medical/members/9/complete-data/ status=200 duration_ms=137 bytes=39771 headers={"Content-Type": "application/json", "ETag": "\"926b984a24b221f1aed2c07c7ad14b10\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 9, "member": {"id": 9, "user": 1, "name": "哈哈", "gender": "male", "relationship": "self", "birth_date": "2002-05-14", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-14T08:24:43.376165Z", "updated_at": "2026-05-14T08:24:43.376194Z"}, "medical_cases": [{"id": 30, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，头晕伴视物旋转、体位改变明显、恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍等不适，既往社区医院头颅CT无异常；2025年6月4日于苏州工业园区星塘医院行颈椎+头颅CT平扫，提示C4/5、C5/6椎间盘轻微突出等；2026年2月10日于苏州大学附属第四医院行胃镜检查诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚；鼻咽顶后壁软组织增厚", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T18:37:15.699690Z", "updated_at": "2026-05-17T18:37:15.699707Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 331, "file_uuid": "a35fafa5-ffa6-468a-8211-d3fc3254e548", "original_name": "photo_64DD6C1F-07A7-4A7C-A810-2F95F540E416.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "medical_case", "business_id": "30", "object_key": "SparkClient/20260517/A35FAFA5-FFA6-468A-8211-D3FC3254E548/photo_64DD6C1F-07A7-4A7C-A810-2F95F540E416.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:31:10.183177Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/A35FAFA5-FFA6-468A-8211-D3FC3254E548/photo_64DD6C1F-07A7-4A7C-A810-2F95F540E416.jpg"}, {"id": 330, "file_uuid": "af13c2f4-6a0e-49e8-90d2-f11611dc3c18", "original_name": "photo_28301A4B-AC51-4648-9CF5-3F9E6B2DA930.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "30", "object_key": "SparkClient/20260517/AF13C2F4-6A0E-49E8-90D2-F11611DC3C18/photo_28301A4B-AC51-4648-9CF5-3F9E6B2DA930.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:31:09.937228Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/AF13C2F4-6A0E-49E8-90D2-F11611DC3C18/photo_28301A4B-AC51-4648-9CF5-3F9E6B2DA930.jpg"}, {"id": 329, "file_uuid": "9f1bfa85-8f9d-492a-ab25-48b40698884c", "original_name": "photo_329B9EB7-95C3-423A-82F1-5684E80DDCCC.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "30", "object_key": "SparkClient/20260517/9F1BFA85-8F9D-492A-AB25-48B40698884C/photo_329B9EB7-95C3-423A-82F1-5684E80DDCCC.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:31:09.771664Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/9F1BFA85-8F9D-492A-AB25-48B40698884C/photo_329B9EB7-95C3-423A-82F1-5684E80DDCCC.jpg"}]}, {"id": 29, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州工业园区星塘医院；苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者赵道凯27岁，2025年6月4日于苏州工业园区星塘医院行颈椎椎间盘平扫+头颅平扫CT，提示头颅CT无明显异常，C4/5、C5/6椎间盘轻微突出、颈椎失稳，鼻咽顶后壁软组织增厚、两侧颈部颌下多发小淋巴结、右侧声带稍厚。2025年8月2日因反复头晕2月至苏州大学附属第四医院神经内科门诊就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。2026年2月10日行无痛电子胃镜检查，诊断为慢性非萎缩性胃炎伴胆汁反流。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T18:29:10.790943Z", "updated_at": "2026-05-17T18:29:10.790969Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 328, "file_uuid": "17e9ca4c-0d0b-4b4c-ae60-8712023f8424", "original_name": "photo_CDA5B7B0-2EC3-4083-A907-190F2480CC7D.jpg", "file_size": 905160, "mime_type": "image/jpeg", "file_md5": "122088e38f06563b55d360e1d5a2fd19", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/17E9CA4C-0D0B-4B4C-AE60-8712023F8424/photo_CDA5B7B0-2EC3-4083-A907-190F2480CC7D.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.796614Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/17E9CA4C-0D0B-4B4C-AE60-8712023F8424/photo_CDA5B7B0-2EC3-4083-A907-190F2480CC7D.jpg"}, {"id": 327, "file_uuid": "08328273-9a80-4077-9203-8c92827cb69a", "original_name": "photo_68F46143-51B2-42E3-B311-63343F9006C7.jpg", "file_size": 3337732, "mime_type": "image/jpeg", "file_md5": "d6626b7f94f4b77246b2ed174645e633", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/08328273-9A80-4077-9203-8C92827CB69A/photo_68F46143-51B2-42E3-B311-63343F9006C7.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.707379Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/08328273-9A80-4077-9203-8C92827CB69A/photo_68F46143-51B2-42E3-B311-63343F9006C7.jpg"}, {"id": 326, "file_uuid": "defb1977-67d5-467c-9a98-becab7146287", "original_name": "photo_36804567-1D3F-4AD8-AE29-9FF50DD9F350.jpg", "file_size": 3462115, "mime_type": "image/jpeg", "file_md5": "51bde0358dfb7324a9fbe95b4fed90b0", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/DEFB1977-67D5-467C-9A98-BECAB7146287/photo_36804567-1D3F-4AD8-AE29-9FF50DD9F350.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.561267Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/DEFB1977-67D5-467C-9A98-BECAB7146287/photo_36804567-1D3F-4AD8-AE29-9FF50DD9F350.jpg"}, {"id": 325, "file_uuid": "00ac0ba3-45e9-4b15-acfc-eb5121c17087", "original_name": "photo_F5119859-16A0-47C7-B59F-215BD7BCBDAA.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/00AC0BA3-45E9-4B15-ACFC-EB5121C17087/photo_F5119859-16A0-47C7-B59F-215BD7BCBDAA.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.395047Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/00AC0BA3-45E9-4B15-ACFC-EB5121C17087/photo_F5119859-16A0-47C7-B59F-215BD7BCBDAA.jpg"}, {"id": 324, "file_uuid": "dec4b083-2534-4b10-a28a-69691b7a859c", "original_name": "photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/DEC4B083-2534-4B10-A28A-69691B7A859C/photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:31.281020Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/DEC4B083-2534-4B10-A28A-69691B7A859C/photo_518DFEC1-E752-4BB5-84E9-2BAF7B2A3D74.jpg"}, {"id": 323, "file_uuid": "38d7a992-4f75-4044-9e8e-d2699e42c7e2", "original_name": "photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "medical_case", "business_id": "29", "object_key": "SparkClient/20260517/38D7A992-4F75-4044-9E8E-D2699E42C7E2/photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg", "storage_type": "oss", "created_at": "2026-05-17T18:16:30.971371Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/38D7A992-4F75-4044-9E8E-D2699E42C7E2/photo_B20919E4-52C6-47ED-88AF-206F2D1C44D0.jpg"}]}, {"id": 22, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，26岁，反复头晕2月，伴视物旋转，体位改变时症状明显，伴恶心呕吐，每次持续2小时后自行缓解，无肢体活动障碍，社区医院头颅CT未见异常。2025-07-05于苏州大学附属第四医院消化内科门诊就诊，临床印象肠功能紊乱，行血细胞分析+CRP检查结果均正常；2025-08-02于该院神经内科门诊初诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗。\n\n肠功能紊乱；前庭性眩晕", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-17T09:35:25.261827Z", "updated_at": "2026-05-17T09:35:25.261849Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 258, "file_uuid": "2296ea84-d29f-4424-b117-2d7acccc1f68", "original_name": "photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "file_size": 3506147, "mime_type": "image/jpeg", "file_md5": "1caa9aa8422210cf1f1e905b81d0ad9a", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:33.362500Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/2296EA84-D29F-4424-B117-2D7ACCCC1F68/photo_33774242-17F7-47F1-993F-52F9F9E11E55.jpg"}, {"id": 257, "file_uuid": "d4314d83-dec6-4592-b25e-be5d2fed17ac", "original_name": "photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "medical_case", "business_id": "22", "object_key": "SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg", "storage_type": "oss", "created_at": "2026-05-17T09:34:31.646877Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260517/D4314D83-DEC6-4592-B25E-BE5D2FED17AC/photo_4147687C-1499-4FD6-84B5-00AECAC859A4.jpg"}]}, {"id": 21, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T09:01:03.644379Z", "updated_at": "2026-05-14T09:01:03.644406Z", "symptoms": ["头晕"], "medications": [], "attachments": []}, {"id": 20, "member": 9, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州大学附属第四医院（苏州市独墅湖医院）；苏州工业园区星塘医院", "age_at_visit": 26, "diagnosis_summary": "患者赵道凯，2025年8月2日因反复头晕2月于苏州大学附属第四医院神经内科就诊，诊断为前庭性眩晕，予甲磺酸倍他司汀片治疗；2025年6月苏州工业园区星塘医院CT提示C4/5、C5/6椎间盘轻微突出等；2026年2月胃镜诊断慢性非萎缩性胃炎伴胆汁反流；2025年7月消化科就诊提示肠功能紊乱，行血细胞分析、粪便检验未见明显异常；2025年12月因口腔黏膜溃疡行生化、肾功能检验，低密度脂蛋白胆固醇3.511mmol/L略高；2026年4月皮肤科诊断结膜炎，予普拉洛芬滴眼液、盐酸氮卓斯汀滴眼液治疗。\n\n前庭性眩晕；慢性非萎缩性胃炎伴胆汁反流；肠功能紊乱；口腔黏膜溃疡；结膜炎", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-14T08:25:05.894058Z", "updated_at": "2026-05-14T08:25:05.894078Z", "symptoms": ["头晕"], "medications": [], "attachments": []}], "health_exam_reports": [], "examination_reports": [{"id": 67, "user": 1, "member": 9, "medical_record": 30, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡；产珍", "findings": "检查项目：无痛电子胃镜（不含麻醉费）。内镜所见：食管：通过顺利，黏膜大致正常；贲门：开合佳通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。建议：若有病理，请于35个工作日后任手机公众号上查询及去一楼或五楼的自助报告机取报告。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-17T18:37:15.716599Z", "updated_at": "2026-05-17T18:37:15.716605Z", "attachments": []}, {"id": 65, "user": 1, "member": 9, "medical_record": 29, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡；产珍", "fin