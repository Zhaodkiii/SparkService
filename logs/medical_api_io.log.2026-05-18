INFO 2026-05-18 13:58:09,340 medical.api_io [request_id=3EA214E4-3E47-439F-91AB-9F4538E192D3] HTTP 响应摘要: GET /api/v1/medical/members/12/complete-data/ status=200 duration_ms=72 bytes=19456 headers={"Content-Type": "application/json", "ETag": "\"0145a9d9d4645c756432c03e430709bd\"", "Cache-Control": "private, max-age=86400", "Vary": "Accept", "Allow": "GET, HEAD, OPTIONS"} body={"code": 0, "msg": "success", "data": {"member_id": 12, "member": {"id": 12, "user": 3, "name": "看看", "gender": "male", "relationship": "self", "birth_date": "1998-05-18", "blood_type": "", "allergies": [], "chronic_conditions": [], "notes": "", "avatar_url": "", "is_primary": false, "created_at": "2026-05-18T13:43:17.385112Z", "updated_at": "2026-05-18T13:43:17.385133Z"}, "medical_cases": [{"id": 33, "member": 12, "record_type": "custom", "status": 1, "title": "就诊病例", "hospital_name": "苏州工业园区星塘医院；苏州大学附属第四医院（苏州市独墅湖医院）", "age_at_visit": 27, "diagnosis_summary": "患者反复头晕2月，伴视物旋转、恶心呕吐，每次持续2小时，社区医院头颅CT未见异常。2025-08-02诊断为前庭性眩晕。既往有颈椎间盘突出、慢性非萎缩性胃炎伴胆汁反流、结膜炎等。多次检查示C4/5、C5/6椎间盘轻微突出、颈椎失稳，粪便及血细胞分析未见异常，生化检验中低密度脂蛋白胆固醇偏高。\n\n前庭性眩晕；C4/5、C5/6椎间盘轻微突出；颈椎失稳；慢性非萎缩性胃炎伴胆汁反流；结膜炎；口腔黏膜溃疡；肠功能紊乱", "extra": {"source": "typed_upload", "occurred_at": "2025-08-02"}, "created_at": "2026-05-18T13:47:55.703793Z", "updated_at": "2026-05-18T13:47:55.703816Z", "symptoms": ["头晕"], "medications": [], "attachments": [{"id": 404, "file_uuid": "aec3f799-5175-4025-bbe9-82cee61a6084", "original_name": "photo_D226D385-0E28-420D-9940-DAD176EFA314.jpg", "file_size": 1685245, "mime_type": "image/jpeg", "file_md5": "d4f3729b235cf3b35d4f9422071c20b8", "business_type": "medical_case", "business_id": "33", "object_key": "SparkClient/20260518/AEC3F799-5175-4025-BBE9-82CEE61A6084/photo_D226D385-0E28-420D-9940-DAD176EFA314.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:48.011400Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/AEC3F799-5175-4025-BBE9-82CEE61A6084/photo_D226D385-0E28-420D-9940-DAD176EFA314.jpg"}]}], "health_exam_reports": [], "examination_reports": [{"id": 81, "user": 3, "member": 12, "medical_record": 33, "category": "imaging", "sub_category": "", "item_name": "胃镜诊断报告单", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "欧啡", "findings": "食管：通过顺利，黏膜大致正常；贲门：开合通畅；胃底：黏膜正常；胃体：见胆汁残留；胃角：光整；胃窦：黏膜红白相间，以红为主；幽门：圆，开放好；十二指肠球部及所见降部：未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:47:55.884739Z", "updated_at": "2026-05-18T13:47:55.884748Z", "attachments": []}, {"id": 80, "user": 3, "member": 12, "medical_record": 33, "category": "laboratory", "sub_category": "", "item_name": "生化检验", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "朱孝明", "findings": "总胆红素13.5 umol/L，直接胆红素4.2 umol/L，间接胆红素9.3 umol/L，天门冬氨酸氨基转移酶13.5 U/L，丙氨酸氨基转移酶14.6 U/L，总蛋白77.0 g/L，白蛋白47.4 g/L，球蛋白29.6 g/L，白蛋白/球蛋白1.6，γ-谷氨酰转肽酶19.9 U/L，碱性磷酸酶75.9 U/L，乳酸脱氢酶168.0 U/L，α-羟丁酸脱氢酶140.4 U/L，胆碱酯酶11124 U/L，甘油三酯0.70 mmol/L，总胆固醇5.07 mmol/L，高密度脂蛋白胆固醇1.51 mmol/L，低密度脂蛋白胆固醇3.51 mmol/L。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:47:55.848486Z", "updated_at": "2026-05-18T13:47:55.848495Z", "attachments": [{"id": 400, "file_uuid": "be084fe9-cec2-46c7-a6a0-4b07f3bfbb74", "original_name": "photo_B8D6A4CB-0CB5-4FF0-A1AC-B5F86370EB4C.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "80", "object_key": "SparkClient/20260518/BE084FE9-CEC2-46C7-A6A0-4B07F3BFBB74/photo_B8D6A4CB-0CB5-4FF0-A1AC-B5F86370EB4C.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:46.133006Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/BE084FE9-CEC2-46C7-A6A0-4B07F3BFBB74/photo_B8D6A4CB-0CB5-4FF0-A1AC-B5F86370EB4C.jpg"}]}, {"id": 79, "user": 3, "member": 12, "medical_record": 33, "category": "laboratory", "sub_category": "", "item_name": "血细胞分析+CRP", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "严海荣", "findings": "白细胞计数5.56 10^9/L，中性粒细胞计数3.24 10^9/L，淋巴细胞计数1.95 10^9/L，单核细胞计数0.34 10^9/L，嗜酸性粒细胞计数0.03 10^9/L，嗜碱性粒细胞计数0.00 10^9/L，中性粒细胞百分比58.2%，淋巴细胞百分比35.1%，单核细胞百分比6.1%，嗜酸性粒细胞百分比0.6%，嗜碱性粒细胞百分比0.0%，红细胞计数4.74 10^12/L，血红蛋白141 g/L，红细胞比积41.30%，红细胞平均体积87.2 fL，红细胞平均血红蛋白量29.8 pg，红细胞平均血红蛋白浓度341 g/L，红细胞分布宽度13.2%，血小板计数270 10^9/L，血小板比积0.240，平均血小板体积8.9 fL，血小板分布宽度16.0，超敏C反应蛋白0.93 mg/L。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:47:55.803956Z", "updated_at": "2026-05-18T13:47:55.803967Z", "attachments": [{"id": 402, "file_uuid": "82e9db9c-3f4e-44c1-a457-4a22a619a23f", "original_name": "photo_41F21355-0343-4581-895B-D995BFFC916F.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "examination_report", "business_id": "79", "object_key": "SparkClient/20260518/82E9DB9C-3F4E-44C1-A457-4A22A619A23F/photo_41F21355-0343-4581-895B-D995BFFC916F.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:46.686383Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/82E9DB9C-3F4E-44C1-A457-4A22A619A23F/photo_41F21355-0343-4581-895B-D995BFFC916F.jpg"}]}, {"id": 78, "user": 3, "member": 12, "medical_record": 33, "category": "laboratory", "sub_category": "", "item_name": "粪便检验+隐血", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院（苏州市独墅湖医院）", "department_name": "", "doctor_name": "严海荣", "findings": "粪便颜色：黄色；粪便性状：软便；粪白细胞未见；粪红细胞未见；吞噬细胞未见；淀粉颗粒未见；脂肪球未见；花粉未见；寄生虫未见；虫卵未见；夏科莱登结晶未见；孢子未见；菌丝未见；隐血阴性。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:47:55.757601Z", "updated_at": "2026-05-18T13:47:55.757622Z", "attachments": [{"id": 401, "file_uuid": "105e0a02-c34c-475b-aec3-a638e744b5ee", "original_name": "photo_9C29B56C-C533-4AB8-A37F-3FE61B5E17B8.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "78", "object_key": "SparkClient/20260518/105E0A02-C34C-475B-AEC3-A638E744B5EE/photo_9C29B56C-C533-4AB8-A37F-3FE61B5E17B8.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:46.293833Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/105E0A02-C34C-475B-AEC3-A638E744B5EE/photo_9C29B56C-C533-4AB8-A37F-3FE61B5E17B8.jpg"}, {"id": 398, "file_uuid": "71159e26-cf0d-4156-9f29-1f0921ae3953", "original_name": "photo_11387B4A-32D6-4B66-A07C-4CA2856E933B.jpg", "file_size": 660716, "mime_type": "image/jpeg", "file_md5": "e3086cf080cb57da5dee63211a761de0", "business_type": "examination_report", "business_id": "78", "object_key": "SparkClient/20260518/71159E26-CF0D-4156-9F29-1F0921AE3953/photo_11387B4A-32D6-4B66-A07C-4CA2856E933B.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:44.303806Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/71159E26-CF0D-4156-9F29-1F0921AE3953/photo_11387B4A-32D6-4B66-A07C-4CA2856E933B.jpg"}]}, {"id": 77, "user": 3, "member": 12, "medical_record": 33, "category": "imaging", "sub_category": "", "item_name": "放射科诊断报告书", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T13:47:55.742586Z", "updated_at": "2026-05-18T13:47:55.742613Z", "attachments": [{"id": 397, "file_uuid": "6282d8ba-79fd-4ee5-a963-f9d748488210", "original_name": "photo_B2385596-1164-49A9-A1A2-CB0B8A14276C.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "examination_report", "business_id": "77", "object_key": "SparkClient/20260518/6282D8BA-79FD-4EE5-A963-F9D748488210/photo_B2385596-1164-49A9-A1A2-CB0B8A14276C.jpg", "storage_type": "oss", "created_at": "2026-05-18T13:46:43.753908Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/6282D8BA-79FD-4EE5-A963-F9D748488210/photo_B2385596-1164-49A9-A1A2-CB0B8A14276C.jpg"}]}], "medicine_boxes": [{"id": 62, "user": 3, "member": 12, "medicine_type": "uncategorized", "medicine_name": "复方双花口服液", "brand_name": "复方双花口服液", "dosage_form": "口服液", "strength": "10ml/支", "dose_unit": "ml", "total_quantity": 12.0, "expire_date": "2026-07-21", "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-18T13:47:55.949565Z", "updated_at": "2026-05-18T13:47:55.949577Z"}, {"id": 61, "user": 3, "member": 12, "medicine_type": "uncategorized", "medicine_name": "盐酸氮卓斯汀滴眼液", "brand_name": "爱赛平", "dosage_form": "滴眼液", "strength": "6ml:3mg (0.05%)", "dose_unit": "片", "total_quantity": null, "expire_date": null, "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-18T13:47:55.929286Z", "updated_at": "2026-05-18T13:47:55.929294Z"}, {"id": 60, "user": 3, "member": 12, "medicine_type": "uncategorized", "medicine_name": "普拉洛芬滴眼液", "brand_name": "普南扑灵", "dosage_form": "滴眼液", "strength": "5ml:5mg", "dose_unit": "片", "total_quantity": null, "expire_date": null, "notes": "", "extra": {"source": "typed_upload"}, "attachments": [], "created_at": "2026-05-18T13:47:55.918055Z", "updated_at": "2026-05-18T13:47:55.918063Z"}, {"id": 59, "user": 3, "member": 12, "medicine_type": "uncategorized", "medicine_n