INFO 2026-05-18 13:39:16,267 medical.api_io [request_id=95506CE8-99B0-4303-92D8-F8B16EEFE5B7] HTTP 请求进入: POST /api/v1/medical/combined-create/ headers={"Host": "192.168.31.192:8000", "Content-Type": "application/json", "Accept-Encoding": "gzip, deflate", "User-Agent": "SparkClient/1 CFNetwork/3860.400.51 Darwin/25.3.0", "Connection": "keep-alive", "Accept": "*/*", "Accept-Language": "zh-CN,zh-Hans;q=0.9", "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc5MTExOTcwLCJpYXQiOjE3NzkxMTAxNzAsImp0aSI6IjQzNjA4NDE2ZmUxMzRkNWE5YWIyNWU3MjA4MjUxODMyIiwidXNlcl9pZCI6IjMifQ.R2xiq9o0llhXUYlnFKw4RqnaWBLb0j_qb7DJnXIBk34", "X-Request-Id": "95506CE8-99B0-4303-92D8-F8B16EEFE5B7", "Content-Length": "7394"} body={"symptom": {"source_file_ids": [379], "body_part": "头部", "name": "头晕"}, "examination_reports": [{"category": "imaging", "item_name": "苏州工业园区星塘医院放射科颈椎椎间盘平扫头颅平扫报告", "organization_name": "苏州工业园区星塘医院", "details": [{"body_part": "头颅", "sub_category": "颈椎及头颅CT", "category": "影像检查", "item_name": "头颅CT平扫", "reference_range": "无异常", "result_value": "未见明显异常"}, {"body_part": "颈椎、两侧颈部颌下区、声带", "sub_category": "颈椎及头颅CT", "category": "影像检查", "item_name": "颈椎影像学", "reference_range": "无异常", "result_value": "生理曲度平直，椎体缘骨质增生，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压，颈椎失稳，两侧颈部、颌下区多发小淋巴结，右侧声带相对稍厚"}], "doctor_name": "天聚定", "source_file_ids": [377], "performed_at": "2025-06-04", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚；颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。"}, {"findings": "粪便颜色黄色，性状软便；粪白细胞、粪红细胞、吞噬细胞、淀粉颗粒、脂肪球、花粉、寄生虫、虫卵、夏科莱登结晶、孢子、菌丝、隐血均阴性或未见", "item_name": "苏州大学附属第四医院粪便检验报告单", "organization_name": "苏州大学附属第四医院", "details": [{"result_value": "阴性", "unit": "个/P", "item_name": "粪便隐血", "category": "粪便检验", "reference_range": "阴性"}], "doctor_name": "铉思程", "source_file_ids": [378], "performed_at": "2025-07-05", "category": "laboratory"}, {"findings": "各项生化指标基本正常", "item_name": "苏州大学附属第四医院生化检验报告单", "organization_name": "苏州大学附属第四医院", "details": [{"result_value": "14.6U/L", "flag": "无异常", "item_name": "谷丙转氨酶", "category": "生化检验", "reference_range": "0-40U/L"}], "doctor_name": "魏舟轩", "source_file_ids": [382], "performed_at": "2025-12-28", "category": "laboratory"}, {"findings": "白细胞计数、红细胞计数、血小板计数等各项血细胞指标及超敏C反应蛋白均正常", "item_name": "苏州大学附属第四医院血细胞分析+CRP报告单", "organization_name": "苏州大学附属第四医院", "details": [{"result_value": "5.56×10^9/L", "item_name": "白细胞计数", "category": "血细胞分析", "reference_range": "3.5-9.5×10^9/L"}], "doctor_name": "钱思程", "source_file_ids": [380], "performed_at": "2025-07-05", "category": "laboratory"}, {"findings": "食管黏膜大致正常，贲门开合通畅，胃底见胆汁残留，胃体黏膜正常，胃角光整，胃窦黏膜红白相间以红为主，幽门圆开放好，十二指肠球部及所见降部未见明显异常；诊断慢性非萎缩性胃炎伴胆汁反流", "item_name": "苏州大学附属第四医院无痛电子胃镜诊断报告单", "organization_name": "苏州大学附属第四医院", "details": [{"result_value": "胃体见胆汁残留，胃窦黏膜红白相间以红为主", "body_part": "胃", "item_name": "胃黏膜", "category": "胃镜检查"}, {"result_value": "未见明显异常", "body_part": "食管、贲门、十二指肠", "item_name": "食管、贲门、十二指肠", "category": "胃镜检查"}], "doctor_name": "欧啡", "source_file_ids": [381], "performed_at": "2026-02-10", "category": "imaging"}], "member": {"id": 11}, "visit": {"department": "神经内科门诊", "source_file_ids": [], "visit_type": "门诊", "doctor_name": "严海荣", "visited_at": "2025-08-02"}, "prescriptions": [{"extra": {"source": "typed_upload"}, "prescriber_name": "严海荣", "medication_plans": [{"drug_name": "甲磺酸倍他司汀片（敏使朗）", "file_ids": [], "frequency_type": "daily", "weekly_weekdays": [], "reminder_enabled": false, "reminder_times": [], "medicine_box": {"extra": {"source": "typed_upload"}, "brand_name": "", "strength": "6mg", "notes": "", "medicine_name": "甲磺酸倍他司汀片（敏使朗）", "dose_unit": "片", "dosage_form": "片剂"}, "status": "active", "start_date": "2026-05-18", "dose_per_time": "片", "frequency_text": "每天3次", "dose_unit": "片", "extra": {"sort_order": "0", "source": "typed_upload"}, "instructions": "口服"}], "institution_name": "苏州大学附属第四医院", "diagnosis": "前庭性眩晕", "source_file