ly", "frequency_text": "一日4次", "reminder_enabled": false, "dose_unit": "ml", "dose_value": "20", "drug_name": "复方双花口服液", "reminder_times": [], "extra": {"source": "typed_upload", "sort_order": "0"}, "medicine_box": {"expire_date": "2026-07-21", "strength": "10ml/支", "notes": "", "extra": {"source": "typed_upload"}, "medicine_type": "uncategorized", "medicine_name": "复方双花口服液", "dose_unit": "ml", "brand_name": "复方双花口服液", "dosage_form": "口服液", "total_quantity": "12"}, "dose_per_time": "一次20ml", "status": "active", "weekly_weekdays": [], "file_ids": [403]}], "institution_name": "北京康益药业有限公司"}], "surgery": {"notes": "检查所见：食管通过顺利，黏膜大致正常；胃体见胆汁残留；胃窦黏膜红白相间，以红为主。诊断慢性非萎缩性胃炎伴胆汁反流", "procedure_name": "无痛电子胃镜", "source_file_ids": [], "performed_at": "2026-02-10"}, "symptom": {"notes": "反复头晕，伴视物旋转，体位改变症状明显，伴恶心呕吐，每次持续2小时，后自行缓解", "body_part": "头部", "severity": "low", "duration_value": 2, "duration_unit": "月", "started_at": "2025-06-01", "name": "头晕", "source_file_ids": []}, "member": {"id": 12}, "visit": {"notes": "主诉反复头晕2月，诊断前庭性眩晕", "visit_no": "0000349056", "visit_type": "门诊", "visited_at": "2025-08-02", "doctor_name": "仿德话", "department": "神经内科门诊", "source_file_ids": [399]}, "examination_reports": [{"item_name": "放射科诊断报告书", "category": "imaging", "performed_at": "2025-06-04", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳：两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "details": [{"body_part": "头颅；颈椎", "diagnosis": "1.头颅CT平扫未见明显异常。2.C4/5、C5/6椎间盘轻微突出；颈椎失稳；两侧颈部、颌下区多发小淋巴结；右侧声带相对稍厚", "category": "影像诊断", "result_value": "C4/5、C5/6椎间盘轻微突出；颈椎失稳；头颅CT平扫未见明显异常", "item_name": "头颅CT平扫+颈椎椎间盘平扫", "modality": "CT"}], "source_file_ids": [397], "organization_name": "苏州工业园区星塘医院"}, {"item_name": "粪便检验+隐血", "category": "laboratory", "performed_at": "2025-07-05", "doctor_name": "严海荣", "findings": "粪便颜色：黄色；