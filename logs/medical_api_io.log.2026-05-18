rts": [{"id": 86, "user": 3, "member": 13, "medical_record": 34, "category": "imaging", "sub_category": "", "item_name": "苏州大学附属第四医院无痛电子胃镜报告", "performed_at": "2026-02-10T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "欧啡", "findings": "食管通过顺利，黏膜大致正常；贲门开合通畅；胃底黏膜正常；胃体见胆汁残留；胃角光整；胃窦黏膜红白相间，以红为主；幽门圆，开放好；十二指肠球部及所见降部未见明显异常。诊断：慢性非萎缩性胃炎伴胆汁反流", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.030053Z", "updated_at": "2026-05-18T14:14:25.030065Z", "attachments": [{"id": 412, "file_uuid": "51d1ab7f-ab9d-48a4-b90d-534f700db6d0", "original_name": "photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg", "file_size": 273201, "mime_type": "image/jpeg", "file_md5": "b549c88052b52d02e02867117b763749", "business_type": "examination_report", "business_id": "86", "object_key": "SparkClient/20260518/51D1AB7F-AB9D-48A4-B90D-534F700DB6D0/photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:10.089058Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/51D1AB7F-AB9D-48A4-B90D-534F700DB6D0/photo_61FE3C65-67FB-4A5A-9F73-5C85B7E4422B.jpg"}]}, {"id": 85, "user": 3, "member": 13, "medical_record": 34, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院生化检验+肾功能检验报告", "performed_at": "2025-12-28T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "魏舟轩", "findings": "标本为静脉血清，总胆红素、直接胆红素、间接胆红素、乳酸脱氢酶等各项指标均在参考范围内，甘油三酯0.70mmol/L、总胆固醇5.07mmol/L、高密度脂蛋白胆固醇1.51mmol/L、低密度脂蛋白胆固醇3.511mmol/L，均符合参考区间，检验建议结合疾病特点咨询专科医生", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.023658Z", "updated_at": "2026-05-18T14:14:25.023675Z", "attachments": [{"id": 411, "file_uuid": "eea308b0-90c8-403b-959d-fe867b171632", "original_name": "photo_55AB5805-22D5-488E-B128-92AEE123A30E.jpg", "file_size": 479578, "mime_type": "image/jpeg", "file_md5": "3cb611b2d4952fdde39bd36cdf88314c", "business_type": "examination_report", "business_id": "85", "object_key": "SparkClient/20260518/EEA308B0-90C8-403B-959D-FE867B171632/photo_55AB5805-22D5-488E-B128-92AEE123A30E.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:09.803353Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/EEA308B0-90C8-403B-959D-FE867B171632/photo_55AB5805-22D5-488E-B128-92AEE123A30E.jpg"}]}, {"id": 84, "user": 3, "member": 13, "medical_record": 34, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院血细胞分析+CRP报告", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "钱思程", "findings": "标本为静脉全血，白细胞计数、中性粒细胞计数、淋巴细胞计数等各项指标均在参考范围内，超敏C反应蛋白0.93mg/L，检验建议无特殊", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.017742Z", "updated_at": "2026-05-18T14:14:25.017754Z", "attachments": [{"id": 413, "file_uuid": "b6be2890-0471-4b0c-9612-8f682117f861", "original_name": "photo_6FF7E6AF-4DA9-49B8-AE72-6349CFB0BD7D.jpg", "file_size": 1283509, "mime_type": "image/jpeg", "file_md5": "346f01f2613b3bff0f75a4f18d4fe3a0", "business_type": "examination_report", "business_id": "84", "object_key": "SparkClient/20260518/B6BE2890-0471-4B0C-9612-8F682117F861/photo_6FF7E6AF-4DA9-49B8-AE72-6349CFB0BD7D.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:10.468692Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/B6BE2890-0471-4B0C-9612-8F682117F861/photo_6FF7E6AF-4DA9-49B8-AE72-6349CFB0BD7D.jpg"}]}, {"id": 83, "user": 3, "member": 13, "medical_record": 34, "category": "laboratory", "sub_category": "", "item_name": "苏州大学附属第四医院粪便检验+隐血报告", "performed_at": "2025-07-05T00:00:00Z", "reported_at": null, "organization_name": "苏州大学附属第四医院", "department_name": "", "doctor_name": "铉思程", "findings": "标本为粪便，粪便颜色黄色，性状软便，粪白细胞、粪红细胞、吞噬细胞、淀粉颗粒、脂肪球、花粉、寄生虫、虫卵、夏科莱登结晶、孢子、菌丝、隐血均未见或阴性，检验建议无特殊", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:25.011811Z", "updated_at": "2026-05-18T14:14:25.011829Z", "attachments": [{"id": 409, "file_uuid": "6647d787-7d1d-41bc-b673-e776395378f3", "original_name": "photo_33354EA8-7C0E-4A7E-971D-6876EB7E6FD7.jpg", "file_size": 660716, "mime_type": "image/jpeg", "file_md5": "e3086cf080cb57da5dee63211a761de0", "business_type": "examination_report", "business_id": "83", "object_key": "SparkClient/20260518/6647D787-7D1D-41BC-B673-E776395378F3/photo_33354EA8-7C0E-4A7E-971D-6876EB7E6FD7.jpg", "storage_type": "oss", "created_at": "2026-05-18T14:11:08.163874Z", "file_url": "https://zhaodkdream.oss-cn-beijing.aliyuncs.com/SparkClient/20260518/6647D787-7D1D-41BC-B673-E776395378F3/photo_33354EA8-7C0E-4A7E-971D-6876EB7E6FD7.jpg"}]}, {"id": 82, "user": 3, "member": 13, "medical_record": 34, "category": "imaging", "sub_category": "", "item_name": "苏州工业园区星塘医院放射科颈椎椎间盘平扫+头颅平扫报告", "performed_at": "2025-06-04T00:00:00Z", "reported_at": null, "organization_name": "苏州工业园区星塘医院", "department_name": "", "doctor_name": "天聚定", "findings": "头颅CT平扫示脑实质未见明显异常密度影，各脑室形态大小正常，脑沟、裂池未见明显异常，中线结构居中。小脑及脑干未见异常密度影。鼻咽顶后壁软组织增厚。颈椎序列整齐，生理曲度平直，椎体缘可见骨质增生，椎小关节突对称，C4/5、C5/6椎间盘稍向后突出，相邻硬膜囊稍受压：骨性椎管无明显狭窄，椎旁软组织无明显肿胀。两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。影像诊断：1.头颅CT平扫未见明显异常，必要时MRI检查。鼻咽顶后壁软组织增厚，请结合专科检查。2.C4/5、C5/6椎间盘轻微突出：颈椎失稳；两侧颈部、颌下区多发小淋巴结。所示右侧声带相对稍厚。", "impression": null, "source": 1, "status": 1, "extra": null, "created_at": "2026-05-18T14:14:24.997274Z", "updated_at": "2026-05-18T14:14:24.997288Z", "attachments": [{"id": 408, "file_uuid": "af62fedc-800b-4185-bb16-7214b09b3ced", "original_name": "photo_26B8A7DC-023D-4BF6-87AF-2E4C9F96202D.jpg", "file_size": 569100, "mime_type": "image/jpeg", "file_md5": "88e627ff89739dafbe39c6c96b3d7458", "business_type": "examination_report", "business_id": "82", "object_key": "SparkClient/20260518/AF62FEDC-800B-4185-BB16-7214B09B3CED/photo_26B8A7DC-023D-4BF6-87AF-2E4C9F96202D.jpg", "sto