ate": 54, "maxHeartRate": 59, "avgRespiratoryRate": 15.5, "avgHeartRate": 55.75}}, {"startPercent": 42.26273959794297, "end": 1778255118, "startText": "23:42", "endText": "23:45", "widthPercent": 7.059373539036932, "start": 1778254967, "stage": "awake"}, {"startPercent": 49.322113136979894, "end": 1778256202, "startText": "23:45", "endText": "00:03", "widthPercent": 50.677886863020106, "start": 1778255118, "stage": "core", "vitals": {"minHeartRate": 54, "maxHeartRate": 55, "avgRespiratoryRate": 15, "avgHeartRate": 54.666666666666664}}]}], "generatedAt": 1778311935, "schemaVersion": "health_sleep_v1"}, "kind": "sleepVisualization", "updatedAt": "2026-05-09T07:32:15.386Z", "createdAt": "2026-05-09T07:32:15.386Z", "toolCallID": "call_jhr6siwzsz83bf9p4bayehow"}, {"kind": "text", "id": "14590FB4-65F9-4953-B56E-7D2A09558E15", "createdAt": "2026-05-09T07:32:39.463Z", "text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "updatedAt": "2026-05-09T07:32:42.849Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}, {"thread_id": "206170c4-0895-49e7-86a2-12c0893156f5", "role": "assistant", "model_name": "doubao-seed-2-0-pro-260215", "client_message_id": "9f8ac741-d784-4f19-ad53-cebf3466c8b2", "server_message_id": "e89f9ecf-aedc-4a85-a631-5023f38068ef", "delivery_state": "sent", "created_at": "2026-05-09T14:20:45.375000+00:00", "server_updated_at": "2026-05-15T05:26:32.898557+00:00", "tombstone": false, "attachments": [], "blocks": [{"kind": "text", "id": "652030BA-66B6-461F-9B24-B721F0706E4E", "createdAt": "2026-05-09T14:20:49.698Z", "text": "你好！我是你的专属健康助手 Spark，不管是运动、饮食、睡眠、健康管理相关的疑问，还是日程规划、知识查询等需求，都可以随时和我说哦~", "updatedAt": "2026-05-09T14:20:51.028Z"}], "reasoning_content": null, "reasoning_duration_ms": null, "reasoning_expanded": null, "reasoning_visibility": null}]}}
