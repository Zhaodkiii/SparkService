e": 55.75, "maxHeartRate": 59, "minHeartRate": 54}, "stage": "core", "startPercent": 0}, {"endText": "23:45", "end": 1778255118, "widthPercent": 7.059373539036932, "start": 1778254967, "startText": "23:42", "stage": "awake", "startPercent": 42.26273959794297}, {"endText": "00:03", "end": 1778256202, "widthPercent": 50.677886863020106, "start": 1778255118, "startText": "23:45", "vitals": {"avgRespiratoryRate": 15, "avgHeartRate": 54.666666666666664, "maxHeartRate": 55, "minHeartRate": 54}, "stage": "core", "startPercent": 49.322113136979894}], "date": "2026-05-08", "summary": {"start": 1778254063, "totalSleepMinutes": 33, "end": 1778256202, "startText": "23:27", "endText": "00:03"}}], "schemaVersion": "health_sleep_v1", "generatedAt": 1778311935}, "toolCallID": "call_jhr6siwzsz83bf9p4bayehow", "id": "15FC0E56-C6CD-4730-B62C-C22D127BD80C"}, {"id": "14590FB4-65F9-4953-B56E-7D2A09558E15", "kind": "text", "text": "你昨天（5月8日）的睡眠总时长仅35分钟，其中有效睡眠（核心睡眠）33分钟，清醒占比8.4%，没有深度和REM睡眠，属于严重睡眠不足哦。\n\n建议你今天适当调整作息，尽量在23点前准备入睡，避免睡前使用电子设备，若持续出现短睡眠情况，建议排查是否有睡眠节律紊乱或其他影响睡眠的因素~", "createdAt": "2026-05-09T07:32:39.463Z", "updatedAt": "2026-05-09T07:32:42.849Z"}], "thread_current_model_name": "doubao-seed-2-0-pro-260215", "thread_id": "0C4B0BEE-CFEE-440D-8252-5862EF24E2D7", "thread_role_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "thread_system_prompt": "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。\n{{CURRENT_DATE}}", "model_name": "doubao-seed-2-0-pro-260215", "role": "assistant", "created_at": "2026-05-09T07:32:10.865Z", "thread_top_p": 1, "thread_max_tokens": 4096, "thread_max_messages": 20, "client_message_id": "DC29FBFC-22BD-45B0-BC22-2F6D386A1B46", "thread_temperature": 0.6}, {"tombstone": false, "delivery_state": "pending", "blocks": [{"text": "你好！我是你的专属健康助手 Spark，不管是运动、饮食、睡眠、健康管理相关的疑问，还是日程规划、知识查询等需求，都可以随时和我说哦~", "kind": "text", "updatedAt": "2026-05-09T14:20:51.028Z", "createdAt": "2026-05-09T14:20:49.698Z", "id": "652030BA-66B6-461F-9B24-B721F0706E4E"}], "t