# Source environment only (local API and existing Celery worker/beat need the same settings).
MATERIAL_SYNC_SOURCE_ENABLED=true
MATERIAL_SYNC_RECEIVER_ENABLED=false
MATERIAL_SYNC_ENVIRONMENT_ID=local-authoring
MATERIAL_SYNC_TARGET_BASE_URL=https://diary.dreamwhale.top
MATERIAL_SYNC_KEY_ID=local-authoring-v1
MATERIAL_SYNC_SECRET=REPLACE_WITH_RANDOM_SECRET

# Production: set source=false, receiver=true, environment=production.
# Do not copy the source DB configuration to production.
# Accepted keys map key_id to an authenticated source environment and secret.
# MATERIAL_SYNC_ACCEPTED_KEYS='{"local-authoring-v1":{"environment":"local-authoring","secret":"REPLACE_WITH_THE_SAME_SECRET"}}'
