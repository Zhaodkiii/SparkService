# API 服务端与对账任务共享。不要将密钥加入客户端。
PRINT_OSS_PREFIX=traveldiary/print/
PRINT_WXPAY_APPID=
PRINT_WXPAY_MCHID=
PRINT_WXPAY_SERIAL=
PRINT_WXPAY_PRIVATE_KEY_PATH=/run/secrets/wechat_merchant_private.pem
# 微信支付公钥模式，来自商户平台的可信公钥 ID 和 PEM（不是商户公钥）。
PRINT_WXPAY_PUBLIC_KEY_ID=
PRINT_WXPAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public.pem
PRINT_WXPAY_API_V3_KEY=
PRINT_WXPAY_NOTIFY_URL=https://YOUR_API_DOMAIN/api/v1/print/wechat-notify/
